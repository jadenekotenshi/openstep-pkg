diff -ruN sudo-1.8.31p1/lib/util/openstep_termios.c b/lib/util/openstep_termios.c
--- a/lib/util/openstep_termios.c	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/util/openstep_termios.c	2026-10-05 23:24:11.830155789 +0000
@@ -0,0 +1,92 @@
+/*
+ * openstep_termios.c -- the POSIX termios and tty process-group calls that
+ * OPENSTEP's libc does not provide as functions, built on the BSD ioctls.
+ *
+ * The build compiles everything else with -Dtcgetattr=openstep_tcgetattr (and
+ * so on), so sudo calls these.  The renames are undone here, before the
+ * system headers are read, so no prototype of the real names can clash.
+ */
+
+#undef tcgetattr
+#undef tcsetattr
+#undef tcgetpgrp
+#undef tcsetpgrp
+#undef cfgetispeed
+#undef cfgetospeed
+#undef cfsetispeed
+#undef cfsetospeed
+
+#include <config.h>
+
+#include <sys/types.h>
+#include <sys/ioctl.h>
+#include <termios.h>
+
+#if !defined(TIOCGETA) || !defined(TIOCSETA) || !defined(TIOCGPGRP) || !defined(TIOCSPGRP)
+# error "openstep_termios.c needs the BSD terminal ioctls"
+#endif
+
+int
+openstep_tcgetattr(int fd, struct termios *t)
+{
+    return ioctl(fd, TIOCGETA, (char *)t);
+}
+
+int
+openstep_tcsetattr(int fd, int flags, const struct termios *t)
+{
+    /* TCSASOFT is a modifier; the low bits pick NOW, DRAIN or FLUSH. */
+    switch (flags & 3) {
+    case 0:	/* TCSANOW */
+	return ioctl(fd, TIOCSETA, (char *)t);
+    case 1:	/* TCSADRAIN */
+	return ioctl(fd, TIOCSETAW, (char *)t);
+    case 2:	/* TCSAFLUSH */
+	return ioctl(fd, TIOCSETAF, (char *)t);
+    }
+    return -1;
+}
+
+pid_t
+openstep_tcgetpgrp(int fd)
+{
+    int pgrp;
+
+    if (ioctl(fd, TIOCGPGRP, (char *)&pgrp) == -1)
+	return -1;
+    return (pid_t)pgrp;
+}
+
+int
+openstep_tcsetpgrp(int fd, pid_t pgrp)
+{
+    int p = (int)pgrp;
+
+    return ioctl(fd, TIOCSPGRP, (char *)&p);
+}
+
+speed_t
+openstep_cfgetispeed(const struct termios *t)
+{
+    return t->c_ispeed;
+}
+
+speed_t
+openstep_cfgetospeed(const struct termios *t)
+{
+    return t->c_ospeed;
+}
+
+int
+openstep_cfsetispeed(struct termios *t, speed_t speed)
+{
+    t->c_ispeed = speed;
+    return 0;
+}
+
+int
+openstep_cfsetospeed(struct termios *t, speed_t speed)
+{
+    t->c_ospeed = speed;
+    return 0;
+}
