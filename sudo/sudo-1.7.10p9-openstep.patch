 #endif /* HAVE__INNETGR */
 
 /*
+ * With -D_POSIX_SOURCE, OPENSTEP's <net/if.h> hides the interface flags.
+ * These are the 4.3BSD values.
+ */
+#ifndef IFF_UP
+# define IFF_UP		0x1
+#endif
+#ifndef IFF_BROADCAST
+# define IFF_BROADCAST	0x2
+#endif
+#ifndef IFF_DEBUG
+# define IFF_DEBUG	0x4
+#endif
+#ifndef IFF_LOOPBACK
+# define IFF_LOOPBACK	0x8
+#endif
+#ifndef IFF_POINTOPOINT
+# define IFF_POINTOPOINT 0x10
+#endif
+#ifndef IFF_RUNNING
+# define IFF_RUNNING	0x40
+#endif
+#ifndef IFF_NOARP
+# define IFF_NOARP	0x80
+#endif
+
+/*
+ * shutdown(2) "how" values; OPENSTEP's <sys/socket.h> only documents 0, 1, 2.
+ */
+#ifndef SHUT_RD
+# define SHUT_RD	0
+#endif
+#ifndef SHUT_WR
+# define SHUT_WR	1
+#endif
+#ifndef SHUT_RDWR
+# define SHUT_RDWR	2
+#endif
+
+/*
  * On POSIX systems, O_NOCTTY is the default so some OS's may lack this define.
  */
 #ifndef O_NOCTTY
@@ -200,23 +239,44 @@
 
 /*
  * Emulate POSIX signals via sigvec(2)
+ *
+ * OPENSTEP's <signal.h> declares sigaction(), sigismember() and friends (with
+ * its own struct sigaction) but libc does not implement them.  Give the
+ * emulation private names, so it cannot clash with those declarations, and
+ * take sigset_t from the system headers.
  */
 #ifndef HAVE_SIGACTION
-# define SA_ONSTACK	SV_ONSTACK
-# define SA_RESTART	SV_INTERRUPT		/* opposite effect */
-# define SA_RESETHAND	SV_RESETHAND
+# include <signal.h>		/* for sigset_t and struct sigvec */
+# ifndef SA_ONSTACK
+#  define SA_ONSTACK	SV_ONSTACK
+# endif
+# ifndef SA_RESTART
+#  define SA_RESTART	SV_INTERRUPT		/* opposite effect */
+# endif
+# ifndef SA_RESETHAND
+#  define SA_RESETHAND	SV_RESETHAND
+# endif
+# ifndef SA_INTERRUPT
+#  define SA_INTERRUPT	0			/* sigvec() interrupts by default */
+# endif
 # define sa_handler	sv_handler
 # define sa_mask	sv_mask
 # define sa_flags	sv_flags
 typedef struct sigvec sigaction_t;
-typedef int sigset_t;
-int sigaction __P((int sig, const sigaction_t *act, sigaction_t *oact));
-int sigemptyset __P((sigset_t *));
-int sigfillset __P((sigset_t *));
-int sigaddset __P((sigset_t *, int));
-int sigdelset __P((sigset_t *, int));
-int sigismember __P((sigset_t *, int));
-int sigprocmask __P((int, const sigset_t *, sigset_t *));
+# define sigaction		sudo_sigaction
+# define sigemptyset		sudo_sigemptyset
+# define sigfillset		sudo_sigfillset
+# define sigaddset		sudo_sigaddset
+# define sigdelset		sudo_sigdelset
+# define sigismember		sudo_sigismember
+# define sigprocmask		sudo_sigprocmask
+int sudo_sigaction __P((int sig, const sigaction_t *act, sigaction_t *oact));
+int sudo_sigemptyset __P((sigset_t *));
+int sudo_sigfillset __P((sigset_t *));
+int sudo_sigaddset __P((sigset_t *, int));
+int sudo_sigdelset __P((sigset_t *, int));
+int sudo_sigismember __P((const sigset_t *, int));
+int sudo_sigprocmask __P((int, const sigset_t *, sigset_t *));
 #endif
 
