diff -ruN pa/sudo-1.7.10p9/glob.c pc/sudo-1.7.10p9/glob.c
--- a/glob.c	2015-02-10 17:05:31.000000000 +0000
+++ b/glob.c	2026-10-06 01:06:34.597680725 +0000
@@ -99,6 +99,13 @@
 #include "emul/glob.h"
 #include "emul/charclass.h"
 
+/*
+ * configure never adds glob.o when libc lacks glob(3) (OPENSTEP does), but
+ * match.c then calls the emulation.  Makefile.in always links glob.o, so the
+ * body is only compiled when the system has no glob() of its own.
+ */
+#ifndef HAVE_GLOB
+
 #define	DOLLAR		'$'
 #define	DOT		'.'
 #define	EOS		'\0'
@@ -951,3 +958,4 @@
 	(void)printf("\n");
