--- a/openstep/compat.c
+++ b/openstep/compat.c
@@ -0,0 +1,120 @@
+#include "compat.h"
+#include <stdarg.h>
+#include <errno.h>
+#include <sys/stat.h>
+#include <ctype.h>
+#include <unistd.h>
+#undef open
+
+/* Same checked conversion used by the repository's Git OPENSTEP port. */
+long long openstep_strtoll(const char *s, char **end, int base)
+{
+    const char *start = s, *digits;
+    unsigned long long value = 0, limit;
+    unsigned int d;
+    int negative = 0, overflow = 0;
+    while (isspace((unsigned char)*s)) s++;
+    if (*s == '-' || *s == '+') negative = *s++ == '-';
+    if (base && (base < 2 || base > 36)) {
+        errno = EINVAL;
+        if (end) *end = (char *)start;
+        return 0;
+    }
+    if ((base == 0 || base == 16) && s[0] == '0' &&
+        (s[1] == 'x' || s[1] == 'X') && isxdigit((unsigned char)s[2])) {
+        s += 2; base = 16;
+    }
+    if (!base) base = *s == '0' ? 8 : 10;
+    limit = negative ? (unsigned long long)INT64_MAX + 1 : INT64_MAX;
+    digits = s;
+    for (;; s++) {
+        unsigned char c = *s;
+        if (c >= '0' && c <= '9') d = c - '0';
+        else if (c >= 'a' && c <= 'z') d = c - 'a' + 10;
+        else if (c >= 'A' && c <= 'Z') d = c - 'A' + 10;
+        else break;
+        if (d >= (unsigned int)base) break;
+        if (value > (limit - d) / base) overflow = 1;
+        else value = value * base + d;
+    }
+    if (end) *end = (char *)(s == digits ? start : s);
+    if (overflow) {
+        errno = ERANGE;
+        return negative ? -INT64_MAX - 1 : INT64_MAX;
+    }
+    return negative ? -(long long)(value - (value != 0)) - (value != 0) : (long long)value;
+}
+
+int openstep_open(const char *path, int flags, ...)
+{
+    int fd, saved_errno, mode = 0, created = 0;
+    int native_flags = flags & ~(O_CLOEXEC | O_NOFOLLOW);
+    struct stat before, after;
+    va_list args;
+    if (flags & O_CREAT) {
+        va_start(args, flags);
+        mode = va_arg(args, int);
+        va_end(args);
+    }
+    if (flags & O_NOFOLLOW) {
+        /* Create exclusively, or validate the existing inode before any
+         * truncation. Never open an unexpected leaf for a destructive write. */
+        native_flags = (native_flags & ~O_TRUNC) | O_NONBLOCK;
+        if (lstat(path, &before) < 0) {
+            if (errno != ENOENT || !(flags & O_CREAT)) return -1;
+            native_flags |= O_EXCL;
+            created = 1;
+        } else {
+            if (flags & O_EXCL) { errno = EEXIST; return -1; }
+            if ((before.st_mode & S_IFMT) == S_IFLNK) { errno = ELOOP; return -1; }
+            native_flags &= ~O_CREAT;
+        }
+    }
+    fd = open(path, native_flags, mode);
+    if (fd >= 0 && (flags & O_NOFOLLOW)) {
+        if (fstat(fd, &after) < 0) goto fail;
+        if (!created && (before.st_dev != after.st_dev || before.st_ino != after.st_ino)) {
+            errno = ELOOP;
+            goto fail;
+        }
+        if ((flags & O_TRUNC) && ftruncate(fd, 0) < 0) goto fail;
+        if (!(flags & O_NONBLOCK) && fcntl(fd, F_SETFL, flags & ~(O_CLOEXEC | O_NOFOLLOW)) < 0)
+            goto fail;
+    }
+    if (fd >= 0 && (flags & O_CLOEXEC) && fcntl(fd, F_SETFD, FD_CLOEXEC) < 0) {
+fail:
+        saved_errno = errno;
+        close(fd);
+        errno = saved_errno;
+        return -1;
+    }
+    return fd;
+}
+
+/* OPENSTEP has no fchdir. Validate the resulting cwd against the held fd
+ * before any transfer operation can use it. A renamed path may fail safely. */
+int openstep_fchdir(int fd, const char *path)
+{
+    struct stat target, previous, actual;
+    char saved[MAXPATHLEN];
+    int error;
+    if (fstat(fd, &target) < 0 || stat(".", &previous) < 0
+     || !getwd(saved))
+        return -1;
+    if (chdir(path) < 0)
+        return -1;
+    if (stat(".", &actual) == 0) {
+        if (actual.st_dev == target.st_dev && actual.st_ino == target.st_ino)
+            return 0;
+        errno = EAGAIN;
+    }
+    error = errno;
+    /* Never continue a failed transfer in a substituted working directory. */
+    if (chdir(saved) < 0 || stat(".", &actual) < 0
+     || actual.st_dev != previous.st_dev || actual.st_ino != previous.st_ino) {
+        fputs("rsync: cannot restore working directory after chdir race\n", stderr);
+        _exit(1);
+    }
+    errno = error;
+    return -1;
+}
