@@ -0,0 +1,54 @@
+/* Read/write readiness adapter for rsync on OPENSTEP. */
+#include <sys/types.h>
+#include <sys/time.h>
+#include <libc.h>
+#include <fcntl.h>
+#include <errno.h>
+#include "poll.h"
+
+int poll(struct pollfd *fds, nfds_t count, int timeout)
+{
+    fd_set reads, writes, excepts;
+    struct timeval tv;
+    nfds_t i;
+    int fd, maxfd = -1, invalid = 0, ready = 0, result;
+    FD_ZERO(&reads); FD_ZERO(&writes); FD_ZERO(&excepts);
+    for (i = 0; i < count; i++) {
+        fds[i].revents = 0;
+        fd = fds[i].fd;
+        if (fd < 0) continue;
+        /* Never let a descriptor outside fd_set corrupt the stack. */
+        if (fd >= FD_SETSIZE || (fcntl(fd, F_GETFL, 0) < 0 && errno == EBADF)) {
+            fds[i].revents = POLLNVAL;
+            invalid++;
+            continue;
+        }
+        if (fds[i].events & POLLIN) FD_SET(fd, &reads);
+        if (fds[i].events & POLLOUT) FD_SET(fd, &writes);
+        if (fds[i].events & POLLPRI) FD_SET(fd, &excepts);
+        if (fd > maxfd) maxfd = fd;
+    }
+    if (invalid) timeout = 0;
+    if (maxfd < 0) {
+        if (timeout < 0) { pause(); return -1; }
+        /* select with no descriptors is not a timer on OPENSTEP. */
+        if (timeout / 1000 && sleep(timeout / 1000)) { errno = EINTR; return -1; }
+        if (timeout % 1000) usleep((timeout % 1000) * 1000);
+        return invalid;
+    }
+    tv.tv_sec = timeout < 0 ? 0 : timeout / 1000;
+    tv.tv_usec = timeout < 0 ? 0 : (timeout % 1000) * 1000;
+    result = select(maxfd + 1, &reads, &writes, &excepts, timeout < 0 ? NULL : &tv);
+    if (result < 0) return -1;
+    for (i = 0; i < count; i++) {
+        fd = fds[i].fd;
+        if (fd < 0) continue;
+        if (!(fds[i].revents & POLLNVAL)) {
+            if (FD_ISSET(fd, &reads)) fds[i].revents |= POLLIN;
+            if (FD_ISSET(fd, &writes)) fds[i].revents |= POLLOUT;
+            if (FD_ISSET(fd, &excepts)) fds[i].revents |= POLLPRI;
+        }
+        if (fds[i].revents) ready++;
+    }
+    return ready;
+}
