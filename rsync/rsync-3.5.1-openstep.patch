+    assert(strtoll("-9223372036854775808", &tail, 10) == -INT64_MAX - 1 && !*tail);
+    errno = 0;
+    assert(strtoll("9223372036854775808", &tail, 10) == INT64_MAX && errno == ERANGE && !*tail);
+    assert(strtoll("0xabcdefZ", &tail, 0) == 0xabcdef && *tail == 'Z');
+    assert(strtoll("077", &tail, 0) == 63 && !*tail);
+    assert(strtoll(" +", &tail, 0) == 0 && *tail == ' ');
+    assert(fd >= 0 && (fcntl(fd, F_GETFD, 0) & FD_CLOEXEC));
+    close(fd);
+    fd = open(".", O_RDONLY);
+    assert(fd >= 0 && fstat(fd, &before) == 0);
+    assert(openstep_fchdir(fd, ".") == 0);
+    assert(openstep_fchdir(fd, "..") < 0 && errno == EAGAIN);
+    assert(stat(".", &after) == 0);
+    assert(before.st_dev == after.st_dev && before.st_ino == after.st_ino);
+    close(fd);
