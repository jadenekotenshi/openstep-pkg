+    assert(open("openstep/poll-test-link", O_RDONLY | O_NOFOLLOW) < 0 && errno == ELOOP);
+    assert(open("openstep/poll-test-link", O_WRONLY | O_TRUNC | O_NOFOLLOW) < 0 && errno == ELOOP);
+    unlink("openstep/poll-test-link");
+    fd = open("openstep/poll-test.c", O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+    assert(fd >= 0 && (fcntl(fd, F_GETFD, 0) & FD_CLOEXEC));
+    close(fd);
+    fd = open("openstep/poll-test-data", O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600);
+    assert(fd >= 0 && write(fd, "data", 4) == 4);
+    close(fd);
+    assert(open("openstep/poll-test-data", O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) < 0 && errno == EEXIST);
+    fd = open("openstep/poll-test-data", O_WRONLY | O_TRUNC | O_NOFOLLOW);
+    assert(fd >= 0 && fstat(fd, &after) == 0 && after.st_size == 0);
+    close(fd);
+    unlink("openstep/poll-test-data");
+    assert(pipe(pipefd) == 0);
+    fds[0].fd = pipefd[0]; fds[0].events = POLLIN;
+    assert(poll(fds, 1, 0) == 0);
+    assert(write(pipefd[1], "x", 1) == 1);
+    assert(poll(fds, 1, 100) == 1 && (fds[0].revents & POLLIN));
+    assert(read(pipefd[0], &byte, 1) == 1 && byte == 'x');
+    close(pipefd[1]);
+    assert(poll(fds, 1, 100) == 1 && read(pipefd[0], &byte, 1) == 0);
+    close(pipefd[0]);
+    fds[1].fd = FD_SETSIZE; fds[1].events = POLLIN;
+    assert(poll(fds, 2, 100) == 2);
+    assert((fds[0].revents & POLLNVAL) && (fds[1].revents & POLLNVAL));
+    gettimeofday(&start, NULL);
+    assert(poll(NULL, 0, 100) == 0);
+    gettimeofday(&end, NULL);
+    assert((end.tv_sec-start.tv_sec)*1000000 + end.tv_usec-start.tv_usec >= 80000);
+    return 0;
+}
