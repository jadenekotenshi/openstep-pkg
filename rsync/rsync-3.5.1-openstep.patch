+#ifndef RSYNC_OPENSTEP_COMPAT_H
+#define RSYNC_OPENSTEP_COMPAT_H
+/* BSD byte-order constants are hidden in the POSIX header view. */
+#ifdef _POSIX_SOURCE
+#define RSYNC_RESTORE_POSIX_SOURCE
+#undef _POSIX_SOURCE
+#endif
+#include <machine/endian.h>
+#ifdef RSYNC_RESTORE_POSIX_SOURCE
+#define _POSIX_SOURCE 1
+#endif
+#include <sys/types.h>
+/* readdir returns BSD direct even when POSIX dirent.h is present. */
+#define dirent direct
+#include <sys/dir.h>
+#undef HAVE_DIRENT_H
+#define HAVE_SYS_DIR_H 1
+#include <libc.h>
+#include <fcntl.h>
+#include <errno.h>
+#include <time.h>
+/* rsync is single threaded; copy libc's static result into the caller's tm. */
+static inline struct tm *openstep_localtime_r(const time_t *t, struct tm *out)
+{
+    struct tm *value = localtime(t);
+    if (!value) return NULL;
+    *out = *value;
+    return out;
+}
+#define localtime_r openstep_localtime_r
+typedef unsigned char uint8_t;
+typedef unsigned short uint16_t;
+typedef unsigned int uint32_t;
+typedef unsigned long long uintmax_t;
+#ifndef SIZE_MAX
+#define SIZE_MAX ((size_t)-1)
+#endif
+#ifndef ENOTSUP
+#define ENOTSUP EOPNOTSUPP
+#endif
+#ifndef EOVERFLOW
+#define EOVERFLOW ERANGE
+#endif
+long long openstep_strtoll(const char *, char **, int);
+#define strtoll openstep_strtoll
+/* The BSD headers provide intN_t and u_intN_t, but not uintN_t. */
+#define uint16 u_int16_t
+#define uint32 u_int32_t
+#ifndef INT64_MAX
+#define INT64_MAX 9223372036854775807LL
+#endif
+#ifdef USE_OPENSSL
+/* The local OpenSSL port supplies socklen_t as a typedef. */
+#undef socklen_t
+#include <openssl/e_os2.h>
+#endif
+/* Preserve close-on-exec using fcntl on this single-threaded platform. */
+#define O_CLOEXEC 0x10000000
+#define O_NOFOLLOW 0x20000000
+/* Only a selector for rsync's wrappers; AT_FDCWD stays unavailable. */
+#define AT_REMOVEDIR 0x200
+int openstep_open(const char *, int, ...);
+int openstep_fchdir(int, const char *);
+#define open openstep_open
+#endif
