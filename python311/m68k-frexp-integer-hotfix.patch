+        /* Subnormal: value = (hi:lo) * 2**-1074.  The FPU flushes subnormals
+           here, so no arithmetic: shift the 52-bit fraction left until the
+           implicit bit (bit 20 of hi) is set, counting the shifts. */
+        int k = 0;
+
+        while (!(hi & 0x00100000U)) {
+            hi = (hi << 1) | (lo >> 31);
+            lo <<= 1;
+            k++;
+        }
+        *e = -1021 - k;
+        hi &= 0x000fffffU;
+    } else {
