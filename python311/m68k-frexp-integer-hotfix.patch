     }
-    *e = ex - 1022 - bias;
-    u.w[0] = (u.w[0] & 0x800fffffU) | (1022U << 20);
+    u.w[0] = sign | (1022U << 20) | hi;
+    u.w[1] = lo;
     return u.d;
