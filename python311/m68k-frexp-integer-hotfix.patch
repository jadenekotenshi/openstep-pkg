-   native compiler read the exponent of the unscaled value otherwise. */
+   hash(), float.hex(), and compiling a constant such as 5e-324.  The FPU also
+   flushes a subnormal operand to zero in a multiply, so the exponent and fraction
+   of a subnormal are found by shifting its bit pattern (the 68k is big-endian,
+   so word 0 holds the sign, exponent and top of the fraction).  The union is
+   volatile: the native compiler read the exponent of the unscaled value otherwise. */
 double
 frexp(double x, int *e)
 {
     volatile union { double d; unsigned int w[2]; } u;
-    int ex, bias = 0;
+    unsigned int hi, lo, sign;
+    int ex;
 
     u.d = x;
-    ex = (int) ((u.w[0] >> 20) & 0x7ff);
-    if (ex == 0x7ff || ((u.w[0] & 0x7fffffffU) | u.w[1]) == 0) {
+    hi = u.w[0];
+    lo = u.w[1];
+    ex = (int) ((hi >> 20) & 0x7ff);
+    if (ex == 0x7ff || ((hi & 0x7fffffffU) | lo) == 0) {
         *e = 0;
         return x;
     }
+    sign = hi & 0x80000000U;
+    hi &= 0x000fffffU;
