-#if defined(NeXT) && (defined(__sparc__) || defined(__sparc) || defined(sparc))
-/* The SPARC libm's ldexp() returns 0 whenever the result is subnormal, so
+#if defined(NeXT) && (defined(__sparc__) || defined(__sparc) || defined(sparc) || defined(__m68k__))
+/* The SPARC (and 68k) libm's ldexp() returns 0 whenever the result is subnormal, so
    float.fromhex('0x0.0000000000001p-1022'), math.ldexp(1.0, -1074) and
    everything built on them lose the subnormal range (the hardware is fine).
    Scale by powers of two built from their bit patterns, in steps that leave
@@ -77,3 +77,30 @@ ldexp(double x, int n)
     return y * openstep_pow2(n);
 }
 #endif
+
+#if defined(NeXT) && defined(__m68k__)
+/* The 68k libm's frexp() never returns for a subnormal argument, which hangs
+   hash(), float.hex(), and compiling a constant such as 5e-324.  Scale a
+   subnormal up by 2**54 (exact) and read the exponent from the bit pattern. */
+double
+frexp(double x, int *e)
+{
+    union { double d; unsigned long long i; } u;
+    int ex, bias = 0;
+
+    u.d = x;
+    ex = (int) ((u.i >> 52) & 0x7ff);
+    if (ex == 0x7ff || (u.i << 1) == 0) {
+        *e = 0;
+        return x;
+    }
+    if (ex == 0) {
+        u.d = x * 18014398509481984.0;
+        ex = (int) ((u.i >> 52) & 0x7ff);
+        bias = 54;
+    }
+    *e = ex - 1022 - bias;
+    u.i = (u.i & 0x800fffffffffffffULL) | (1022ULL << 52);
+    return u.d;
+}
+#endif
