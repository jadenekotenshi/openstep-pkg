#!/bin/sh

set -e

DESTDIR=$1
VERSION=$2
PREFIX=/usr/local
PATCHFILE="libcss-$VERSION-openstep.patch"
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin:$PATH
NSSHARED=/usr/local/share/netsurf-buildsystem
CC=/usr/local/bin/gcc-4.2
AR=/usr/local/lib/cctools/bin/ar
RANLIB=/usr/local/lib/cctools/bin/ranlib
export AR RANLIB
BUILD_CC=/usr/local/bin/gcc-4.2
PERL=/usr/bin/perl
MAKE=gnumake
CCACHE=
PKGCONFIG=
CC_CAN_BUILD_AND_DEP=no
CC_CANNOT_DEP=yes
INSTALL=/usr/bin/install
BUILDDIR=build-openstep

export DESTDIR VERSION PREFIX PATH NSSHARED CC BUILD_CC PERL MAKE
export CCACHE PKGCONFIG CC_CAN_BUILD_AND_DEP CC_CANNOT_DEP INSTALL BUILDDIR

if [ -d "libcss-$VERSION" ]; then
    cd "libcss-$VERSION"
    PATCHFILE="../$PATCHFILE"
fi

patch -p1 < "$PATCHFILE"

BUILD_CC="/usr/local/bin/gcc-4.2 -DNeXT -I/NextDeveloper/Headers -I`pwd`/include"
export BUILD_CC

cat > Makefile.config.override <<'EOF'
CFLAGS := $(CFLAGS) -DNeXT -I/NextDeveloper/Headers
EOF

gnumake PREFIX="$PREFIX" WARNFLAGS= AR="$AR" RANLIB="$RANLIB"

gnumake install DESTDIR="$DESTDIR" PREFIX="$PREFIX" WARNFLAGS= AR="$AR" RANLIB="$RANLIB"
"$RANLIB" "$DESTDIR$PREFIX/lib/libcss.a"
