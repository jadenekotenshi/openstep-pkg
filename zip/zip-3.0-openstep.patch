diff --git a/fileio.c b/fileio.c
index 1847e62..2ad5527 100644
--- a/fileio.c
+++ b/fileio.c
@@ -45,6 +45,20 @@ extern int errno;
    ----------------------- */
 #include <ctype.h>
 
+#ifdef NeXT
+/* NeXT fseek can succeed before offset zero; all archive readers need
+   an error here so that their seek-from-end fallback starts at zero. */
+int zip_openstep_fseek(FILE *stream, long offset, int whence)
+{
+    int result = fseek(stream, offset, whence);
+    if (result == 0 && ftell(stream) < 0) {
+        errno = EINVAL;
+        return -1;
+    }
+    return result;
+}
+#endif
+
 
 #if defined(VMS) || defined(TOPS20)
 #  define PAD 5
