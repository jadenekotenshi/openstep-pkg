#!/bin/sh
set -e
PREFIX="$LOCAL_ROOT"
PATH="$PREFIX/bin:$PREFIX/sbin:/usr/ucb:/bin:/usr/bin"
export PATH
SHARE="$PREFIX/share/dhcpc"

[ -x "$PREFIX/sbin/dhcpc" ] || { echo "dhcpc: missing sbin/dhcpc" >&2; exit 1; }
[ -f "$SHARE/dhcpc.script" ] || { echo "dhcpc: missing dhcpc.script" >&2; exit 1; }
[ -f "$PREFIX/etc/dhcpc.conf" ] || { echo "dhcpc: missing dhcpc.conf" >&2; exit 1; }

# Usage errors exit with status 2.
rc=0
"$PREFIX/sbin/dhcpc" > /dev/null 2>&1 || rc=$?
[ "$rc" = 2 ] || { echo "dhcpc: expected usage error (2), got $rc" >&2; exit 1; }

# Full DHCP exchange against a fake server on the loopback interface.  This
# checks packet encoding and decoding end to end on this machine's byte order.
WORK=/tmp/pkg-dhcpc.$$
mkdir "$WORK"
trap 'rm -rf "$WORK"; kill $SRV 2>/dev/null' 0 1 2 3 15
LOG="$WORK/script.log"
cat > "$WORK/script" <<SEOF
echo "\$1 \$interface \$ip \$subnet \$broadcast \$router \$dns \$domain \$lease" >> "$LOG"
SEOF
DHCPC_SERVER=127.0.0.1 DHCPC_SERVER_PORT=16767 DHCPC_CLIENT_PORT=16868
export DHCPC_SERVER DHCPC_SERVER_PORT DHCPC_CLIENT_PORT
"$SHARE/dhcpc-testd" 16767 16868 > "$WORK/testd.out" 2>&1 &
SRV=$!
i=0
while [ $i -lt 20 ]; do
    grep ready "$WORK/testd.out" > /dev/null 2>&1 && break
    sleep 1
    i=`expr $i + 1`
done
grep ready "$WORK/testd.out" > /dev/null || { echo "dhcpc: test server did not start" >&2; cat "$WORK/testd.out" >&2; exit 1; }

"$PREFIX/sbin/dhcpc" -f -q -n -m 0:0:c0:12:34:56 -s "$WORK/script" lo0

want="BOUND lo0 192.168.7.50 255.255.255.0 192.168.7.255 192.168.7.1 192.168.7.1 8.8.8.8 lan.xyz 3600"
got=`cat "$LOG"`
if [ "$got" != "$want" ]; then
    echo "dhcpc: lease mismatch" >&2
    echo "  want: $want" >&2
    echo "  got:  $got" >&2
    exit 1
fi
