#!/bin/sh
set -e
DESTDIR=$1
VERSION=$2
PREFIX=/usr/local
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin:$PATH
CC="/usr/local/bin/gcc-4.2 $PKG_GCC42_ARCH_FLAGS"
export PATH
# The tarball is a snapshot of the 1.13 commit: its directory is named after it.
if test -d emikulic-darkhttpd-afeb474; then cd emikulic-darkhttpd-afeb474; fi

# This libc and these headers lack a good deal darkhttpd assumes: snprintf(),
# vasprintf(), waitpid(), setsid(), pwrite() and strtoll(), the POSIX <dirent.h>,
# <stdint.h> and the types pid_t, ssize_t, in_addr_t and socklen_t, O_NONBLOCK, and
# the int wait-status macros.  Private headers supply them (functions as static
# code renamed by macros, so nothing needs linking and nothing can clash).
/usr/local/bin/mkdir -p openstep/sys
/bin/cat > openstep/stdint.h <<'SEOF'
#ifndef OPENSTEP_STDINT_H
#define OPENSTEP_STDINT_H
#include <sys/types.h>
typedef unsigned char uint8_t;
typedef unsigned short uint16_t;
typedef unsigned int uint32_t;
typedef unsigned long long uint64_t;
#endif
SEOF
/bin/cat > openstep/dirent.h <<'SEOF'
#ifndef OPENSTEP_DIRENT_H
#define OPENSTEP_DIRENT_H
#include <sys/types.h>
#include <sys/dir.h>
#define dirent direct
#endif
SEOF
/bin/cat > openstep/sys/wait.h <<'SEOF'
#ifndef OPENSTEP_SYS_WAIT_H
#define OPENSTEP_SYS_WAIT_H
#include_next <sys/wait.h>
#undef WIFEXITED
#undef WEXITSTATUS
#undef WIFSIGNALED
#undef WTERMSIG
#define WIFEXITED(s) ((((int) (s)) & 0xff) == 0)
#define WEXITSTATUS(s) ((((int) (s)) >> 8) & 0xff)
#define WIFSIGNALED(s) ((((int) (s)) & 0xff) != 0 && (((int) (s)) & 0xff) != 0x7f)
#define WTERMSIG(s) (((int) (s)) & 0x7f)
#ifndef WNOHANG
# define WNOHANG 1
#endif
#endif
SEOF

# Types the headers may lack (probed: a typedef cannot be tested for).
DEFS=
probe_type() {
    printf '#include <sys/types.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\n%s probe_var;\nint main(void) { return 0; }\n' "$1" > probe.c
    if $CC -c probe.c -o probe.o > /dev/null 2>&1; then :; else
        DEFS="$DEFS -DOSTEP_NEED_$2"
    fi
    rm -f probe.c probe.o
}
probe_type socklen_t SOCKLEN_T
probe_type pid_t PID_T
probe_type ssize_t SSIZE_T
probe_type mode_t MODE_T
probe_type uid_t UID_T
probe_type gid_t GID_T
probe_type in_addr_t IN_ADDR_T

/bin/cat > openstep-compat.h <<'CEOF'
#ifndef OPENSTEP_DARKHTTPD_COMPAT_H
#define OPENSTEP_DARKHTTPD_COMPAT_H
#include <sys/types.h>
#include <sys/stat.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <fcntl.h>
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <unistd.h>
#ifdef OSTEP_NEED_SOCKLEN_T
typedef int socklen_t;
#endif
#ifdef OSTEP_NEED_PID_T
typedef int pid_t;
#endif
#ifdef OSTEP_NEED_SSIZE_T
typedef int ssize_t;
#endif
#ifdef OSTEP_NEED_MODE_T
typedef unsigned short mode_t;
#endif
#ifdef OSTEP_NEED_UID_T
typedef unsigned short uid_t;
#endif
#ifdef OSTEP_NEED_GID_T
typedef unsigned short gid_t;
#endif
#ifdef OSTEP_NEED_IN_ADDR_T
typedef unsigned int in_addr_t;
#endif
#ifndef O_NONBLOCK
# ifdef FNDELAY
#  define O_NONBLOCK FNDELAY
# else
#  define O_NONBLOCK 0x0004
# endif
#endif
#ifndef S_ISDIR
# define S_ISDIR(m) (((m) & S_IFMT) == S_IFDIR)
#endif
#ifndef S_ISREG
# define S_ISREG(m) (((m) & S_IFMT) == S_IFREG)
#endif
#ifndef PATH_MAX
# define PATH_MAX 1024
#endif
extern int wait4();
extern int wait3();
extern int setpgrp();
extern long lseek();
static int
ostep_waitpid(int pid, int *status, int options)
{
    /* wait4() reports ECHILD for pid -1 here; wait3() is "any child" */
    if (pid == -1)
        return wait3((void *) status, options, (void *) 0);
    return wait4(pid, (void *) status, options, (void *) 0);
}
static int
ostep_setsid(void)
{
    int pid = getpid();

    return setpgrp(pid, pid) < 0 ? -1 : pid;
}
static int
ostep_pwrite(int fd, const void *buf, int n, long off)
{
    if (lseek(fd, off, 0) < 0)
        return -1;
    return write(fd, buf, n);
}
static long long
ostep_strtoll(const char *s, char **end, int base)
{
    long long v = 0;
    int neg = 0, d;

    while (*s == ' ' || (*s >= '\t' && *s <= '\r'))
        s++;
    if (*s == '-') {
        neg = 1;
        s++;
    } else if (*s == '+') {
        s++;
    }
    for (;; s++) {
        if (*s >= '0' && *s <= '9')
            d = *s - '0';
        else if (*s >= 'a' && *s <= 'z')
            d = *s - 'a' + 10;
        else if (*s >= 'A' && *s <= 'Z')
            d = *s - 'A' + 10;
        else
            break;
        if (d >= base)
            break;
        v = v * base + d;
    }
    if (end != 0)
        *end = (char *) s;
    return neg ? -v : v;
}
#define waitpid ostep_waitpid
#define setsid ostep_setsid
#define pwrite ostep_pwrite
#define strtoll ostep_strtoll
#include "snprintf-shim.h"
/* vasprintf() on top of the shim's vsnprintf(). */
static int
ostep_vasprintf(char **strp, const char *fmt, va_list ap)
{
    va_list ap2;
    char tmp[2];
    int n;

    va_copy(ap2, ap);
    n = vsnprintf(tmp, 1, fmt, ap2);
    if (n < 0)
        return -1;
    *strp = (char *) malloc(n + 1);
    if (*strp == 0)
        return -1;
    return vsnprintf(*strp, n + 1, fmt, ap);
}
#define vasprintf ostep_vasprintf
/* The system's printf family does not understand %llu, %zu and %zd (darkhttpd uses
   them in its log lines and messages): an unknown conversion makes it read the
   wrong arguments, and a %s then dereferences garbage.  Format with the shim's
   vsnprintf() and write the result out. */
static int
ostep_vfprintf(FILE *f, const char *fmt, va_list ap)
{
    char *buf;
    int n;

    n = ostep_vasprintf(&buf, fmt, ap);
    if (n < 0)
        return -1;
    fputs(buf, f);
    free(buf);
    return n;
}
static int
ostep_fprintf(FILE *f, const char *fmt, ...)
{
    va_list ap;
    int n;

    va_start(ap, fmt);
    n = ostep_vfprintf(f, fmt, ap);
    va_end(ap);
    return n;
}
static int
ostep_printf(const char *fmt, ...)
{
    va_list ap;
    int n;

    va_start(ap, fmt);
    n = ostep_vfprintf(stdout, fmt, ap);
    va_end(ap);
    return n;
}
#define vfprintf ostep_vfprintf
#define fprintf ostep_fprintf
#define printf ostep_printf
#endif
CEOF

# C99 for-loop declarations; no IPv6 (this libc has no inet_pton/inet_ntop).
$CC -O2 -std=gnu99 -DNO_IPV6 $DEFS -I. -I"`pwd`/openstep" -include openstep-compat.h -o darkhttpd darkhttpd.c
test -x darkhttpd || { echo "darkhttpd: not built" >&2; exit 1; }
/usr/local/bin/mkdir -p "$DESTDIR$PREFIX/bin"
/usr/bin/install -c -m 755 darkhttpd "$DESTDIR$PREFIX/bin/darkhttpd"
