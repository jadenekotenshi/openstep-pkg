#!/bin/sh

set -e

DESTDIR=$1
VERSION=$2

if test -d SDL-1.2.15; then
    cd SDL-1.2.15
fi

SRCROOT=`pwd`
PREFIX=/usr/local

PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin:$PATH
export PATH

ensure_dir() {
    dir=$1

    test -d "$dir" && return 0

    case $dir in
        /*) current=/ ;;
         *) current=. ;;
    esac

    old_ifs=$IFS
    IFS=/
    set -- $dir
    IFS=$old_ifs

    for part
    do
        test -n "$part" || continue

        if test "$current" = /; then
            current=/$part
        else
            current=$current/$part
        fi

        test -d "$current" || /bin/mkdir "$current"
    done
}

/usr/local/bin/patch -p1 < sdl12-1.2.15-openstep.patch

# src/audio/SDL_mixer_m68k.c has hand-written 68k assembly in the Linux (GNU, "%d0"
# register prefix) syntax, which this system's assembler rejects ("Statement ... ignored"),
# and compiles whenever the compiler says m68k.  The routines are only called when
# SDL_ASSEMBLY_ROUTINES is defined, which this build does not; the file is compiled
# empty.  (The audio mixer uses the C code.)
if test -f src/audio/SDL_mixer_m68k.c; then
    /bin/sed -e 's|^#if (defined(__m68k__) \&\& !defined(__mcoldfire__)) \&\& defined(__GNUC__)$|#if 0|' \
        src/audio/SDL_mixer_m68k.c > src/audio/SDL_mixer_m68k.c.new
    /bin/mv src/audio/SDL_mixer_m68k.c.new src/audio/SDL_mixer_m68k.c
    /bin/grep '^#if 0$' src/audio/SDL_mixer_m68k.c > /dev/null
    if /bin/grep 'define SDL_ASSEMBLY_ROUTINES' include/SDL_config.h include/SDL_config_*.h > /dev/null 2>&1; then
        echo "sdl12: SDL_ASSEMBLY_ROUTINES is defined; the m68k mixer routines are needed" >&2
    fi
fi

# The bundled build script hardcodes -m486; use the per-arch cc flags instead
# (and say so explicitly that SPARC and m68k are big-endian).
ARCH_CFLAGS=$PKG_SYSCC_ARCH_FLAGS
case $PKG_ARCH in
    sparc|m68k) ARCH_CFLAGS="$ARCH_CFLAGS -DSDL_BYTEORDER=4321" ;;
esac
/bin/sed "s/-m486/$ARCH_CFLAGS/" build-openstep.csh > build-openstep.csh.tmp
/bin/mv build-openstep.csh.tmp build-openstep.csh

/bin/csh -f ./build-openstep.csh

ensure_dir "$DESTDIR$PREFIX/include/SDL"
ensure_dir "$DESTDIR$PREFIX/lib/pkgconfig"
ensure_dir "$DESTDIR$PREFIX/bin"
ensure_dir "$DESTDIR$PREFIX/share/doc/sdl12"

for header in include/*.h
do
    /usr/bin/install -c -m 644 "$header" "$DESTDIR$PREFIX/include/SDL/"
done

/usr/bin/install -c -m 644 libSDL.a "$DESTDIR$PREFIX/lib/libSDL.a"
/bin/ranlib "$DESTDIR$PREFIX/lib/libSDL.a"
/usr/bin/install -c -m 755 fix-macho-i486-subtype.csh \
    "$DESTDIR$PREFIX/bin/sdl-fix-macho-i486-subtype"

/bin/cat > "$DESTDIR$PREFIX/bin/sdl-config" <<'EOF'
#!/bin/sh

prefix=/usr/local
version=1.2.15

if test $# -eq 0; then
    echo "usage: sdl-config [--prefix] [--version] [--cflags] [--libs] [--static-libs]" >&2
    exit 1
fi

while test $# -gt 0
do
    case "$1" in
        --prefix)
            echo "$prefix"
            ;;
        --version)
            echo "$version"
            ;;
        --cflags)
            echo "-D__OPENSTEP__ -I${prefix}/include/SDL"
            ;;
        --libs|--static-libs)
            echo "-L${prefix}/lib -lSDL -framework AppKit -framework Foundation -framework SoundKit"
            ;;
        *)
            echo "sdl-config: unknown option: $1" >&2
            exit 1
            ;;
    esac
    shift
done
EOF
/bin/chmod 755 "$DESTDIR$PREFIX/bin/sdl-config"

/bin/cat > "$DESTDIR$PREFIX/lib/pkgconfig/sdl.pc" <<'EOF'
prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: sdl
Description: Simple DirectMedia Layer 1.2 for OPENSTEP
Version: 1.2.15
Libs: -L${libdir} -lSDL -framework AppKit -framework Foundation -framework SoundKit
Cflags: -D__OPENSTEP__ -I${includedir}/SDL
EOF

/usr/bin/install -c -m 644 "$SRCROOT/README.md" \
    "$DESTDIR$PREFIX/share/doc/sdl12/README.md"
/usr/bin/install -c -m 644 "$SRCROOT/NOTICE" \
    "$DESTDIR$PREFIX/share/doc/sdl12/NOTICE"
/usr/bin/install -c -m 644 "$SRCROOT/COPYING" \
    "$DESTDIR$PREFIX/share/doc/sdl12/COPYING"
