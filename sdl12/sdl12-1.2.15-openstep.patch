+static SDL_GrabMode OPENSTEP_GrabInput(_THIS, SDL_GrabMode mode)
+{
+    if (mode == SDL_GRAB_QUERY) return SDL_GRAB_OFF;
+    if (mode == SDL_GRAB_ON) {
