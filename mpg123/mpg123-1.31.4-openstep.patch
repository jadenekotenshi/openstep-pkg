+#ifdef NeXT
+#include <streams/streams.h>
+
+/* A growable native memory stream avoids an unbounded vsprintf buffer. */
+int INT123_openstep_snprintf(char *dst, size_t size, const char *fmt, ...)
+{
+	NXStream *stream;
+	va_list ap;
+	char *buffer;
+	int length, capacity;
+	size_t copied;
+
+	if(size) dst[0] = 0;
+	stream = NXOpenMemory(NULL, 0, NX_WRITEONLY);
+	if(!stream) return -1;
+	va_start(ap, fmt);
+	NXVPrintf(stream, fmt, ap);
+	va_end(ap);
+	NXGetMemoryBuffer(stream, &buffer, &length, &capacity);
+	if(size)
+	{
+		copied = (size_t)length < size ? (size_t)length : size-1;
+		memcpy(dst, buffer, copied);
+		dst[copied] = 0;
+	}
+	NXCloseMemory(stream, NX_FREEBUFFER);
+	return length;
+}
+#endif
 
