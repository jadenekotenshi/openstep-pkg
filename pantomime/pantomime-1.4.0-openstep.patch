@@ -0,0 +1,106 @@
+# Plain makefile for building Pantomime as a static library, without GNUstep
+# make.  Used by the OPENSTEP package and for testing on other systems.
+#
+#   make -f Makefile.cw CC=/bin/cc OBJCFLAGS="-O -ObjC" libPantomime.a
+#
+# Headers are staged in include/Pantomime so that <Pantomime/CWFoo.h> works.
+
+CC = cc
+AR = ar
+RANLIB = ranlib
+OBJCFLAGS = -O2
+CPPFLAGS =
+EXTRA_OBJS =
+
+SRCS = \
+	CWCacheManager.m \
+	CWCharset.m \
+	CWConstants.m \
+	CWCompat.m \
+	CWContainer.m \
+	CWDNSManager.m \
+	CWFlags.m \
+	CWFolder.m \
+	CWFolderInformation.m \
+	CWIMAPCacheManager.m \
+	CWIMAPFolder.m \
+	CWIMAPMessage.m \
+	CWIMAPStore.m \
+	CWISO8859_1.m \
+	CWISO8859_10.m \
+	CWISO8859_11.m \
+	CWISO8859_13.m \
+	CWISO8859_14.m \
+	CWISO8859_15.m \
+	CWISO8859_2.m \
+	CWISO8859_3.m \
+	CWISO8859_4.m \
+	CWISO8859_5.m \
+	CWISO8859_6.m \
+	CWISO8859_7.m \
+	CWISO8859_8.m \
+	CWISO8859_9.m \
+	CWInternetAddress.m \
+	CWKOI8_R.m \
+	CWKOI8_U.m \
+	CWLocalCacheManager.m \
+	CWLocalFolder+maildir.m \
+	CWLocalFolder+mbox.m \
+	CWLocalFolder.m \
+	CWLocalMessage.m \
+	CWLocalStore.m \
+	CWMD5.m \
+	CWMIMEMultipart.m \
+	CWMIMEUtility.m \
+	CWMessage.m \
+	CWPOP3CacheManager.m \
+	CWPOP3CacheObject.m \
+	CWPOP3Folder.m \
+	CWPOP3Message.m \
+	CWPOP3Store.m \
+	CWParser.m \
+	CWPart.m \
+	CWRegEx.m \
+	CWRunLoopWatcher.m \
+	CWSMTP.m \
+	CWSendmail.m \
+	CWService.m \
+	CWTCPConnection.m \
+	CWURLName.m \
+	CWUUFile.m \
+	CWVirtualFolder.m \
+	CWWINDOWS_1250.m \
+	CWWINDOWS_1251.m \
+	CWWINDOWS_1252.m \
+	CWWINDOWS_1253.m \
+	CWWINDOWS_1254.m \
+	NSData+Extensions.m \
+	NSFileManager+Extensions.m \
+	NSScanner+Extensions.m \
+	NSString+Extensions.m \
+	io.m
+
+OBJS = $(SRCS:.m=.o) $(EXTRA_OBJS)
+
+all: libPantomime.a
+
+libPantomime.a: $(OBJS)
+	rm -f $@
+	$(AR) cr $@ $(OBJS)
+	$(RANLIB) $@
+
+include/Pantomime/stamp: $(wildcard *.h)
+	test -d include || mkdir include
+	test -d include/Pantomime || mkdir include/Pantomime
+	cp *.h include/Pantomime/
+	touch include/Pantomime/stamp
+
+.SUFFIXES: .m .o
+$(OBJS): include/Pantomime/stamp
+
+.m.o:
+	$(CC) $(OBJCFLAGS) $(CPPFLAGS) -Iinclude -c $< -o $@
+
+clean:
+	rm -f $(OBJS) libPantomime.a
+	rm -rf include
