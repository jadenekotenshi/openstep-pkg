diff -ruN -x Pantomime.framework -x obj -x derived_src a/Framework/Pantomime/CWRunLoopWatcher.h b/Framework/Pantomime/CWRunLoopWatcher.h
--- a/Framework/Pantomime/CWRunLoopWatcher.h	1970-01-01 00:00:00.000000000 +0000
+++ b/Framework/Pantomime/CWRunLoopWatcher.h	2026-10-16 01:25:59.113015547 +0000
@@ -0,0 +1,45 @@
+/*
+**  CWRunLoopWatcher.h
+**
+**  Portable replacement for the GNUstep run loop extensions
+**  (-addEvent:type:watcher:forMode: and friends) that Pantomime relies on
+**  to be told when a socket is readable or writable.  It polls the
+**  registered descriptors with select() from a short repeating NSTimer, so
+**  it only needs plain Foundation and works with any NSRunLoop.
+**
+**  This file is part of the OPENSTEP port of Pantomime and is distributed
+**  under the same terms as Pantomime (LGPL 2.1 or later).
+*/
+
+#ifndef _Pantomime_H_CWRunLoopWatcher
+#define _Pantomime_H_CWRunLoopWatcher
+
+#include <Pantomime/CWCompat.h>
+
+#import <Foundation/NSObject.h>
+#import <Foundation/NSString.h>
+
+typedef enum {CWET_RDESC, CWET_WDESC, CWET_EDESC} CWRunLoopEventType;
+
+@protocol CWRunLoopEvents
+- (void) receivedEvent: (void *) theData
+                  type: (CWRunLoopEventType) theType
+                 extra: (void *) theExtra
+               forMode: (NSString *) theMode;
+@end
+
+@interface CWRunLoopWatcher : NSObject
+
++ (void) addEvent: (void *) theData
+             type: (CWRunLoopEventType) theType
+          watcher: (id) theWatcher
+          forMode: (NSString *) theMode;
+
++ (void) removeEvent: (void *) theData
+                type: (CWRunLoopEventType) theType
+             forMode: (NSString *) theMode
+                 all: (BOOL) removeAll;
+
+@end
+
+#endif // _Pantomime_H_CWRunLoopWatcher
diff -ruN -x Pantomime.framework -x obj -x derived_src a/Framework/Pantomime/CWRunLoopWatcher.m b/Framework/Pantomime/CWRunLoopWatcher.m
--- a/Framework/Pantomime/CWRunLoopWatcher.m	1970-01-01 00:00:00.000000000 +0000
+++ b/Framework/Pantomime/CWRunLoopWatcher.m	2026-10-16 01:25:59.113092747 +0000
@@ -0,0 +1,265 @@
+/*
+**  CWRunLoopWatcher.m
+**
+**  See CWRunLoopWatcher.h.
+*/
+
+#import <Pantomime/CWRunLoopWatcher.h>
+
+#import <Foundation/NSArray.h>
+#import <Foundation/NSRunLoop.h>
+#import <Foundation/NSTimer.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <sys/types.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+//
+// How often the descriptors are polled, in seconds.
+//
+#define POLL_INTERVAL 0.01
+
+@interface CWWatch : NSObject
+{
+  @public
+    int fd;
+    CWRunLoopEventType type;
+    id watcher;
+}
+@end
+
+@implementation CWWatch
+- (void) dealloc
+{
+  [watcher release];
+  [super dealloc];
+}
+@end
+
+static NSMutableArray *watches = nil;
+static NSMutableArray *timer_modes = nil;
+static NSTimer *poll_timer = nil;
+
+@interface CWRunLoopWatcher (Private)
++ (void) _poll: (NSTimer *) theTimer;
++ (void) _stopTimer;
+@end
+
+@implementation CWRunLoopWatcher
+
++ (void) addEvent: (void *) theData
+             type: (CWRunLoopEventType) theType
+          watcher: (id) theWatcher
+          forMode: (NSString *) theMode
+{
+  CWWatch *aWatch;
+  int fd, i;
+
+  fd = (int)(long)theData;
+
+  if (fd < 0 || theType == CWET_EDESC)
+    {
+      return;
+    }
+
+  if (!watches)
+    {
+      watches = [[NSMutableArray alloc] init];
+      timer_modes = [[NSMutableArray alloc] init];
+    }
+
+  for (i = 0; i < [watches count]; i++)
+    {
+      aWatch = [watches objectAtIndex: i];
+
+      if (aWatch->fd == fd && aWatch->type == theType && aWatch->watcher == theWatcher)
+	{
+	  goto have_watch;
+	}
+    }
+
+  aWatch = [[CWWatch alloc] init];
+  aWatch->fd = fd;
+  aWatch->type = theType;
+  aWatch->watcher = [theWatcher retain];
+  [watches addObject: aWatch];
+  [aWatch release];
+
+ have_watch:
+  if (!poll_timer)
+    {
+      poll_timer = [[NSTimer timerWithTimeInterval: POLL_INTERVAL
+			     target: self
+			     selector: @selector(_poll:)
+			     userInfo: nil
+			     repeats: YES] retain];
+      [timer_modes removeAllObjects];
+    }
+
+  if (!theMode)
+    {
+      theMode = NSDefaultRunLoopMode;
+    }
+
+  if (![timer_modes containsObject: theMode])
+    {
+      [timer_modes addObject: theMode];
+      [[NSRunLoop currentRunLoop] addTimer: poll_timer  forMode: theMode];
+    }
+}
+
+
++ (void) removeEvent: (void *) theData
+                type: (CWRunLoopEventType) theType
+             forMode: (NSString *) theMode
+                 all: (BOOL) removeAll
+{
+  int fd, i;
+
+  fd = (int)(long)theData;
+
+  for (i = [watches count] - 1; i >= 0; i--)
+    {
+      CWWatch *aWatch;
+
+      aWatch = [watches objectAtIndex: i];
+
+      if (aWatch->fd == fd && aWatch->type == theType)
+	{
+	  [watches removeObjectAtIndex: i];
+	}
+    }
+
+  if (![watches count])
+    {
+      [self _stopTimer];
+    }
+}
+
+@end
+
+
+@implementation CWRunLoopWatcher (Private)
+
++ (void) _stopTimer
+{
+  if (poll_timer)
+    {
+      [poll_timer invalidate];
+      [poll_timer release];
+      poll_timer = nil;
+    }
+}
+
+//
+// Drop the watches whose descriptor is no longer valid.
+//
++ (void) _prune
+{
+  int i;
+
+  for (i = [watches count] - 1; i >= 0; i--)
+    {
+      CWWatch *aWatch;
+
+      aWatch = [watches objectAtIndex: i];
+
+      if (fcntl(aWatch->fd, F_GETFL, 0) == -1)
+	{
+	  [watches removeObjectAtIndex: i];
+	}
+    }
+}
+
++ (void) _poll: (NSTimer *) theTimer
+{
+  NSArray *snapshot;
+  fd_set rset, wset;
+  struct timeval tv;
+  int i, maxfd, r;
+
+  if (![watches count])
+    {
+      [self _stopTimer];
+      return;
+    }
+
+  FD_ZERO(&rset);
+  FD_ZERO(&wset);
+  maxfd = -1;
+
+  for (i = 0; i < [watches count]; i++)
+    {
+      CWWatch *aWatch;
+
+      aWatch = [watches objectAtIndex: i];
+
+      if (aWatch->fd >= FD_SETSIZE)
+	{
+	  continue;
+	}
+
+      FD_SET(aWatch->fd, aWatch->type == CWET_WDESC ? &wset : &rset);
+
+      if (aWatch->fd > maxfd)
+	{
+	  maxfd = aWatch->fd;
+	}
+    }
+
+  if (maxfd < 0)
+    {
+      return;
+    }
+
+  tv.tv_sec = 0;
+  tv.tv_usec = 0;
+
+  r = select(maxfd + 1, &rset, &wset, NULL, &tv);
+
+  if (r < 0)
+    {
+      if (errno == EBADF)
+	{
+	  [self _prune];
+	}
+      return;
+    }
+
+  if (r == 0)
+    {
+      return;
+    }
+
+  //
+  // The watchers can add and remove watches while handling an event,
+  // so we walk a snapshot and make sure each watch is still registered.
+  //
+  snapshot = [NSArray arrayWithArray: watches];
+
+  for (i = 0; i < [snapshot count]; i++)
+    {
+      CWWatch *aWatch;
+
+      aWatch = [snapshot objectAtIndex: i];
+
+      if (aWatch->fd >= FD_SETSIZE ||
+	  [watches indexOfObjectIdenticalTo: aWatch] == NSNotFound)
+	{
+	  continue;
+	}
+
+      if (FD_ISSET(aWatch->fd, aWatch->type == CWET_WDESC ? &wset : &rset))
+	{
+	  [aWatch->watcher receivedEvent: (void *)(long)aWatch->fd
+			   type: aWatch->type
+			   extra: 0
+			   forMode: nil];
+	}
+    }
+}
+
+@end
