+/*
+**  CWCompat.h
+**
+**  What Pantomime needs from a newer Foundation than OPENSTEP 4.2's.  Only
+**  active when CW_OPENSTEP is defined; the implementation is in CWCompat.m.
+**
+**  Distributed under the same terms as Pantomime (LGPL 2.1 or later).
+*/
+
+#ifndef _Pantomime_H_CWCompat
+#define _Pantomime_H_CWCompat
+
+#ifdef CW_OPENSTEP
+
+#include <sys/types.h>
+
+// OPENSSL's e_os2.h (included below through compat/stdint.h) declares socklen_t
+// itself, unless it is a macro.
+#ifndef CW_HAVE_SOCKLEN_T
+#define socklen_t int
+#endif
+
+#include <limits.h>
+#include <math.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#import <Foundation/NSObject.h>
+#import <Foundation/NSString.h>
+#import <Foundation/NSData.h>
+#import <Foundation/NSValue.h>
+#import <Foundation/NSRange.h>
+#import <Foundation/NSProcessInfo.h>
+#import <Foundation/NSDate.h>
+
+#define object_getClass(o) ([(o) class])
+
+// <sys/stat.h> and <errno.h> only have these with _POSIX_SOURCE.
+#ifndef S_IRUSR
+#define S_IRUSR 0000400
+#endif
+#ifndef S_IWUSR
+#define S_IWUSR 0000200
+#endif
+#ifndef EOVERFLOW
+#define EOVERFLOW 84
+#endif
+
+// Not in the OPENSTEP math library.
+#define round(x) floor((x) + 0.5)
+#define lround(x) ((long)floor((x) + 0.5))
+
+/* only <sys/types.h> with _POSIX_SOURCE has ssize_t */
+#ifndef _POSIX_SOURCE
+typedef int ssize_t;
+#endif
+typedef int NSInteger;
+typedef unsigned int NSUInteger;
+#define NSUIntegerMax UINT_MAX
+#define NSIntegerMax INT_MAX
+#define NSIntegerMin INT_MIN
+
+@interface NSNull : NSObject
++ (NSNull *) null;
+@end
+
+@interface NSString (PantomimeOPENSTEP)
+- (const char *) UTF8String;
++ (id) stringWithUTF8String: (const char *) theBytes;
+- (NSString *) stringByReplacingPercentEscapesUsingEncoding: (NSStringEncoding) theEncoding;
+@end
+
+@interface NSString (PantomimeOPENSTEPBytes)
+- (id) initWithBytes: (const void *) theBytes
+	      length: (unsigned int) theLength
+	    encoding: (NSStringEncoding) theEncoding;
+@end
+
+@interface NSData (PantomimeOPENSTEP)
++ (id) dataWithBytesNoCopy: (void *) theBytes
+		    length: (unsigned int) theLength
+	      freeWhenDone: (BOOL) theBOOL;
+@end
+
+@interface NSMutableData (PantomimeOPENSTEP)
+- (void) replaceBytesInRange: (NSRange) theRange
+		   withBytes: (const void *) theBytes
+		      length: (unsigned int) theLength;
+@end
+
+@interface NSMutableString (PantomimeOPENSTEP)
+- (unsigned int) replaceOccurrencesOfString: (NSString *) theTarget
+				 withString: (NSString *) theReplacement
+				    options: (unsigned int) theOptions
+				      range: (NSRange) theRange;
+@end
+
+@interface NSValue (PantomimeOPENSTEP)
++ (NSValue *) valueWithRange: (NSRange) theRange;
+- (NSRange) rangeValue;
+@end
+
+@interface NSObject (PantomimeOPENSTEP)
+- (id) valueForKey: (NSString *) theKey;
+- (id) subclassResponsibility: (SEL) theSelector;
+@end
+
+@interface NSProcessInfo (PantomimeOPENSTEP)
+- (int) processIdentifier;
+@end
+
+#endif // CW_OPENSTEP
+
+#endif // _Pantomime_H_CWCompat
diff -ruN -x Pantomime.framework -x obj -x derived_src a/Framework/Pantomime/CWCompat.m b/Framework/Pantomime/CWCompat.m
--- a/Framework/Pantomime/CWCompat.m	1970-01-01 00:00:00.000000000 +0000
+++ b/Framework/Pantomime/CWCompat.m	2026-10-16 01:31:54.920853290 +0000
@@ -0,0 +1,294 @@
+/*
+**  CWCompat.m
+**
+**  See CWCompat.h.
+*/
+
+#import <Pantomime/CWCompat.h>
+
+#ifdef CW_OPENSTEP
+
+#import <Foundation/NSData.h>
+#import <Foundation/NSException.h>
+#import <Foundation/NSObjCRuntime.h>
+
+#include <ctype.h>
+#include <string.h>
+#include <unistd.h>
+
+
+void CWDebugLog(NSString *format, ...)
+{
+#ifdef DEBUG
+  va_list args;
+
+  va_start(args, format);
+  NSLogv(format, args);
+  va_end(args);
+#endif
+}
+
+
+@implementation NSNull
+
+static NSNull *null_instance = nil;
+
++ (NSNull *) null
+{
+  if (!null_instance)
+    {
+      null_instance = [[NSNull alloc] init];
+    }
+  return null_instance;
+}
+
+- (NSString *) description
+{
+  return @"<null>";
+}
+
+@end
+
+
+@implementation NSString (PantomimeOPENSTEP)
+
+- (const char *) UTF8String
+{
+  NSMutableData *aData;
+  NSData *bytes;
+
+  bytes = [self dataUsingEncoding: NSUTF8StringEncoding  allowLossyConversion: YES];
+  aData = [NSMutableData dataWithData: bytes];
+  [aData appendBytes: "" length: 1];
+
+  return (const char *)[aData bytes];
+}
+
++ (id) stringWithUTF8String: (const char *) theBytes
+{
+  NSString *aString;
+
+  if (!theBytes)
+    {
+      return nil;
+    }
+
+  aString = [[NSString alloc] initWithData: [NSData dataWithBytes: theBytes  length: strlen(theBytes)]
+			      encoding: NSUTF8StringEncoding];
+  return [aString autorelease];
+}
+
+//
+// Decodes %XX sequences.  The bytes are then read in the given encoding.
+//
+- (NSString *) stringByReplacingPercentEscapesUsingEncoding: (NSStringEncoding) theEncoding
+{
+  NSMutableData *aMutableData;
+  NSData *aData;
+  NSString *aString;
+  const unsigned char *bytes;
+  unsigned int i, len;
+
+  aData = [self dataUsingEncoding: NSASCIIStringEncoding  allowLossyConversion: YES];
+  bytes = (const unsigned char *)[aData bytes];
+  len = [aData length];
+
+  aMutableData = [NSMutableData dataWithCapacity: len];
+
+  for (i = 0; i < len; i++)
+    {
+      unsigned char c;
+
+      c = bytes[i];
+
+      if (c == '%' && i + 2 < len && isxdigit(bytes[i+1]) && isxdigit(bytes[i+2]))
+	{
+	  int hi, lo;
+
+	  hi = bytes[i+1];
+	  lo = bytes[i+2];
+	  hi = (hi <= '9' ? hi - '0' : (hi | 0x20) - 'a' + 10);
+	  lo = (lo <= '9' ? lo - '0' : (lo | 0x20) - 'a' + 10);
+	  c = (unsigned char)(hi * 16 + lo);
+	  i += 2;
+	}
+
+      [aMutableData appendBytes: &c  length: 1];
+    }
+
+  aString = [[NSString alloc] initWithData: aMutableData  encoding: theEncoding];
+  return [aString autorelease];
+}
+
+@end
+
+
+@implementation NSString (PantomimeOPENSTEPBytes)
+
+- (id) initWithBytes: (const void *) theBytes
+	      length: (unsigned int) theLength
+	    encoding: (NSStringEncoding) theEncoding
+{
+  return [self initWithData: [NSData dataWithBytes: theBytes  length: theLength]
+	       encoding: theEncoding];
+}
+
+@end
+
+
+@implementation NSData (PantomimeOPENSTEP)
+
+//
+// With NO the caller keeps the buffer, so the data has to be a copy.
+//
++ (id) dataWithBytesNoCopy: (void *) theBytes
+		    length: (unsigned int) theLength
+	      freeWhenDone: (BOOL) theBOOL
+{
+  if (theBOOL)
+    {
+      return [self dataWithBytesNoCopy: theBytes  length: theLength];
+    }
+
+  return [self dataWithBytes: theBytes  length: theLength];
+}
+
+@end
+
+
+@implementation NSMutableData (PantomimeOPENSTEP)
+
+- (void) replaceBytesInRange: (NSRange) theRange
+		   withBytes: (const void *) theBytes
+		      length: (unsigned int) theLength
+{
+  char *replacement, *tail;
+  unsigned int total, tailLength;
+
+  if (theLength == theRange.length)
+    {
+      if (theLength > 0)
+	{
+	  [self replaceBytesInRange: theRange  withBytes: theBytes];
+	}
+      return;
+    }
+
+  total = [self length];
+  tailLength = total - NSMaxRange(theRange);
+
+  // The new bytes may be part of this data, so copy them and the tail first.
+  replacement = (char *)malloc(theLength + 1);
+  tail = (char *)malloc(tailLength + 1);
+
+  if (theLength > 0)
+    {
+      memcpy(replacement, theBytes, theLength);
+    }
+
+  if (tailLength > 0)
+    {
+      memcpy(tail, (char *)[self bytes] + NSMaxRange(theRange), tailLength);
+    }
+
+  [self setLength: theRange.location + theLength + tailLength];
+
+  if (theLength > 0)
+    {
+      memcpy((char *)[self mutableBytes] + theRange.location, replacement, theLength);
+    }
+
+  if (tailLength > 0)
+    {
+      memcpy((char *)[self mutableBytes] + theRange.location + theLength, tail, tailLength);
+    }
+
+  free(replacement);
+  free(tail);
+}
+
+@end
+
+
+@implementation NSMutableString (PantomimeOPENSTEP)
+
+- (unsigned int) replaceOccurrencesOfString: (NSString *) theTarget
+				 withString: (NSString *) theReplacement
+				    options: (unsigned int) theOptions
+				      range: (NSRange) theRange
+{
+  NSRange r;
+  unsigned int count, end;
+
+  count = 0;
+  end = theRange.location + theRange.length;
+
+  while (theRange.length > 0)
+    {
+      r = [self rangeOfString: theTarget  options: theOptions  range: theRange];
+
+      if (r.length == 0)
+	{
+	  break;
+	}
+
+      [self replaceCharactersInRange: r  withString: theReplacement];
+      count++;
+
+      end = end - r.length + [theReplacement length];
+      theRange.location = r.location + [theReplacement length];
+      theRange.length = (end > theRange.location ? end - theRange.location : 0);
+    }
+
+  return count;
+}
+
+@end
+
+
+@implementation NSValue (PantomimeOPENSTEP)
+
++ (NSValue *) valueWithRange: (NSRange) theRange
+{
+  return [NSValue valueWithBytes: &theRange  objCType: @encode(NSRange)];
+}
+
+- (NSRange) rangeValue
+{
+  NSRange aRange;
+
+  [self getValue: &aRange];
+  return aRange;
+}
+
+@end
+
+
+@implementation NSObject (PantomimeOPENSTEP)
+
+- (id) valueForKey: (NSString *) theKey
+{
+  return [self performSelector: NSSelectorFromString(theKey)];
+}
+
+- (id) subclassResponsibility: (SEL) theSelector
+{
+  [NSException raise: NSGenericException
+	       format: @"subclass %s should override %s", [NSStringFromClass([self class]) cString],
+	       [NSStringFromSelector(theSelector) cString]];
+  return nil;
+}
+
+@end
+
+
+@implementation NSProcessInfo (PantomimeOPENSTEP)
+
+- (int) processIdentifier
+{
+  return (int)getpid();
+}
+
+@end
+
+#endif // CW_OPENSTEP
