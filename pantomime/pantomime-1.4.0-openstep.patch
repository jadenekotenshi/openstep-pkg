+//
+// The current date and time as an RFC 2822 date, such as
+// "Tue, 06 Oct 2026 10:00:00 -0600", in English whatever the locale.
+//
+static NSString *cw_rfc2822_date(void)
+{
+  static const char *days[] = {"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"};
+  static const char *months[] = {"Jan", "Feb", "Mar", "Apr", "May", "Jun",
+				 "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"};
+  struct tm l, g, *t;
+  time_t now;
+  char buf[64];
+  int offset;
+
+  now = time(NULL);
+  t = localtime(&now);
+  l = *t;
+  t = gmtime(&now);
+  g = *t;
+
+  offset = (l.tm_hour - g.tm_hour) * 60 + (l.tm_min - g.tm_min);
+
+  if (l.tm_year != g.tm_year)
+    {
+      offset += (l.tm_year > g.tm_year ? 24*60 : -24*60);
+    }
+  else if (l.tm_yday != g.tm_yday)
+    {
+      offset += (l.tm_yday > g.tm_yday ? 24*60 : -24*60);
+    }
+
+  sprintf(buf, "%s, %02d %s %04d %02d:%02d:%02d %c%02d%02d",
+	  days[l.tm_wday], l.tm_mday, months[l.tm_mon], l.tm_year + 1900,
+	  l.tm_hour, l.tm_min, l.tm_sec,
+	  (offset < 0 ? '-' : '+'), (offset < 0 ? -offset : offset) / 60,
+	  (offset < 0 ? -offset : offset) % 60);
+
+  return [NSString stringWithCString: buf];
+}
