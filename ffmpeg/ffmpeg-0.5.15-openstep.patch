@@ -0,0 +1,58 @@
+/* OPENSTEP libc compatibility; LGPL 2.1 or later. */
+#ifdef NeXT
+#include "openstep.h"
+#include <string.h>
+#include <limits.h>
+#include <ctype.h>
+#include "stdint.h"
+
+long long avpriv_openstep_atoll(const char *text)
+{
+    unsigned long long value = 0, limit;
+    int negative;
+    while (isspace((unsigned char)*text)) ++text;
+    negative = *text == '-';
+    if (*text == '-' || *text == '+') ++text;
+    limit = (unsigned long long)INT64_MAX + negative;
+    while (*text >= '0' && *text <= '9') {
+        unsigned digit = *text++ - '0';
+        if (value > (limit - digit) / 10) {
+            errno = ERANGE;
+            return negative ? INT64_MIN : INT64_MAX;
+        }
+        value = value * 10 + digit;
+    }
+    if (negative) return value ? -(long long)(value - 1) - 1 : 0;
+    return (long long)value;
+}
+
+/* curl's formatter handles 64-bit integers; its snprintf has different
+ * truncation semantics, so use the allocating API for a C99 result. */
+int avpriv_openstep_vsnprintf(char *dst, size_t size, const char *fmt, va_list ap)
+{
+    char *text;
+    size_t length, copied;
+    if (size) dst[0] = 0;
+    text = curl_mvaprintf(fmt, ap);
+    if (!text) return -1;
+    length = strlen(text);
+    if (length > INT_MAX) { free(text); return -1; }
+    if (size) {
+        copied = length < size ? length : size - 1;
+        memcpy(dst, text, copied);
+        dst[copied] = 0;
+    }
+    free(text);
+    return (int)length;
+}
+
+int avpriv_openstep_snprintf(char *dst, size_t size, const char *fmt, ...)
+{
+    va_list ap;
+    int result;
+    va_start(ap, fmt);
+    result = avpriv_openstep_vsnprintf(dst, size, fmt, ap);
+    va_end(ap);
+    return result;
+}
+#endif
