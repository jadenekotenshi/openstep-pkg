@@ -0,0 +1,32 @@
+/* OPENSTEP libc compatibility regression, LGPL 2.1 or later. */
+#include "libavutil/openstep.h"
+#include "libavcodec/avcodec.h"
+#include <assert.h>
+#include <string.h>
+
+int main(void)
+{
+    char buffer[64], shortbuf[4];
+    unsigned char fill[8];
+    int i;
+    memset(fill, 0xa6, sizeof fill);
+    for (i = 0; i < sizeof fill; ++i) assert(fill[i] == 0xa6);
+    assert(snprintf(buffer, sizeof(buffer), "%lld/%llu/%zu",
+        (long long)INT64_MIN, (unsigned long long)UINT64_MAX, (size_t)123) == 45);
+    assert(!strcmp(buffer, "-9223372036854775808/18446744073709551615/123"));
+    assert(snprintf(shortbuf, sizeof(shortbuf), "%s", "abcdef") == 6);
+    assert(!strcmp(shortbuf, "abc"));
+    assert(snprintf(NULL, 0, "%s", "abcdef") == 6);
+    assert(atoll("  -9223372036854775808tail") == INT64_MIN);
+    assert(atoll("+9223372036854775807") == INT64_MAX);
+    assert(atoll("4294967296/5000000000") == INT64_C(4294967296));
+    errno = 0;
+    assert(atoll("9223372036854775808") == INT64_MAX && errno == ERANGE);
+    errno = 0;
+    assert(atoll("-99999999999999999999") == INT64_MIN && errno == ERANGE);
+    assert(atoll("") == 0 && atoll("-") == 0 && atoll("n/a") == 0);
+    assert(cbrtf(27.0f) > 2.99f && cbrtf(27.0f) < 3.01f);
+    assert(rintf(1.75f) == 2.0f);
+    assert(AVERROR_NOFMT != AVERROR_INVALIDDATA);
+    return 0;
+}
