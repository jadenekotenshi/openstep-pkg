#!/bin/sh
set -e
DESTDIR=$1
VERSION=$2
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin
CC=/usr/local/bin/gcc-4.2
CFLAGS="$PKG_GCC42_ARCH_FLAGS "'-O2'
SED=/bin/sed
GREP=/usr/local/bin/grep
EGREP='/usr/local/bin/grep -E'
AWK=/usr/local/bin/gawk
export PATH CC CFLAGS SED GREP EGREP AWK
if test -d "ntp-$VERSION"; then cd "ntp-$VERSION"; fi
. "$PKG_BUILD_HELPERS"
# OPENSTEP has neither <stdint.h> nor <inttypes.h>, and ntp's libopts refuses to
# configure without one.  Provide both from a private include directory.  The
# targets are 32-bit: int is 32 bits, long long is 64, and the pointer-sized
# types come from the compiler.
/usr/local/bin/mkdir -p openstep
/bin/cat > openstep/stdint.h <<'SEOF'
#ifndef OPENSTEP_STDINT_H
#define OPENSTEP_STDINT_H
typedef signed char int8_t;
typedef short int16_t;
typedef int int32_t;
typedef long long int64_t;
typedef unsigned char uint8_t;
typedef unsigned short uint16_t;
typedef unsigned int uint32_t;
typedef unsigned long long uint64_t;
typedef __PTRDIFF_TYPE__ intptr_t;
typedef __SIZE_TYPE__ uintptr_t;
typedef long long intmax_t;
typedef unsigned long long uintmax_t;
#define INT8_MIN (-128)
#define INT8_MAX 127
#define UINT8_MAX 255
#define INT16_MIN (-32767-1)
#define INT16_MAX 32767
#define UINT16_MAX 65535
#define INT32_MIN (-2147483647-1)
#define INT32_MAX 2147483647
#define UINT32_MAX 4294967295U
#define INT64_MIN (-9223372036854775807LL-1)
#define INT64_MAX 9223372036854775807LL
#define UINT64_MAX 18446744073709551615ULL
#define INTPTR_MIN INT32_MIN
#define INTPTR_MAX INT32_MAX
#define UINTPTR_MAX UINT32_MAX
#define SIZE_MAX UINT32_MAX
#endif
SEOF
/bin/cat > openstep/inttypes.h <<'SEOF'
#ifndef OPENSTEP_INTTYPES_H
#define OPENSTEP_INTTYPES_H
#include <stdint.h>
#define PRId32 "d"
#define PRIi32 "i"
#define PRIu32 "u"
#define PRIx32 "x"
#define PRId64 "lld"
#define PRIi64 "lli"
#define PRIu64 "llu"
#define PRIx64 "llx"
#endif
SEOF
CPPFLAGS="-I`pwd`/openstep"
export CPPFLAGS
# No sntp (needs libevent), no OpenSSL (MD5 keys still work; SHA-1 keys and
# Autokey do not), no ntpsnmpd, no ntp-keygen autokey, no kernel PLL tricks.
# configure runs sntp/scripts/genHardFlags to pick compiler hardening flags
# (even with --without-sntp).  It detects the OS with config.guess and uname,
# getopt and other things OPENSTEP's tools may not provide, and this build wants
# no hardening flags anyway, so replace it with a script that says so.
/bin/cat > sntp/scripts/genHardFlags <<'GHEOF'
#! /bin/sh
echo "GENHARDFLAGFILE=harden/default"
echo "NTP_HARD_CFLAGS=''"
echo "NTP_HARD_CPPFLAGS=''"
echo "NTP_HARD_LDFLAGS=''"
echo GENHARDFLAG=OK
exit 0
GHEOF
/bin/chmod 755 sntp/scripts/genHardFlags
# configure also runs sntp/scripts/genLocInfo to learn where each program and
# man page installs.  It has the same OS-detection and getopt dependencies, so
# supply its output for the "legacy" layout (everything in bin, section 1) as
# generated by the real script from loc/legacy.
/bin/cat > sntp/scripts/genLocInfo <<'GLEOF'
#! /bin/sh
/bin/cat <<'GLDATA'
GENLOCINFOFILE=loc/legacy
MANTAGFMT=man
CALC_TICKADJ_DB=calc_tickadj
CALC_TICKADJ_DL=
CALC_TICKADJ_DS=
CALC_TICKADJ_NI=
CALC_TICKADJ_MS=1
NTP_KEYGEN_DB=ntp-keygen
NTP_KEYGEN_DL=
NTP_KEYGEN_DS=
NTP_KEYGEN_NI=
NTP_KEYGEN_MS=1
NTP_WAIT_DB=ntp-wait
NTP_WAIT_DL=
NTP_WAIT_DS=
NTP_WAIT_NI=
NTP_WAIT_MS=1
NTPD_DB=ntpd
NTPD_DL=
NTPD_DS=
NTPD_NI=
NTPD_MS=1
NTPDATE_DB=ntpdate
NTPDATE_DL=
NTPDATE_DS=
NTPDATE_NI=
NTPDATE_MS=1
NTPDC_DB=ntpdc
NTPDC_DL=
NTPDC_DS=
NTPDC_NI=
NTPDC_MS=1
NTPDSIM_DB=ntpdsim
NTPDSIM_DL=
NTPDSIM_DS=
NTPDSIM_NI=
NTPDSIM_MS=1
NTPQ_DB=ntpq
NTPQ_DL=
NTPQ_DS=
NTPQ_NI=
NTPQ_MS=1
NTPSNMPD_DB=ntpsnmpd
NTPSNMPD_DL=
NTPSNMPD_DS=
NTPSNMPD_NI=
NTPSNMPD_MS=1
NTPSWEEP_DB=
NTPSWEEP_DL=
NTPSWEEP_DS=
NTPSWEEP_NI=ntpsweep
NTPSWEEP_MS=1
NTPTIME_DB=ntptime
NTPTIME_DL=
NTPTIME_DS=
NTPTIME_NI=
NTPTIME_MS=1
NTPTRACE_DB=ntptrace
NTPTRACE_DL=
NTPTRACE_DS=
NTPTRACE_NI=
NTPTRACE_MS=1
SNTP_DB=sntp
SNTP_DL=
SNTP_DS=
SNTP_NI=
SNTP_MS=1
TICKADJ_DB=tickadj
TICKADJ_DL=
TICKADJ_DS=
TICKADJ_NI=
TICKADJ_MS=1
TIMETRIM_DB=timetrim
TIMETRIM_DL=
TIMETRIM_DS=
TIMETRIM_NI=
TIMETRIM_MS=1
UPDATE_LEAP_DB=update-leap
UPDATE_LEAP_DL=
UPDATE_LEAP_DS=
UPDATE_LEAP_NI=
UPDATE_LEAP_MS=1
GENLOCINFO=OK
GLDATA
exit 0
GLEOF
/bin/chmod 755 sntp/scripts/genLocInfo
# --disable-thread-support: configure finds <cthreads.h> and then cannot link
# Mach CThreads; ntpd copes without threads (name lookups use a child process).
# Everything stays under /usr/local; configuration is /usr/local/etc/ntpd.conf
# (start ntpd with -c /usr/local/etc/ntpd.conf).
run_configure --prefix=/usr/local --sysconfdir=/usr/local/etc \
    --build=$PKG_TARGET --host=$PKG_TARGET \
    --without-crypto --without-sntp --without-ntpsnmpd --disable-debugging \
    --disable-thread-support --disable-dependency-tracking
/bin/gnumake
/bin/gnumake install DESTDIR="$DESTDIR"

# ntp installs the daemon into bin; it belongs in sbin.
/usr/local/bin/mkdir -p "$DESTDIR/usr/local/sbin"
/bin/mv "$DESTDIR/usr/local/bin/ntpd" "$DESTDIR/usr/local/sbin/ntpd"

# Ship the default configuration as ntpd.conf.dist; post-install copies it to
# ntpd.conf only when there is none, so a reinstall never replaces the
# administrator's file.
/usr/local/bin/mkdir -p "$DESTDIR/usr/local/etc" "$DESTDIR/usr/local/var/db"
/bin/cat > "$DESTDIR/usr/local/etc/ntpd.conf.dist" <<'CEOF'
# ntpd configuration.  Start with: /usr/local/sbin/ntpd -c /usr/local/etc/ntpd.conf
server 0.pool.ntp.org iburst
server 1.pool.ntp.org iburst
server 2.pool.ntp.org iburst
server 3.pool.ntp.org iburst

driftfile /usr/local/var/db/ntp.drift

# Answer time queries from this machine only; never let others change or
# query the daemon.
restrict default nomodify notrap nopeer noquery
restrict 127.0.0.1
CEOF

# Never ship a configuration file: a reinstall would replace the administrator's.
for stray in etc usr/lib; do
    if test -e "$DESTDIR/$stray"; then
        echo "ntp: the image contains $stray outside /usr/local; refusing to ship it" >&2
        exit 1
    fi
done
test -x "$DESTDIR/usr/local/sbin/ntpd"
test -f "$DESTDIR/usr/local/etc/ntpd.conf.dist"
test ! -e "$DESTDIR/usr/local/etc/ntpd.conf"
