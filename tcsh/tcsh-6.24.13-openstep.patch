@@ -166,10 +166,8 @@
  *** NeXT OS 3.x
  ***/
 #ifdef NeXT
-# ifndef _SPEED_T
-#  define _SPEED_T
-   typedef unsigned int speed_t;
-# endif /* _SPEED_T */
+/* OPENSTEP's headers already define speed_t (with a different type), and
+   redefining it is an error, so there is nothing to do. */
 #endif /* NeXT */
 
 /***
@@ -361,7 +359,7 @@
     typedef int pid_t;
 # endif /* _PID_T */
 
-# ifndef _SPEED_T
+# if !defined(_SPEED_T) && !defined(NeXT)
 #  define _SPEED_T
     typedef unsigned int speed_t;
