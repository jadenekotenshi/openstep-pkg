diff -ruN tca/tcsh-6.24.13/configure tcb/tcsh-6.24.13/configure
--- a/configure	2024-06-12 05:52:47.000000000 +0000
+++ b/configure	2026-10-06 02:52:24.776204814 +0000
@@ -6089,6 +6089,10 @@
   *-qnx6*) :
         tcsh_config_file=qnx6
    ;; #(
+  ## NeXT, OPENSTEP (Mach); system/mach has the NeXT settings
+  *-next-*) :
+        tcsh_config_file=mach
+   ;; #(
   *) :
     as_fn_error $? "Tcsh can't guess the configuration file name
 for \`${host}' systems.
diff -ruN tca/tcsh-6.24.13/sh.file.c tcb/tcsh-6.24.13/sh.file.c
--- a/sh.file.c	2024-06-12 05:52:47.000000000 +0000
+++ b/sh.file.c	2026-10-06 03:27:58.106615432 +0000
@@ -218,6 +218,7 @@
 # endif /* POSIX */
 #else
     struct sgttyb tty, tty_normal;
+    char c;	/* the BSD tty code below uses it, but never declared it */
 #endif /* TERMIO */
 
     pintr_disabled++;
diff -ruN tca/tcsh-6.24.13/sh.types.h tcb/tcsh-6.24.13/sh.types.h
--- a/sh.types.h	2024-06-12 05:52:47.000000000 +0000
