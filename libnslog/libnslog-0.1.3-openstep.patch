diff --git a/src/Makefile b/src/Makefile
index d598cf5..6887a5a 100644
--- a/src/Makefile
+++ b/src/Makefile
@@ -4,6 +4,10 @@ CFLAGS := $(CFLAGS) -I$(BUILDDIR) -Isrc/
 
 SOURCES := $(SOURCES) $(BUILDDIR)/filter-parser.c $(BUILDDIR)/filter-lexer.c
 
+# Both the parser and filter.c include the generated lexer header.
+PRE_TARGETS := $(PRE_TARGETS) $(BUILDDIR)/filter-parser.h $(BUILDDIR)/filter-lexer.h
+$(BUILDDIR)/filter-parser.h $(BUILDDIR)/filter-lexer.h: | $(BUILDDIR)/stamp
+
 $(BUILDDIR)/%-lexer.inc $(BUILDDIR)/%-lexer.h: src/%-lexer.l
 	$(VQ)$(ECHO) "	  FLEX: $<"
 	$(Q)$(FLEX) --outfile=$(BUILDDIR)/$(*F)-lexer.inc --header-file=$(BUILDDIR)/$(*F)-lexer.h $<
