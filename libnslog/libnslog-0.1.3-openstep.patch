 	va_list ap;
 	va_start(ap, pattern);
 	if (nslog__corked) {
+#ifdef NeXT
+		FILE *stream;
+		char *message;
+		long length;
+
+		/* OPENSTEP has no vsnprintf. Measure the stream position: its
+		   vfprintf returns zero on success, not the byte count. */
+		stream = tmpfile();
+		if (stream == NULL) {
+			va_end(ap);
+			return;
+		}
+		if (vfprintf(stream, pattern, ap) < 0 || fflush(stream) != 0) {
+			va_end(ap);
+			fclose(stream);
+			return;
+		}
+		va_end(ap);
+		length = ftell(stream);
+		if (length < 0 || fseek(stream, 0L, SEEK_SET) != 0) {
+			fclose(stream);
+			return;
+		}
+		message = malloc((size_t)length + 1);
+		if (message != NULL) {
+			if (fread(message, 1, (size_t)length, stream) == (size_t)length) {
+				message[length] = '\0';
+				nslog__log_corked_string(ctx, (int)length, message);
+			}
+			free(message);
+		}
+		fclose(stream);
+#else
 		va_list ap2;
 		va_copy(ap2, ap);
 		int slen = vsnprintf(NULL, 0, pattern, ap);
 		va_end(ap);
 		nslog__log_corked(ctx, slen, pattern, ap2);
 		va_end(ap2);
+#endif
 	} else {
 		nslog__log_uncorked(ctx, pattern, ap);
 		va_end(ap);
