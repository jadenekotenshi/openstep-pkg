#!/bin/sh
set -e
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin
export PATH
LR=${LOCAL_ROOT-/usr/local}
work=${TMPDIR-/tmp}/afterstep-pkg-test-$$
mkdir "$work"
trap 'rm -rf "$work"' 0
trap 'exit 1' 1 2 3 15

# The window manager and its modules (they need an X server to run, so only
# their presence and the version of the manager are checked).
"$LR/bin/afterstep" -v > "$work/version"
grep 'AfterStep version 1\.8\.' "$work/version" > /dev/null
for module in Wharf Pager WinList Clean Ident Animate Banner Audio Scroll Tile Cascade Form Save asetroot
do
    test -x "$LR/bin/$module"
done

# The default configuration, themes and the start menu tree.
test -d "$LR/share/afterstep"
test -f "$LR/share/afterstep/base.24bpp"
test -f "$LR/share/afterstep/autoexec"
test -d "$LR/share/afterstep/start"
test -d "$LR/share/afterstep/desktop" || test -d "$LR/share/afterstep/non-configurable"

echo "AfterStep checks passed (the window manager itself needs an X display)"
