#!/bin/sh
set -e
DESTDIR=$1
VERSION=$2
PREFIX=/usr/local
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin:$PATH
CC="/usr/local/bin/gcc-4.2 $PKG_GCC42_ARCH_FLAGS"
# On i386 the archives are made by the cctools ar, which keeps long member names;
# the stock linker cannot read them ("no table of contents").  A gcc42 built after
# the cctools package links with the cctools ld by itself; an older one needs the
# specs file that selects it.
if [ "$PKG_ARCH" = i386 ] && [ -f /usr/local/lib/cctools/gcc42.specs ]; then
    CC="$CC -specs=/usr/local/lib/cctools/gcc42.specs"
fi
CONFIG_SHELL=/usr/local/bin/ksh
GREP=/usr/local/bin/grep
EGREP='/usr/local/bin/grep -E'
AWK=/usr/local/bin/gawk
SED=/usr/local/bin/sed

# AfterStep needs the X11 development files, including libXpm.  X11_PREFIX in
# pkg.conf says where they live (default /usr/X11R6, where CubXWindow installs).
x11_prefix=
for d in $X11_PREFIX /usr/X11R6; do
    if test -n "$d" && test -f "$d/include/X11/Xlib.h"; then
        x11_prefix=$d
        break
    fi
done
if test -z "$x11_prefix"; then
    echo "afterstep: cannot find X11/Xlib.h; install the X11 development files" >&2
    echo "afterstep: and set X11_PREFIX in pkg.conf to the directory holding include/ and lib/" >&2
    exit 1
fi
if test ! -f "$x11_prefix/include/X11/xpm.h"; then
    echo "afterstep: $x11_prefix/include/X11/xpm.h is missing; AfterStep needs libXpm" >&2
    exit 1
fi
echo "afterstep: using X11 under $x11_prefix"
CFLAGS='-O2'
CPPFLAGS="-I$x11_prefix/include -I/usr/local/include"
LDFLAGS="-L$x11_prefix/lib -L/usr/local/lib"
AR_CMD="$PKG_AR clq"
export PATH CC CFLAGS CPPFLAGS LDFLAGS CONFIG_SHELL GREP EGREP AWK SED
if test -d "afterstep-$VERSION.orig"; then cd "afterstep-$VERSION.orig"; fi
. "$PKG_BUILD_HELPERS"
patch -p1 < "afterstep-$VERSION-openstep.patch"

# OPENSTEP's libc and headers lack S_IRUSR and friends, waitpid(), putenv(),
# strdup() and the POSIX <dirent.h>.  A private include directory supplies them
# (static functions, renamed by macros, so they cannot clash); the compat header is
# forced into every compile through CFLAGS, which configure copies to the Makefiles.
/usr/local/bin/mkdir -p openstep
/bin/cat > openstep/dirent.h <<'SEOF'
#ifndef OPENSTEP_DIRENT_H
#define OPENSTEP_DIRENT_H
#undef _POSIX_SOURCE
#ifndef _NEXT_SOURCE
# define _NEXT_SOURCE 1
#endif
#include <sys/types.h>
#include <sys/dir.h>
#define dirent direct
#endif
SEOF
/bin/cat > openstep/afterstep-compat.h <<'SEOF'
#ifndef OPENSTEP_AFTERSTEP_COMPAT_H
#define OPENSTEP_AFTERSTEP_COMPAT_H
#include <sys/types.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <stdlib.h>
#include <string.h>
#ifndef O_NONBLOCK
# ifdef FNDELAY
#  define O_NONBLOCK FNDELAY
# else
#  define O_NONBLOCK 0x0004
# endif
#endif
#ifndef S_IRUSR
# define S_IRUSR 0000400
# define S_IWUSR 0000200
# define S_IXUSR 0000100
# define S_IRWXU 0000700
# define S_IRGRP 0000040
# define S_IWGRP 0000020
# define S_IXGRP 0000010
# define S_IRWXG 0000070
# define S_IROTH 0000004
# define S_IWOTH 0000002
# define S_IXOTH 0000001
# define S_IRWXO 0000007
#endif
#ifdef OSTEP_NEED_MODE_T
typedef unsigned short mode_t;
#endif
#ifdef OSTEP_NEED_SSIZE_T
typedef int ssize_t;
#endif
#ifndef R_OK
# define F_OK 0
# define X_OK 1
# define W_OK 2
# define R_OK 4
#endif
#ifndef SEEK_SET
# define SEEK_SET 0
# define SEEK_CUR 1
# define SEEK_END 2
#endif
#define alloca __builtin_alloca
extern char **environ;
extern int wait4();
static int
ostep_waitpid(int pid, int *status, int options)
{
    return wait4(pid, (void *) status, options, (void *) 0);
}
static char *
ostep_strdup(const char *s)
{
    size_t n = strlen(s) + 1;
    char *p = (char *) malloc(n);

    if (p != NULL)
        memcpy(p, s, n);
    return p;
}
static int
ostep_putenv(char *string)
{
    char *eq = strchr(string, '=');
    size_t n, count;
    char **e, **newenv;

    if (eq == 0)
        return -1;
    n = eq - string;
    count = 0;
    for (e = environ; e != 0 && *e != 0; e++) {
        if (strncmp(*e, string, n) == 0 && (*e)[n] == '=') {
            *e = string;
            return 0;
        }
        count++;
    }
    newenv = (char **) malloc((count + 2) * sizeof(char *));
    if (newenv == 0)
        return -1;
    for (count = 0; environ != 0 && environ[count] != 0; count++)
        newenv[count] = environ[count];
    newenv[count++] = string;
    newenv[count] = 0;
    environ = newenv;
    return 0;
}
#define waitpid ostep_waitpid
#define strdup ostep_strdup
#define putenv ostep_putenv
#endif
SEOF
# Types this <sys/types.h> may lack (probed, since a typedef cannot be tested for).
OSTEP_DEFS=
printf '#include <sys/types.h>\nmode_t probe_mode;\nint main(void) { return 0; }\n' > mode-probe.c
if $CC -c mode-probe.c -o mode-probe.o > /dev/null 2>&1; then :; else
    OSTEP_DEFS="$OSTEP_DEFS -DOSTEP_NEED_MODE_T"
fi
printf '#include <sys/types.h>\nssize_t probe_ssize;\nint main(void) { return 0; }\n' > ssize-probe.c
if $CC -c ssize-probe.c -o ssize-probe.o > /dev/null 2>&1; then :; else
    OSTEP_DEFS="$OSTEP_DEFS -DOSTEP_NEED_SSIZE_T"
fi
rm -f mode-probe.c mode-probe.o ssize-probe.c ssize-probe.o
# -fno-strict-aliasing: the sources dereference type-punned pointers.
CFLAGS="$CFLAGS -fno-strict-aliasing $OSTEP_DEFS -I`pwd`/openstep -include `pwd`/openstep/afterstep-compat.h"
export CFLAGS

run_configure --build=$PKG_TARGET --prefix="$PREFIX" \
    --x-includes="$x11_prefix/include" --x-libraries="$x11_prefix/lib" \
    --with-xpm-includes="$x11_prefix/include" --with-xpm-library="$x11_prefix/lib" \
    --with-jpeg-includes=/usr/local/include --with-jpeg-library=/usr/local/lib \
    --with-png-includes=/usr/local/include --with-png-library=/usr/local/lib \
    --disable-script

# configure adds -fPIC and the stock ar/ranlib to every Makefile; the libraries
# are static and the archives need the matching ar/ranlib (cctools on i386).
for mk in `find . -name Makefile -print`; do
    sed -e 's/ -fPIC//' \
        -e "s#^AR[ 	]*=.*#AR		= $AR_CMD#" \
        -e "s#^RANLIB[ 	]*=.*#RANLIB		= $PKG_RANLIB#" \
        "$mk" > "$mk.openstep"
    mv "$mk.openstep" "$mk"
done

# The Makefiles run their sub-makes in "for ... (cd dir; make || exit 1)" loops,
# which the stock sh does not stop on a failure: a compile error then looked like
# success.  Take the directory list from the top Makefile and run each one here,
# so a failure stops the build.
MKDIRP=/usr/local/bin/mkdir
subdirs=`sed -n -e '/^subdirs/,/^$/p' Makefile | sed -e 's/^subdirs[ 	]*=//' -e 's/\\\\$//' | tr '\n' ' '`
count=0
for dir in $subdirs; do count=`expr $count + 1`; done
test "$count" -ge 20 || { echo "afterstep: could not read the module list from Makefile ($subdirs)" >&2; exit 1; }

for dir in $subdirs; do
    (cd $dir && /usr/local/bin/gnumake MKDIR="$MKDIRP") || exit 1
done
test -f src/afterstep/afterstep || { echo "afterstep: src/afterstep/afterstep was not built" >&2; exit 1; }

$MKDIRP -p "$DESTDIR$PREFIX/bin" "$DESTDIR$PREFIX/lib" "$DESTDIR$PREFIX/man/man1"
/usr/local/bin/gnumake MKDIR="$MKDIRP" install.data DESTDIR="$DESTDIR" || exit 1
for dir in $subdirs; do
    (cd $dir && /usr/local/bin/gnumake MKDIR="$MKDIRP" install DESTDIR="$DESTDIR") || exit 1
done
test -x "$DESTDIR$PREFIX/bin/afterstep" || { echo "afterstep: the window manager was not installed" >&2; exit 1; }

# A default ~/.xinitrc: post-install copies it for the installing user if there is
# none.
/bin/cat > "$DESTDIR$PREFIX/share/afterstep/xinitrc" <<'XEOF'
#!/bin/sh
# Default .xinitrc for AfterStep: a terminal, then the window manager.  When the
# window manager exits, so does the X session.
PATH=/usr/local/bin:$PATH
export PATH
aterm &
exec afterstep
XEOF
chmod 755 "$DESTDIR$PREFIX/share/afterstep/xinitrc"
