#!/bin/sh
set -e
DESTDIR=$1
VERSION=$2
PREFIX=/usr/local
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin:$PATH
CC="/usr/local/bin/gcc-4.2 $PKG_GCC42_ARCH_FLAGS"
# On i386 the archives are made by the cctools ar, which keeps long member names;
# the stock linker cannot read them.  A gcc42 built after the cctools package links
# with the cctools ld by itself; an older one needs the specs file selecting it.
if [ "$PKG_ARCH" = i386 ] && [ -f /usr/local/lib/cctools/gcc42.specs ]; then
    CC="$CC -specs=/usr/local/lib/cctools/gcc42.specs"
fi
# gnupg's multi-precision code divides with a SPARC v8 udiv instruction only when
# __sparc_v8__ is defined; otherwise it calls a v7 routine (__udiv_qrnnd) that is
# supplied as assembly, which the generic (--disable-asm) build does not have.
# These machines are v8, so say so.
if [ "$PKG_ARCH" = sparc ]; then
    CC="$CC -mcpu=v8"
fi
CONFIG_SHELL=/usr/local/bin/ksh
GREP=/usr/local/bin/grep
EGREP='/usr/local/bin/grep -E'
AWK=/usr/local/bin/gawk
SED=/usr/local/bin/sed
AR=$PKG_AR
RANLIB=$PKG_RANLIB
if test -d "gnupg-$VERSION"; then cd "gnupg-$VERSION"; fi

# GnuPG 1.4 is the classic single-binary gpg, which needs no libgcrypt, npth or
# other libraries (2.x needs POSIX threads).  Network keyserver helpers, LDAP,
# readline, NLS, the agent and photo viewers are left out; zlib and bzip2 are used.
# configure checks for the missing functions itself (sigaction, waitpid, mkdtemp,
# timegm, memrchr, strsep and so on) and uses its own replacements or fallbacks.
# The compat header supplies what <sys/stat.h> and <sys/types.h> lack: the S_I*
# mode macros and the POSIX types, the latter probed since a typedef cannot be tested.
/usr/local/bin/mkdir -p openstep
OSTEP_DEFS=
for ostep_type in mode_t ssize_t pid_t uid_t gid_t; do
    printf '#include <sys/types.h>\n%s probe_var;\nint main(void) { return 0; }\n' "$ostep_type" > type-probe.c
    if $CC -c type-probe.c -o type-probe.o > /dev/null 2>&1; then :; else
        ostep_upper=`echo $ostep_type | tr 'a-z' 'A-Z'`
        OSTEP_DEFS="$OSTEP_DEFS -DOSTEP_NEED_$ostep_upper"
    fi
done
/bin/rm -f type-probe.c type-probe.o
# rndunix.c includes the System V shared memory headers though it only uses them
# when configure found them (it did not); empty ones do.
/usr/local/bin/mkdir -p openstep/sys
echo '/* empty: System V IPC is not available here */' > openstep/sys/ipc.h
echo '/* empty: System V shared memory is not available here */' > openstep/sys/shm.h
# <sys/utsname.h> is unusable here (dotlock.c cannot get a struct utsname from it);
# uname() is made from gethostname().
/usr/local/bin/mkdir -p openstep/sys
/bin/cat > openstep/sys/utsname.h <<'SEOF'
#ifndef OPENSTEP_UTSNAME_H
#define OPENSTEP_UTSNAME_H
#include <string.h>
struct utsname {
    char sysname[64];
    char nodename[256];
    char release[64];
    char version[64];
    char machine[64];
};
extern int gethostname();
static int
ostep_uname(struct utsname *u)
{
    memset(u, 0, sizeof(*u));
    strcpy(u->sysname, "OPENSTEP");
    if (gethostname(u->nodename, sizeof(u->nodename) - 1) < 0)
        strcpy(u->nodename, "unknown");
    return 0;
}
#define uname ostep_uname
#endif
SEOF
/bin/cat > openstep/gnupg-compat.h <<'SEOF'
#ifndef OPENSTEP_GNUPG_COMPAT_H
#define OPENSTEP_GNUPG_COMPAT_H
#include <sys/types.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <errno.h>
#include <stdlib.h>
#include <string.h>
#ifndef ENOSYS
# define ENOSYS 78	/* function not implemented (BSD numbering) */
#endif
#ifdef OSTEP_NEED_MODE_T
typedef unsigned short mode_t;
#endif
#ifdef OSTEP_NEED_SSIZE_T
typedef int ssize_t;
#endif
#ifdef OSTEP_NEED_PID_T
typedef int pid_t;
#endif
#ifdef OSTEP_NEED_UID_T
typedef unsigned short uid_t;
#endif
#ifdef OSTEP_NEED_GID_T
typedef unsigned short gid_t;
#endif
#ifndef S_IRUSR
# define S_IRUSR 0000400
# define S_IWUSR 0000200
# define S_IXUSR 0000100
# define S_IRWXU 0000700
# define S_IRGRP 0000040
# define S_IWGRP 0000020
# define S_IXGRP 0000010
# define S_IRWXG 0000070
# define S_IROTH 0000004
# define S_IWOTH 0000002
# define S_IXOTH 0000001
# define S_IRWXO 0000007
#endif
#ifndef S_ISDIR
# define S_ISDIR(m) (((m) & S_IFMT) == S_IFDIR)
#endif
#ifndef S_ISREG
# define S_ISREG(m) (((m) & S_IFMT) == S_IFREG)
#endif
#ifndef S_ISCHR
# define S_ISCHR(m) (((m) & S_IFMT) == S_IFCHR)
#endif
#ifndef S_ISBLK
# define S_ISBLK(m) (((m) & S_IFMT) == S_IFBLK)
#endif
#ifndef S_ISFIFO
# define S_ISFIFO(m) (((m) & S_IFMT) == S_IFIFO)
#endif
#ifndef S_ISLNK
# define S_ISLNK(m) (((m) & S_IFMT) == S_IFLNK)
#endif
extern char **environ;
/* getopt() is in the libc but no header declares it or its variables. */
extern char *optarg;
extern int optind, opterr, optopt;
extern int getopt();
static char *
ostep_strdup(const char *s)
{
    size_t n = strlen(s) + 1;
    char *p = (char *) malloc(n);

    if (p != NULL)
        memcpy(p, s, n);
    return p;
}
static int
ostep_putenv(char *string)
{
    char *eq = strchr(string, '=');
    size_t n, count;
    char **e, **newenv;

    if (eq == 0)
        return -1;
    n = eq - string;
    count = 0;
    for (e = environ; e != 0 && *e != 0; e++) {
        if (strncmp(*e, string, n) == 0 && (*e)[n] == '=') {
            *e = string;
            return 0;
        }
        count++;
    }
    newenv = (char **) malloc((count + 2) * sizeof(char *));
    if (newenv == 0)
        return -1;
    for (count = 0; environ != 0 && environ[count] != 0; count++)
        newenv[count] = environ[count];
    newenv[count++] = string;
    newenv[count] = 0;
    environ = newenv;
    return 0;
}
/* System V sighold()/sigrelse()/sigpause(sig) on top of the BSD signal mask calls
   (BSD sigpause() takes a mask, not a signal). */
extern int sigblock();
extern int sigsetmask();
extern int sigpause();
static int
ostep_sighold(int sig)
{
    sigblock(1 << (sig - 1));
    return 0;
}
static int
ostep_sigrelse(int sig)
{
    sigsetmask(sigblock(0) & ~(1 << (sig - 1)));
    return 0;
}
static int
ostep_sigpause(int sig)
{
    return sigpause(sigblock(0) & ~(1 << (sig - 1)));
}
#define strdup ostep_strdup
#define putenv ostep_putenv
#define sighold ostep_sighold
#define sigrelse ostep_sigrelse
#define sigpause ostep_sigpause
#define fseeko(f, o, w) fseek((f), (long) (o), (w))
#define ftello(f) ((off_t) ftell(f))
#ifndef WEXITSTATUS
# define WEXITSTATUS(s) ((int) (((s) >> 8) & 0xff))
#endif
#ifndef WIFEXITED
# define WIFEXITED(s) (((s) & 0xff) == 0)
#endif
#endif
SEOF
compat=`pwd`/openstep/gnupg-compat.h
# The BSD <sys/wait.h> defines WIFEXITED() and friends for "union wait", not the int
# status that waitpid() and POSIX programs use; redefine them for an int.
/usr/local/bin/mkdir -p openstep/sys
/bin/cat > openstep/sys/wait.h <<'SEOF'
#ifndef OPENSTEP_SYS_WAIT_H
#define OPENSTEP_SYS_WAIT_H
#include_next <sys/wait.h>
#undef WIFEXITED
#undef WEXITSTATUS
#undef WIFSIGNALED
#undef WTERMSIG
#undef WIFSTOPPED
#undef WSTOPSIG
#undef WCOREDUMP
#define WIFEXITED(s) ((((int) (s)) & 0xff) == 0)
#define WEXITSTATUS(s) ((((int) (s)) >> 8) & 0xff)
#define WIFSTOPPED(s) ((((int) (s)) & 0xff) == 0x7f)
#define WSTOPSIG(s) ((((int) (s)) >> 8) & 0xff)
#define WIFSIGNALED(s) ((((int) (s)) & 0xff) != 0 && (((int) (s)) & 0xff) != 0x7f)
#define WTERMSIG(s) (((int) (s)) & 0x7f)
#define WCOREDUMP(s) (((int) (s)) & 0x80)
#ifndef WNOHANG
# define WNOHANG 1
#endif
#ifndef WUNTRACED
# define WUNTRACED 2
#endif
#endif
SEOF

# The compat header is forced in only for the compile, not for configure: its
# function checks declare each function themselves, which clashes with the
# prototypes in the header's includes and makes the checks wrongly fail.
CFLAGS="-O2 -I/usr/local/include $OSTEP_DEFS"
MAKE_CFLAGS="$CFLAGS -I`pwd`/openstep -include $compat -include `pwd`/snprintf-shim.h"
CPPFLAGS=-I/usr/local/include
LDFLAGS=-L/usr/local/lib
# This libc has mmap() but no munmap(); without mmap gpg takes its secure-memory
# pool from malloc() (and warns about insecure memory at start-up unless the
# no-secmem-warning option is set).
ac_cv_func_mmap=no
ac_cv_func_munmap=no
export ac_cv_func_mmap ac_cv_func_munmap
export PATH CC CFLAGS CPPFLAGS LDFLAGS CONFIG_SHELL GREP EGREP AWK SED AR RANLIB
. "$PKG_BUILD_HELPERS"

run_configure \
  --build=$PKG_TARGET \
  --prefix=/usr/local \
  --disable-nls \
  --disable-dependency-tracking \
  --disable-asm \
  --without-readline \
  --disable-keyserver-helpers \
  --disable-dns-srv \
  --disable-agent-support \
  --disable-card-support \
  --disable-photo-viewers \
  --disable-gnupg-iconv \
  --with-zlib=/usr/local \
  --with-bzip2=/usr/local

# The stock sh does not stop a failed sub-make in a loop, so check for the results.
gnumake CFLAGS="$MAKE_CFLAGS"
test -f g10/gpg
test -f g10/gpgv
gnumake install CFLAGS="$MAKE_CFLAGS" DESTDIR="$DESTDIR"
test -x "$DESTDIR$PREFIX/bin/gpg"
test -x "$DESTDIR$PREFIX/bin/gpgv"
