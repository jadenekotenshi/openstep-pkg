#!/bin/sh
set -e
DESTDIR=$1
VERSION=$2
PREFIX=/usr/local
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin
# NetHack 5.0 is C99 (and builds Lua 5.4); gcc 4.2 does it with -std=gnu99.
CC="/usr/local/bin/gcc-4.2 $PKG_GCC42_ARCH_FLAGS -std=gnu99"
AR_CMD="$PKG_AR"
RANLIB_CMD="$PKG_RANLIB"
# On i386 the archives are made by the cctools ar, which keeps long member names;
# the stock linker cannot read them.  A gcc42 built after the cctools package links
# with the cctools ld by itself; an older one needs the specs file selecting it.
if [ "$PKG_ARCH" = i386 ] && [ -f /usr/local/lib/cctools/gcc42.specs ]; then
    CC="$CC -specs=/usr/local/lib/cctools/gcc42.specs"
fi
export PATH CC
if test -d "NetHack-$VERSION"; then cd "NetHack-$VERSION"; fi
. "$PKG_BUILD_HELPERS"

# NetHack's makefiles run Lua's build with a bare "make", which here is the BSD make
# (it rejects the GNU-style arguments).  A directory with "make" linked to gnumake
# goes first in the PATH, so that any such call gets GNU make.
/usr/local/bin/mkdir -p ostep-bin
# NetHack's makefiles run "ar rcs", and the SPARC ar has no "s" option.  This ar
# wrapper drops the "s" and runs ranlib on the archive instead.
/bin/cat > ostep-bin/ar-wrap <<AEOF
#!/bin/sh
op=\$1
shift
case \$op in
*s*) op=\`echo \$op | /bin/sed 's/s//g'\`; idx=1;;
*) idx=;;
esac
$AR_CMD \$op "\$@" || exit 1
if [ -n "\$idx" ]; then
    $RANLIB_CMD "\$1" || exit 1
fi
AEOF
/bin/chmod 755 ostep-bin/ar-wrap
AR_CMD=`pwd`/ostep-bin/ar-wrap
/bin/rm -f ostep-bin/make
/bin/ln -s /bin/gnumake ostep-bin/make
PATH=`pwd`/ostep-bin:$PATH
export PATH

# Lua 5.4.8 comes in lib/lua-5.4.8 (the sources file puts it there); it needs the
# same OPENSTEP fixes as the lua package (wait macros, popen, frexp, strtod).
(cd lib/lua-5.4.8 && patch -p1 < ../../lua-5.4.8-openstep.patch)

# This libc and these headers lack a good deal NetHack 5.0 assumes: <stdint.h>,
# <inttypes.h>, the POSIX <dirent.h>, snprintf() and vsnprintf(), and the wait-status
# macros for an int.  A private include directory supplies them (static code
# renamed by macros, so nothing needs linking and nothing can clash).  The
# directory is not called "openstep": make would take that for a target.
inc=`pwd`/ostep-inc
/usr/local/bin/mkdir -p ostep-inc/sys
/bin/cat > ostep-inc/stdint.h <<'SEOF'
#ifndef OPENSTEP_STDINT_H
#define OPENSTEP_STDINT_H
#include <sys/types.h>
typedef signed char int8_t;
typedef short int16_t;
typedef int int32_t;
typedef long long int64_t;
typedef unsigned char uint8_t;
typedef unsigned short uint16_t;
typedef unsigned int uint32_t;
typedef unsigned long long uint64_t;
typedef long long intmax_t;
typedef unsigned long long uintmax_t;
typedef long intptr_t;
typedef unsigned long uintptr_t;
#define INT8_MAX 127
#define INT16_MAX 32767
#define INT32_MAX 2147483647
#define INT64_MAX 9223372036854775807LL
#define UINT8_MAX 255
#define UINT16_MAX 65535
#define UINT32_MAX 4294967295U
#define UINT64_MAX 18446744073709551615ULL
#define INTMAX_MAX 9223372036854775807LL
#define UINTMAX_MAX 18446744073709551615ULL
#endif
SEOF
/bin/cat > ostep-inc/inttypes.h <<'SEOF'
#ifndef OPENSTEP_INTTYPES_H
#define OPENSTEP_INTTYPES_H
#include <stdint.h>
#define PRId32 "d"
#define PRIu32 "u"
#define PRIx32 "x"
#define PRId64 "lld"
#define PRIu64 "llu"
#define PRIx64 "llx"
#define PRIdMAX "lld"
#define PRIuMAX "llu"
#endif
SEOF
/bin/cat > ostep-inc/dirent.h <<'SEOF'
#ifndef OPENSTEP_DIRENT_H
#define OPENSTEP_DIRENT_H
#include <sys/types.h>
#include <sys/dir.h>
#define dirent direct
#endif
SEOF
echo '/* empty: select() and fd_set come with <sys/types.h> here */' > ostep-inc/sys/select.h
/bin/cat > ostep-inc/sys/wait.h <<'SEOF'
#ifndef OPENSTEP_SYS_WAIT_H
#define OPENSTEP_SYS_WAIT_H
#include_next <sys/wait.h>
#undef WIFEXITED
#undef WEXITSTATUS
#undef WIFSIGNALED
#undef WTERMSIG
#define WIFEXITED(s) ((((int) (s)) & 0xff) == 0)
#define WEXITSTATUS(s) ((((int) (s)) >> 8) & 0xff)
#define WIFSIGNALED(s) ((((int) (s)) & 0xff) != 0 && (((int) (s)) & 0xff) != 0x7f)
#define WTERMSIG(s) (((int) (s)) & 0x7f)
#endif
SEOF
/bin/cat > ostep-inc/nethack5-compat.h <<'SEOF'
#ifndef OPENSTEP_NETHACK5_COMPAT_H
#define OPENSTEP_NETHACK5_COMPAT_H
#include <sys/types.h>
#include <sys/stat.h>
#include <sys/param.h>
#include <fcntl.h>
#include <errno.h>
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#ifndef PATH_MAX
# define PATH_MAX 1024
#endif
#ifndef O_NONBLOCK
# ifdef FNDELAY
#  define O_NONBLOCK FNDELAY
# else
#  define O_NONBLOCK 0x0004
# endif
#endif
#ifndef S_IRUSR
# define S_IRUSR 0000400
# define S_IWUSR 0000200
# define S_IXUSR 0000100
# define S_IRGRP 0000040
# define S_IWGRP 0000020
# define S_IXGRP 0000010
# define S_IROTH 0000004
# define S_IWOTH 0000002
# define S_IXOTH 0000001
#endif
#ifndef S_ISDIR
# define S_ISDIR(m) (((m) & S_IFMT) == S_IFDIR)
#endif
#ifndef S_ISREG
# define S_ISREG(m) (((m) & S_IFMT) == S_IFREG)
#endif
#ifndef ENOSYS
# define ENOSYS 78
#endif
#include <time.h>
extern int wait3();
extern int wait4();
extern char *getwd();
/* getcwd(), waitpid() and the _r time functions are missing from this libc; they are
   static here and renamed by macros, so nothing needs linking.  wait4() with a pid
   of -1 reports ECHILD here, so "any child" goes through wait3(). */
static char *
ostep_getcwd(char *buf, size_t size)
{
    if (buf == 0 || size < MAXPATHLEN) {
        errno = ERANGE;
        return 0;
    }
    return getwd(buf);
}
static int
ostep_waitpid(int pid, int *status, int options)
{
    if (pid == -1)
        return wait3((void *) status, options, (void *) 0);
    return wait4(pid, (void *) status, options, (void *) 0);
}
static struct tm *
ostep_gmtime_r(const time_t *t, struct tm *out)
{
    struct tm *p = gmtime(t);

    if (p == 0)
        return 0;
    *out = *p;
    return out;
}
static struct tm *
ostep_localtime_r(const time_t *t, struct tm *out)
{
    struct tm *p = localtime(t);

    if (p == 0)
        return 0;
    *out = *p;
    return out;
}
#define getcwd ostep_getcwd
#define waitpid ostep_waitpid
#define gmtime_r ostep_gmtime_r
#define localtime_r ostep_localtime_r
#include "snprintf-shim.h"
#endif
SEOF
/bin/cp snprintf-shim.h ostep-inc/snprintf-shim.h

# unixconf.h: this is a BSD system with termcap and without POSIX job control or
# types (the same settings the nethack package uses for 3.6.7).
/bin/sed \
    -e 's|^/\* #define BSD 1 \*/|#define BSD 1|' \
    -e 's|^#define SYSV |#undef SYSV |' \
    -e 's|^#define SVR4 |#undef SVR4 |' \
    -e 's|^#define TERMINFO |#undef TERMINFO |' \
    -e 's|^#define POSIX_JOB_CONTROL |#undef POSIX_JOB_CONTROL |' \
    -e 's|^#define POSIX_TYPES |#undef POSIX_TYPES |' \
    -e 's|^#define memcpy(d, s, n) bcopy(s, d, n)|/* memcpy is a real function here */|' \
    -e 's|^#define memcmp(s1, s2, n) bcmp(s2, s1, n)|/* memcmp is a real function here */|' \
    include/unixconf.h > include/unixconf.h.new
/bin/mv include/unixconf.h.new include/unixconf.h
/bin/grep '^#define BSD 1' include/unixconf.h > /dev/null
/bin/grep '^#undef SYSV' include/unixconf.h > /dev/null
# (The BSD settings rename memcpy and memcmp to bcopy and bcmp, which return void or
# take their arguments the other way round; the code uses the return values.)
if /bin/grep '^#define memcpy' include/unixconf.h > /dev/null; then
    echo "nethack5: unixconf.h still defines memcpy as a macro" >&2
    exit 1
fi

# The hints file for this system.  The game goes in /usr/local/lib/nethack5dir with
# a launcher in /usr/local/bin/nethack5, so it can sit beside the 3.6.7 package.
# There is no games user or group here, so ownership is left alone and the score and
# save files are writable by everyone who can run it.
# SPARC and m68k libc compare bytes as signed in memcmp(), strcmp() and strncmp(); the
# unsigned versions are forced into the game's own code (empty on x86).  The
# optimization level can be changed from the environment (NETHACK5_OPT=-O0 pkg build
# nethack5) to rule out a compiler problem.
CMPFLAGS=`pkg_cmp_shim "\`pwd\`/ostep-cmp"`
OPT=${NETHACK5_OPT--O2}
# The curses window interface is built as well (tty stays the default); it and the tty
# interface use the ncurses package.  NETHACK5_NO_CURSES=1 in the environment leaves it
# out and uses termcap for the tty interface alone.
if test "${NETHACK5_NO_CURSES-}" = 1; then
    cur_cflags=
    cur_src=
    cur_obj=
    cur_lib=
    tty_lib=-ltermcap
else
    cur_cflags="-I/usr/local/include/ncurses -DCURSES_GRAPHICS"
    cur_src=' $(WINCURSESSRC)'
    cur_obj=' $(WINCURSESOBJ)'
    cur_lib=' $(WINCURSESLIB)'
    tty_lib="-L/usr/local/lib -lncurses"
fi
hints=sys/unix/hints/openstep.500
/bin/cat > "$hints" <<HEOF
#-PRE
# OPENSTEP hints (generated by the pkg build script)
PREFIX=/usr/local
HACKDIR=\$(PREFIX)/lib/\$(GAME)dir
INSTDIR=\$(DESTDIR)\$(HACKDIR)
VARDIR=\$(DESTDIR)\$(HACKDIR)
SHELLDIR=\$(DESTDIR)\$(PREFIX)/bin

CFLAGS=$OPT -I../include -I$inc -DNeXT -include $inc/nethack5-compat.h $CMPFLAGS
# gcc 4.2 does not allow #pragma GCC diagnostic inside a function, which the
# warning-suppression macros use; this makes them no-ops.
CFLAGS+=-DDISABLE_WARNING_PRAGMAS
# There is no <term.h> or curses here, only the termcap functions (-ltermcap):
# wintty.h declares them itself with this.
CFLAGS+=-DNO_TERMCAP_HEADERS
CFLAGS+=$cur_cflags
# (extra compiler flags for debugging, e.g. NETHACK5_CFLAGS=-DMONITOR_HEAP)
CFLAGS+=${NETHACK5_CFLAGS-}
CFLAGS+=-DCOMPRESS=\\"/usr/local/bin/gzip\\" -DCOMPRESS_EXTENSION=\\".gz\\"
CFLAGS+=-DHACKDIR=\\"\$(HACKDIR)\\"
SYSCFLAGS=-DNeXT
LINK=\$(CC)

WINSRC = \$(WINTTYSRC)$cur_src
WINOBJ = \$(WINTTYOBJ)$cur_obj
WINLIB = \$(WINTTYLIB)$cur_lib
WINTTYLIB = $tty_lib

# No <regex.h> here: NetHack's own pattern matcher.
REGEXOBJ = \$(TARGETPFX)pmatchregex.o

CHOWN=true
CHGRP=true
ROOTCHECK=true
DIRPERM = 0755
FILEPERM = 0644
EXEPERM = 0755
GAMEPERM = 0755
VARDIRPERM = 0777
VARFILEPERM = 0666
HEOF

# GNU make 3.81 (the system's gnumake) cannot read the target-specific variables of
# the fetch-lua-mirror and fetch-lua-nhd targets in Makefile.top ("target pattern
# contains no %").  They only choose where to download Lua from, which this package
# does not do (the sources file stages it), so comment those two lines out.
/bin/sed -e 's/^\(fetch-lua-mirror: LUA_URL_list\)/#\1/' -e 's/^\(fetch-lua-nhd: LUA_URL_list\)/#\1/' \
    sys/unix/Makefile.top > sys/unix/Makefile.top.new
/bin/mv sys/unix/Makefile.top.new sys/unix/Makefile.top
/bin/grep '^#fetch-lua-mirror: LUA_URL_list' sys/unix/Makefile.top > /dev/null
/bin/grep '^#fetch-lua-nhd: LUA_URL_list' sys/unix/Makefile.top > /dev/null

/bin/sh sys/unix/setup.sh "$hints"
# The ncurses link is in WINTTYLIB; the makefile's own curses library name is dropped.
/bin/sed -e 's/^WINCURSESLIB *=.*/WINCURSESLIB =/' src/Makefile > src/Makefile.new
/bin/mv src/Makefile.new src/Makefile
if test "${NETHACK5_NO_CURSES-}" != 1; then
    /bin/grep '^WINCURSESSRC' src/Makefile > /dev/null || {
        echo "nethack5: this makefile has no curses interface; set NETHACK5_NO_CURSES=1" >&2
        exit 1
    }
fi

# Build and install; "make all" would also format the Guidebook with nroff.
# GAME names the binary and the data directory.  The archives Lua is put in are made
# by the same ar and ranlib as the rest.  Lua is built without LUA_USE_POSIX (it
# would use gmtime_r, localtime_r and mkstemp, which this libc lacks) and without the private include
# directory: its patch reads wait status as a "union wait", which the private
# <sys/wait.h> (an int status, for NetHack) would contradict.
luaflags="CC='$CC' SYSCFLAGS='-DNeXT' AR='$AR_CMD rcu' RANLIB='$RANLIB_CMD'"
/bin/gnumake CC="$CC" AR="$AR_CMD" RANLIB="$RANLIB_CMD" GAME=nethack5 \
    LUAMAKEFLAGS="$luaflags" install DESTDIR="$DESTDIR"

# This build uses a system configuration file and the game refuses to start without
# one: install the stock sysconf.
gamedir="$DESTDIR$PREFIX/lib/nethack5dir"
/bin/cp sys/unix/sysconf "$gamedir/sysconf"
/bin/chmod 644 "$gamedir/sysconf"

# Replace the stock launcher (it uses shell features the system sh lacks).
/bin/cat > "$DESTDIR$PREFIX/bin/nethack5" <<'LEOF'
#!/bin/sh
HACKDIR=/usr/local/lib/nethack5dir
export HACKDIR
cd $HACKDIR
exec $HACKDIR/nethack5 ${1+"$@"}
LEOF
/bin/chmod 755 "$DESTDIR$PREFIX/bin/nethack5"

test -x "$gamedir/nethack5"
test -f "$gamedir/data"
test -f "$gamedir/Arc-strt.lua"
test -f "$gamedir/sysconf"
