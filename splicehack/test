#!/bin/sh
set -e

HACKDIR=$LOCAL_ROOT/lib/splicehackdir
export HACKDIR

test -x "$HACKDIR/splicehack"
test -f "$HACKDIR/nhdat"
test -f "$HACKDIR/sysconf"
test -x "$LOCAL_ROOT/bin/splicehack"
cd "$HACKDIR"
./splicehack --version | /usr/local/bin/grep 'NetHack Version 1.2' > /dev/null
echo "splicehack ok"
