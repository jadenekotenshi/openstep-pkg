#!/bin/sh
# shellcheck disable=SC2006

set -e

die() {
    echo "error: $*" >&2
    exit 1
}

log() {
    echo "==> $*"
}

trace_enabled() {
    case $PKG_XTRACE in
        1|yes|true|on)
            return 0
        ;;
    esac

    return 1
}

# Work out which OPENSTEP architecture we are running on and export it, along
# with the default compiler flags for it.  arch(1) prints i386, sparc, m68k or
# hppa; when it is missing, assume i386 as pkg always has.  An architecture
# pkg does not know is passed through with no default flags.
detect_arch() {
    arch_raw=${PKG_ARCH:-`/usr/bin/arch 2>/dev/null`}

    case $arch_raw in
        ""|i[3-9]86|i386*)  PKG_ARCH=i386 ;;
        sparc*)             PKG_ARCH=sparc ;;
        m68*)               PKG_ARCH=m68k ;;
        hppa*)              PKG_ARCH=hppa ;;
        *)                  PKG_ARCH=$arch_raw ;;
    esac

    PKG_TARGET=$PKG_ARCH-next-openstep4

    case $PKG_ARCH in
        i386)
            arch_syscc=-m486
            arch_gcc42=-march=i486
        ;;
        sparc)
            # gcc-4.2 is configured for V8 (sun4m), so it needs no flag.
            arch_syscc=-mv8
            arch_gcc42=
        ;;
        *)
            arch_syscc=
            arch_gcc42=
        ;;
    esac

    PKG_SYSCC_ARCH_FLAGS=${PKG_SYSCC_ARCH_FLAGS-$arch_syscc}
    PKG_GCC42_ARCH_FLAGS=${PKG_GCC42_ARCH_FLAGS-$arch_gcc42}

    export PKG_ARCH PKG_TARGET PKG_SYSCC_ARCH_FLAGS PKG_GCC42_ARCH_FLAGS
}

# Site configuration lives outside the package tree, in a plain sh file of
# VAR=value lines: $PKG_CONF, else $PKG_ROOT/usr/local/etc/pkg.conf.  Every
# option has a default, so the file is optional.  The options are exported to
# build, test, post-install and pre-remove.
load_config() {
    conf_file=$PKG_CONF
    if [ "x$conf_file" = x ]; then
        conf_file=$PKG_ROOT/usr/local/etc/pkg.conf
    fi
    PKG_CONF_FILE=$conf_file

    # HAVE_X11: 1 when an X11 server (CubXWindow or similar) and its
    # development headers and libraries are installed, else 0.
    HAVE_X11=${HAVE_X11-0}

    # X11_PREFIX: directory holding the X11 include/ and lib/ (CubXWindow
    # installs under /usr/X11R6).
    X11_PREFIX=${X11_PREFIX-/usr/X11R6}

    # WITH_PYTHON: 1 to build packages' optional Python support (git-p4 in git)
    # against the python311 package, 0 to leave it out.
    WITH_PYTHON=${WITH_PYTHON-1}

    if [ -f "$conf_file" ]; then
        . "$conf_file"
    fi

    case $HAVE_X11 in
        0|1)
        ;;
        *)
            die "$conf_file: HAVE_X11 must be 0 or 1, not '$HAVE_X11'"
        ;;
    esac

    case $WITH_PYTHON in
        0|1)
        ;;
        *)
            die "$conf_file: WITH_PYTHON must be 0 or 1, not '$WITH_PYTHON'"
        ;;
    esac

    export PKG_CONF_FILE HAVE_X11 X11_PREFIX WITH_PYTHON
}

# A package's optional `requires` file names the pkg.conf options it needs:
#   HAVE_X11     required; build and install are refused when it is not 1
#   ?HAVE_X11    optional; the build script enables extra features when it is 1
# Comments (#) and blank lines are allowed.
option_value() {
    case $1 in
        HAVE_X11)
            echo "$HAVE_X11"
        ;;
        WITH_PYTHON)
            echo "$WITH_PYTHON"
        ;;
        *)
            return 1
        ;;
    esac
}

# Print "required" or "optional" lines for each entry in DIR/requires, as
# "<kind> <option>"; dies on an unknown option.
read_requires() {
    rr_file=$1/requires
    rr_pkg=$2

    [ -f "$rr_file" ] || return 0

    while read rr_entry rr_extra || [ -n "$rr_entry" ]; do
        case $rr_entry in
            ''|\#*)
                continue
            ;;
            \?*)
                rr_kind=optional
                rr_opt=`echo "$rr_entry" | sed 's/^?//'`
            ;;
            *)
                rr_kind=required
                rr_opt=$rr_entry
            ;;
        esac

        option_value "$rr_opt" > /dev/null ||
            die "unknown option in $rr_pkg requires: $rr_entry"
        echo "$rr_kind $rr_opt"
    done < "$rr_file"
}

# Check the requires files of a package and everything it would pull in via
# depends, before anything is built.  Dependencies that are already installed
# are skipped.
check_requires_tree() {
    rq_top=$1
    rq_root=`path_parent "$rq_top"`
    rq_todo=$rq_top
    rq_seen=:
    rq_bad=

    while [ -n "$rq_todo" ]; do
        set -- $rq_todo
        rq_cur=$1
        shift
        rq_todo="$*"

        rq_name=`path_leaf "$rq_cur"`
        case $rq_seen in
            *:$rq_name:*)
                continue
            ;;
        esac
        rq_seen=$rq_seen$rq_name:

        rq_list=`read_requires "$rq_cur" "$rq_name"` || exit 1
        while read rq_kind rq_opt; do
            [ "x$rq_kind" = xrequired ] || continue
            rq_val=`option_value "$rq_opt"`
            if [ "x$rq_val" != x1 ]; then
                rq_bad="$rq_bad
  $rq_name needs $rq_opt=1"
            fi
        done <<EOF
$rq_list
EOF

        [ -f "$rq_cur/depends" ] || continue

        while read rq_dep rq_extra || [ -n "$rq_dep" ]; do
            rq_dep=`dep_resolve "$rq_dep"` || exit 1
            case $rq_dep in
                ''|\#*|!*)
                    continue
                ;;
            esac
            [ -d "$DB_ROOT/installed/$rq_dep" ] && continue
            for rq_cand in "$rq_root/$rq_dep" "$rq_dep"
            do
                if [ -d "$rq_cand" ]; then
                    rq_todo="$rq_todo $rq_cand"
                    break
                fi
            done
        done < "$rq_cur/depends"
    done

    if [ -n "$rq_bad" ]; then
        die "cannot build $PKG_NAME with the current configuration ($PKG_CONF_FILE):$rq_bad"
    fi
}

# Tell the person which optional features this build will use.
log_optional_features() {
    rq_list=`read_requires "$PKG_DIR" "$PKG_NAME"` || exit 1
    while read rq_kind rq_opt; do
        [ "x$rq_kind" = xoptional ] || continue
        rq_val=`option_value "$rq_opt"`
        if [ "x$rq_val" = x1 ]; then
            log "optional feature $rq_opt: enabled"
        else
            log "optional feature $rq_opt: disabled"
        fi
    done <<EOF
$rq_list
EOF
}

# Record the optional options this build saw, so a later change to pkg.conf can
# be noticed ("built without HAVE_X11; reinstall to enable").
write_features() {
    rq_list=`read_requires "$PKG_DIR" "$PKG_NAME"` || exit 1
    rm -f "$INST_DIR/features"
    while read rq_kind rq_opt; do
        [ "x$rq_kind" = xoptional ] || continue
        rq_val=`option_value "$rq_opt"`
        echo "$rq_opt=$rq_val" >> "$INST_DIR/features"
    done <<EOF
$rq_list
EOF
}

# Print the optional options whose value now differs from the recorded build.
stale_features() {
    sf_dir=$1
    [ -f "$sf_dir/features" ] || return 0
    while read sf_line; do
        sf_opt=`echo "$sf_line" | sed 's/=.*//'`
        sf_old=`echo "$sf_line" | sed 's/.*=//'`
        sf_now=`option_value "$sf_opt"` || continue
        if [ "x$sf_now" != "x$sf_old" ]; then
            echo "$sf_opt (built with $sf_old, now $sf_now)"
        fi
    done < "$sf_dir/features"
}

usage() {
    cat <<'EOF'
usage:
  pkg download <package-dir>
  pkg build <package-dir>
  pkg install <package-dir>...
  pkg list
  pkg remove <name>
  pkg test <name>...
  pkg arch
  pkg config

configuration:
  pkg reads options from /usr/local/etc/pkg.conf (override with PKG_CONF; under
  PKG_ROOT when that is set).  The file is optional, plain sh VAR=value lines.
  See pkg.conf.example.  Options are exported to build, test, post-install and
  pre-remove.
    HAVE_X11   1 if an X11 server (CubXWindow or similar) and its development
               headers are installed; default 0
    X11_PREFIX directory holding the X11 include/ and lib/; default /usr/X11R6
               (where CubXWindow installs)
    WITH_PYTHON 1 (default) builds optional Python support (git-p4 in git) and
               depends on python311; 0 leaves it out

architecture:
  pkg detects the machine with arch(1) (override with PKG_ARCH=i386|sparc|m68k|hppa)
  and exports these to build, test, post-install and pre-remove:
    PKG_ARCH               i386, sparc, m68k or hppa
    PKG_TARGET             <arch>-next-openstep4, for configure --build/--host
    PKG_SYSCC_ARCH_FLAGS   default flags for the system /bin/cc (i386 -m486, sparc -mv8)
    PKG_GCC42_ARCH_FLAGS   default flags for gcc-4.2 (i386 -march=i486, sparc none:
                           V8 is its default)
  Set either *_FLAGS variable (even to empty) to override it.

package layout:
  build         required build script
  version       required, contains version
  depends       optional, one package name per line (?OPTION:name = only when OPTION is 1)
  requires      optional, pkg.conf options: HAVE_X11 (needed) or ?HAVE_X11 (extra features)
  sources       optional, one source per line
  post-install  optional shell hook
  pre-remove    optional shell hook
  test          optional installed-package test hook
EOF
}

# A depends entry may be conditional on a pkg.conf option: "?HAVE_X11:neXtaw"
# is a dependency on neXtaw only when HAVE_X11 is 1 (and is ignored otherwise).
# Print the entry to act on: the plain entry, or nothing when it is inactive.
dep_resolve() {
    dr_entry=$1

    case $dr_entry in
        \?*:*)
            dr_opt=`echo "$dr_entry" | sed 's/^?//; s/:.*//'`
            dr_rest=`echo "$dr_entry" | sed 's/^[^:]*://'`
            dr_val=`option_value "$dr_opt"` ||
                die "unknown option in depends entry: $dr_entry"
            if [ "x$dr_val" = x1 ]; then
                echo "$dr_rest"
            fi
        ;;
        *)
            echo "$dr_entry"
        ;;
    esac
}

dep_name() {
    case $1 in
        !*)
            echo "$1" | sed 's/^!//'
        ;;
        *)
            echo "$1"
        ;;
    esac
}

dep_is_negative() {
    case $1 in
        !*)
            return 0
        ;;
    esac

    return 1
}

require_file() {
    [ -f "$1" ] || die "missing file: $1"
}

default_value() {
    if [ "x$1" = x ]; then
        echo "$2"
    else
        echo "$1"
    fi
}

path_leaf() {
    echo "$1" | sed 's#/$##; s#.*/##'
}

path_parent() {
    case $1 in
        */*)
            echo "$1" | sed 's#/$##; s#/[^/]*$##'
        ;;
        *)
            echo .
        ;;
    esac
}

strip_leading_slash() {
    echo "$1" | sed 's#^/##'
}

ensure_dir() {
    dir=$1

    [ -d "$dir" ] && return 0

    case $dir in
        /*) current=/ ;;
         *) current=. ;;
    esac

    old_ifs=$IFS
    IFS=/
    set -- $dir
    IFS=$old_ifs

    for part
    do
        [ -n "$part" ] || continue

        if [ "$current" = / ]; then
            current=/$part
        else
            current=$current/$part
        fi

        [ -d "$current" ] || mkdir "$current" 2>/dev/null || [ -d "$current" ]
    done
}

trim_slash() {
    case $1 in
        /) echo / ;;
        */) echo "$1" | sed 's#/$##' ;;
        *) echo "$1" ;;
    esac
}

root_join() {
    rel=`strip_leading_slash "$1"`

    if [ "$ROOT_DIR" = / ]; then
        echo "/$rel"
    else
        echo "$ROOT_DIR/$rel"
    fi
}

find_tool() {
    tool=$1

    old_ifs=$IFS
    IFS=:
    set -- $PATH
    IFS=$old_ifs

    for dir
    do
        [ -n "$dir" ] || dir=.

        if [ -x "$dir/$tool" ]; then
            echo "$dir/$tool"
            return 0
        fi
    done

    return 1
}

is_bootstrap_pkg() {
    case $1 in
        pdksh)
            return 0
        ;;
    esac

    return 1
}

requires_pdksh_sh() {
    is_bootstrap_pkg "$1" && return 1

    return 0
}

build_shell_path() {
    # PKG_BUILD_SHELL overrides the shell for every build and test script, for
    # when pdksh trips over a package (e.g. PKG_BUILD_SHELL=/usr/local/bin/bash).
    if [ -n "${PKG_BUILD_SHELL-}" ]; then
        echo "$PKG_BUILD_SHELL"
    elif requires_pdksh_sh "$1"; then
        echo /usr/local/bin/ksh
    else
        echo /bin/sh
    fi
}

check_build_shell() {
    build_shell=`build_shell_path "$PKG_NAME"`

    if [ -x "$build_shell" ]; then
        return 0
    fi

    if [ "$build_shell" = /usr/local/bin/ksh ]; then
        parent_pkg_dir=$PKG_DIR
        parent_pkg_name=$PKG_NAME

        case :$PKG_INSTALL_STACK: in
            *:pdksh:*)
                die "required build shell pdksh is unavailable while already in the install stack for $parent_pkg_name"
            ;;
        esac

        pdksh_pkg_dir=`resolve_dep_pkg_dir pdksh` ||
            die "missing required build shell for $parent_pkg_name: $build_shell (and could not locate local pdksh package)"

        log "installing required build shell pdksh for $parent_pkg_name"
        ( install_pkg "$pdksh_pkg_dir" ) < /dev/null
        load_pkg "$parent_pkg_dir"

        build_shell=`build_shell_path "$PKG_NAME"`
    fi

    [ -x "$build_shell" ] || die "missing required build shell for $PKG_NAME: $build_shell"
}

load_pkg() {
    PKG_DIR=$1
    [ -d "$PKG_DIR" ] || die "package directory not found: $PKG_DIR"

    PKG_DIR=`cd "$PKG_DIR" && pwd`
    PKG_NAME=`path_leaf "$PKG_DIR"`

    require_file "$PKG_DIR/build"
    require_file "$PKG_DIR/version"

    read PKG_VERSION PKG_VERSION_EXTRA < "$PKG_DIR/version" ||
        die "failed to read version file"

    [ -n "$PKG_VERSION" ] || die "version file did not contain a version"
    [ -z "$PKG_VERSION_EXTRA" ] || die "version file must contain exactly one field"

    ROOT_DIR=`default_value "$PKG_ROOT" "/"`
    ROOT_DIR=`trim_slash "$ROOT_DIR"`
    LOCAL_ROOT=$ROOT_DIR/usr/local
    CACHE_ROOT=`default_value "$PKG_CACHE" "$LOCAL_ROOT/var/pkg/cache"`
    DB_ROOT=`default_value "$PKG_DB" "$LOCAL_ROOT/var/pkg/db"`

    SRC_CACHE=$CACHE_ROOT/sources/$PKG_NAME
    BUILD_ROOT=$CACHE_ROOT/build/$PKG_NAME
    IMAGE_DIR=$CACHE_ROOT/pkg/$PKG_NAME
    INST_DIR=$DB_ROOT/installed/$PKG_NAME
}

download_one() {
    src=$1
    dest=$2

    case $src in
        \#*|'')
            return 0
        ;;
    esac

    case $src in
        *://*)
            src_name=`path_leaf "$src"`
            dest_name=`default_value "$dest" "$src_name"`
            ensure_dir "$SRC_CACHE/`path_parent "$dest_name"`"
            out=$SRC_CACHE/$dest_name

            if [ -f "$out" ]; then
                log "using cached $src_name"
                return 0
            fi

            log "downloading $src"

            curl_path=`find_tool curl 2>/dev/null`
            if [ -n "$curl_path" ]; then
                "$curl_path" -L -o "$out" "$src"
                return 0
            fi

            wget_path=`find_tool wget 2>/dev/null`
            if [ -n "$wget_path" ]; then
                "$wget_path" -O "$out" "$src"
                return 0
            fi

            die "need curl or wget to download sources"
        ;;
    esac
}

download_pkg() {
    ensure_dir "$SRC_CACHE"

    [ -f "$PKG_DIR/sources" ] || return 0

    log "resolving sources for $PKG_NAME"

    while read src dest || [ -n "$src" ]; do
        download_one "$src" "$dest"
    done < "$PKG_DIR/sources"
}

copy_local_source() {
    src=$1
    dest=$2

    case $src in
        /*) path=$src ;;
        *) path=$PKG_DIR/$src ;;
    esac

    [ -f "$path" ] || [ -d "$path" ] || die "local source not found: $src"

    build_dest=`default_value "$dest" ""`
    target_dir=$BUILD_ROOT

    if [ -n "$build_dest" ]; then
        target_dir=$BUILD_ROOT/$build_dest
    fi

    ensure_dir "$target_dir"

    if [ -d "$path" ]; then
        (
            cd "$path"
            tar cf - .
        ) | (
            cd "$target_dir"
            tar xpf -
        )
    else
        case $path in
            *.tar.gz|*.tgz|*.tar|*.tar.bz2|*.tbz2|*.tar.xz|*.txz|*.tar.zst|*.tzst)
                extract_archive "$path" "$dest"
            ;;
            *)
                cp "$path" "$target_dir/"
            ;;
        esac
    fi
}

# The system gnutar cannot read tarballs written by current tar (extended
# headers, long names).  Use GNU tar from the "tar" package (installed as
# gtar) when it is there; packages whose sources need it depend on "tar".
archive_tar() {
    for at_dir in "$ROOT_DIR/usr/local/bin" /usr/local/bin; do
        if [ -x "$at_dir/gtar" ]; then
            echo "$at_dir/gtar"
            return 0
        fi
    done
    echo gnutar
}

# archive_tool NAME PACKAGE
# Print the path of a decompressor installed by PACKAGE, or fail.
archive_tool() {
    for at_dir in "$ROOT_DIR/usr/local/bin" /usr/local/bin; do
        if [ -x "$at_dir/$1" ]; then
            echo "$at_dir/$1"
            return 0
        fi
    done
    return 1
}

# unpack_compressed ARCHIVE TARGET-DIR TOOL PACKAGE
# Decompress ARCHIVE with TOOL (xz, zstd or bzip2) to a temporary tar file, then
# unpack that with archive_tar.  Two steps rather than a pipe, so that a
# failing decompressor is noticed.
unpack_compressed() {
    uc_archive=$1
    uc_target=$2
    uc_tool=$3
    uc_pkg=$4

    uc_path=`archive_tool "$uc_tool"` ||
        die "$uc_archive needs $uc_tool; install the $uc_pkg package"
    uc_tar=${TMPDIR:-/tmp}/pkg-unpack.$$.tar
    rm -f "$uc_tar"
    if "$uc_path" -dc "$uc_archive" > "$uc_tar"; then
        if `archive_tar` -xf "$uc_tar" -C "$uc_target"; then
            rm -f "$uc_tar"
            return 0
        fi
    fi
    rm -f "$uc_tar"
    die "cannot unpack $uc_archive"
}

extract_archive() {
    archive=$1
    dest=$2

    build_dest=`default_value "$dest" ""`
    target_dir=$BUILD_ROOT

    if [ -n "$build_dest" ]; then
        target_dir=$BUILD_ROOT/$build_dest
    fi

    ensure_dir "$target_dir"

    case $archive in
        *.tar.gz|*.tgz)
            `archive_tar` -xzf "$archive" -C "$target_dir"
        ;;
        *.tar)
            `archive_tar` -xf "$archive" -C "$target_dir"
        ;;
        *.tar.xz|*.txz)
            unpack_compressed "$archive" "$target_dir" xz xz
        ;;
        *.tar.zst|*.tzst)
            unpack_compressed "$archive" "$target_dir" zstd zstd
        ;;
        *.tar.bz2|*.tbz2)
            unpack_compressed "$archive" "$target_dir" bzip2 bzip2
        ;;
        *)
            cp "$archive" "$target_dir/"
        ;;
    esac
}

stage_source() {
    src=$1
    dest=$2

    case $src in
        \#*|'')
            return 0
        ;;
        *://*)
            src_name=`path_leaf "$src"`
            dest_name=`default_value "$dest" "$src_name"`
            extract_archive "$SRC_CACHE/$dest_name" "$dest"
        ;;
        *)
            copy_local_source "$src" "$dest"
        ;;
    esac
}

prepare_build_root() {
    # PKG_RESUME=1 keeps the build tree of an earlier, failed run (sources
    # already extracted, patched and configured, objects already built) instead
    # of starting over; the package's build script skips the steps it has
    # already completed (see pkg_step and pkg_apply_patch in build-helpers.sh).
    resume_build=
    if [ -n "${PKG_RESUME-}" ] && [ -d "$BUILD_ROOT" ]; then
        resume_build=1
    fi

    if [ -n "$resume_build" ]; then
        log "resuming build in $BUILD_ROOT"
        rm -rf "$IMAGE_DIR"
    else
        log "preparing build root $BUILD_ROOT"
        rm -rf "$BUILD_ROOT" "$IMAGE_DIR"
        ensure_dir "$BUILD_ROOT"
    fi
    ensure_dir "$IMAGE_DIR"

    if [ -z "$resume_build" ] && [ -f "$PKG_DIR/sources" ]; then
        while read src dest || [ -n "$src" ]; do
            case $src in
                ''|\#*)
                    :
                ;;
                *)
                    log "staging source $src"
                ;;
            esac
            stage_source "$src" "$dest"
        done < "$PKG_DIR/sources"
    fi

    set -- $BUILD_ROOT/*

    if [ "$1" != "$BUILD_ROOT/*" ] && [ $# -eq 1 ] && [ -d "$1" ]; then
        BUILD_CWD=$1
    else
        BUILD_CWD=$BUILD_ROOT
    fi
}

run_build() {
    build_shell=`build_shell_path "$PKG_NAME"`
    build_trace_flag=
    check_build_shell
    check_depends
    download_pkg
    prepare_build_root

    log "building $PKG_NAME $PKG_VERSION"
    log_optional_features
    log "build directory $BUILD_CWD"
    log "image directory $IMAGE_DIR"
    log "build shell $build_shell"

    if trace_enabled; then
        log "running build script with shell trace"
        build_trace_flag=-x
    fi

    (
        cd "$BUILD_CWD"
        DESTDIR=$IMAGE_DIR \
        PKG_BUILD_HELPERS=$PKG_DIR/../build-helpers.sh \
        "$build_shell" $build_trace_flag "$PKG_DIR/build" "$IMAGE_DIR" "$PKG_VERSION"
    )

    clean_work_cache
}

copy_tree() {
    src=$1
    dst=$2

    ensure_dir "$dst"

    (
        cd "$src"
        tar cf - .
    ) | (
        cd "$dst"
        tar xpf -
    )
}

dir_writable() {
    probe=$1/.pkg-write-test-$$

    if mkdir "$probe" 2>/dev/null; then
        rmdir "$probe" 2>/dev/null || :
        return 0
    fi

    return 1
}

find_existing_dir() {
    dir=$1

    while :
    do
        if [ -d "$dir" ]; then
            echo "$dir"
            return 0
        fi

        parent=`path_parent "$dir"`

        if [ "$parent" = "$dir" ]; then
            break
        fi

        dir=$parent
    done

    return 1
}

check_depends() {
    dep_file=$PKG_DIR/depends

    [ -f "$dep_file" ] || return 0

    if is_bootstrap_pkg "$PKG_NAME"; then
        die "$PKG_NAME is a bootstrap package and must not declare dependencies"
    fi

    missing=
    conflicts=

    while read dep extra || [ -n "$dep" ]; do
        dep=`dep_resolve "$dep"` || exit 1
        case $dep in
            ''|\#*)
                continue
            ;;
        esac

        dep_pkg=`dep_name "$dep"`
        [ -n "$dep_pkg" ] || die "invalid dependency entry for $PKG_NAME: $dep"

        if dep_is_negative "$dep"; then
            if [ -d "$DB_ROOT/installed/$dep_pkg" ]; then
                if [ -n "$conflicts" ]; then
                    conflicts="$conflicts $dep_pkg"
                else
                    conflicts=$dep_pkg
                fi
            fi
        else
            if [ ! -d "$DB_ROOT/installed/$dep_pkg" ]; then
                if [ -n "$missing" ]; then
                    missing="$missing $dep_pkg"
                else
                    missing=$dep_pkg
                fi
            fi
        fi
    done < "$dep_file"

    if [ -n "$missing" ]; then
        die "missing dependencies for $PKG_NAME:$missing"
    fi

    if [ -n "$conflicts" ]; then
        die "conflicting installed packages for $PKG_NAME:$conflicts"
    fi
}

resolve_dep_pkg_dir() {
    dep=$1
    pkg_root=`path_parent "$PKG_DIR"`

    for candidate in "$pkg_root/$dep" "$dep"
    do
        if [ -d "$candidate" ]; then
            (
                cd "$candidate"
                pwd
            )
            return 0
        fi
    done

    return 1
}

install_depends() {
    dep_file=$PKG_DIR/depends

    [ -f "$dep_file" ] || return 0

    if is_bootstrap_pkg "$PKG_NAME"; then
        die "$PKG_NAME is a bootstrap package and must not declare dependencies"
    fi

    parent_pkg_dir=$PKG_DIR
    parent_pkg_name=$PKG_NAME

    while read dep extra || [ -n "$dep" ]; do
        dep=`dep_resolve "$dep"` || exit 1
        case $dep in
            ''|\#*)
                continue
            ;;
        esac

        dep_pkg=`dep_name "$dep"`
        [ -n "$dep_pkg" ] || die "invalid dependency entry for $parent_pkg_name: $dep"

        if dep_is_negative "$dep"; then
            if [ -d "$DB_ROOT/installed/$dep_pkg" ]; then
                die "conflicting installed package for $parent_pkg_name: $dep_pkg"
            fi
            continue
        fi

        if [ -d "$DB_ROOT/installed/$dep_pkg" ]; then
            log "dependency already installed: $dep_pkg"
            continue
        fi

        dep_dir=`resolve_dep_pkg_dir "$dep_pkg"` ||
            die "could not locate dependency package directory for $parent_pkg_name: $dep_pkg"

        case :$PKG_INSTALL_STACK: in
            *:$dep_pkg:*)
                die "dependency cycle detected while installing $parent_pkg_name: $dep_pkg"
            ;;
        esac

        log "installing dependency $dep_pkg for $parent_pkg_name"
        ( install_pkg "$dep_dir" ) < /dev/null
        load_pkg "$parent_pkg_dir"
    done < "$dep_file"
}

install_preflight() {
    (
        cd "$IMAGE_DIR"
        find . ! -name . -print | sed 's#^\./##' | sort
    ) | while read rel; do
        [ -n "$rel" ] || continue

        staged=$IMAGE_DIR/$rel
        target=`root_join "$rel"`

        if [ -d "$staged" ]; then
            if [ -d "$target" ]; then
                :
            else
                parent=`path_parent "$target"`
                existing=`find_existing_dir "$parent"` ||
                    die "could not find existing parent directory for: $target"
                dir_writable "$existing" || die "install target parent not writable: $existing"
            fi
        else
            parent=`path_parent "$target"`
            existing=`find_existing_dir "$parent"` ||
                die "could not find existing parent directory for: $target"
            dir_writable "$existing" || die "install target parent not writable: $existing"
        fi
    done
}

log_install_contents() {
    log "staged install contents:"

    (
        cd "$IMAGE_DIR"
        find . ! -name . -print | sed 's#^\./#/#' | sort
    ) | while read rel; do
        echo "  $rel"
    done
}

write_manifest() {
    ensure_dir "$INST_DIR"

    (
        cd "$IMAGE_DIR"
        find . ! -name . -print | sed 's#^\./#/#' | sort
    ) > "$INST_DIR/manifest"

    echo "$PKG_VERSION" > "$INST_DIR/version"
    write_features

    for hook in pre-remove post-install test; do
        if [ -f "$PKG_DIR/$hook" ]; then
            cp "$PKG_DIR/$hook" "$INST_DIR/$hook"
            chmod +x "$INST_DIR/$hook" 2>/dev/null || :
        else
            rm -f "$INST_DIR/$hook"
        fi
    done
}

clean_image_cache() {
    if [ -d "$IMAGE_DIR" ]; then
        log "cleaning staged image $IMAGE_DIR"
        rm -rf "$IMAGE_DIR"
    fi
}

clean_source_cache() {
    if [ -d "$SRC_CACHE" ]; then
        log "cleaning source cache $SRC_CACHE"
        rm -rf "$SRC_CACHE"
    fi
}

clean_build_cache() {
    if [ -d "$BUILD_ROOT" ]; then
        log "cleaning build root $BUILD_ROOT"
        rm -rf "$BUILD_ROOT"
    fi
}

clean_work_cache() {
    clean_source_cache
    clean_build_cache
}

installed_same_version() {
    [ -f "$INST_DIR/version" ] || return 1

    read installed_version installed_version_extra < "$INST_DIR/version" ||
        return 1

    [ "x$installed_version" = "x$PKG_VERSION" ] && [ -z "$installed_version_extra" ]
}

restore_install_context() {
    PKG_INSTALL_STACK=$saved_install_stack
    PKG_DIR=$saved_pkg_dir
    PKG_NAME=$saved_pkg_name
    PKG_VERSION=$saved_pkg_version
    ROOT_DIR=$saved_root_dir
    LOCAL_ROOT=$saved_local_root
    CACHE_ROOT=$saved_cache_root
    DB_ROOT=$saved_db_root
    SRC_CACHE=$saved_src_cache
    BUILD_ROOT=$saved_build_root
    IMAGE_DIR=$saved_image_dir
    INST_DIR=$saved_inst_dir
    BUILD_CWD=$saved_build_cwd
    export PKG_INSTALL_STACK
}

install_pkg() {
    pkg_arg=$1
    saved_install_stack=$PKG_INSTALL_STACK
    saved_pkg_dir=$PKG_DIR
    saved_pkg_name=$PKG_NAME
    saved_pkg_version=$PKG_VERSION
    saved_root_dir=$ROOT_DIR
    saved_local_root=$LOCAL_ROOT
    saved_cache_root=$CACHE_ROOT
    saved_db_root=$DB_ROOT
    saved_src_cache=$SRC_CACHE
    saved_build_root=$BUILD_ROOT
    saved_image_dir=$IMAGE_DIR
    saved_inst_dir=$INST_DIR
    saved_build_cwd=$BUILD_CWD

    load_pkg "$pkg_arg"

    case :$PKG_INSTALL_STACK: in
        *:$PKG_NAME:*)
            die "dependency cycle detected while installing $PKG_NAME"
        ;;
    esac

    if [ -z "$PKG_INSTALL_STACK" ]; then
        check_requires_tree "$PKG_DIR"
    fi

    PKG_INSTALL_STACK=$PKG_INSTALL_STACK:$PKG_NAME
    export PKG_INSTALL_STACK

    log "starting install for $PKG_NAME"
    install_depends
    check_depends

    if installed_same_version; then
        log "already installed: $PKG_NAME $PKG_VERSION"
        stale=`stale_features "$INST_DIR"`
        if [ -n "$stale" ]; then
            log "note: $PKG_NAME was built with different options: $stale"
            log "      remove and reinstall it to pick up the current configuration"
        fi
        restore_install_context
        return 0
    fi

    check_build_shell

    if [ ! -d "$IMAGE_DIR" ] || [ -z "`find "$IMAGE_DIR" -print 2>/dev/null | sed 1d`" ]; then
        run_build
    else
        log "using existing staged image $IMAGE_DIR"
    fi

    if [ -d "$INST_DIR" ]; then
        log "replacing installed package $PKG_NAME"
        remove_name "$PKG_NAME"
        load_pkg "$pkg_arg"
    fi

    log_install_contents
    log "installing $PKG_NAME into $ROOT_DIR"
    install_preflight
    copy_tree "$IMAGE_DIR" "$ROOT_DIR"
    write_manifest
    log "recorded package database in $INST_DIR"

    if [ -f "$INST_DIR/post-install" ]; then
        log "running post-install"
        PKG_NAME=$PKG_NAME PKG_VERSION=$PKG_VERSION ROOT_DIR=$ROOT_DIR \
            sh "$INST_DIR/post-install"
    fi

    clean_image_cache
    log "installed $PKG_NAME $PKG_VERSION"

    restore_install_context
}

install_pkgs() {
    [ $# -ge 1 ] || die "install requires at least one <package-dir>"

    for pkg_arg
    do
        install_pkg "$pkg_arg"
    done
}

read_installed_version() {
    require_file "$INST_DIR/version"

    read PKG_VERSION PKG_VERSION_EXTRA < "$INST_DIR/version" ||
        die "failed to read installed version file for $PKG_NAME"

    [ -n "$PKG_VERSION" ] || die "installed version file did not contain a version for $PKG_NAME"
    [ -z "$PKG_VERSION_EXTRA" ] || die "installed version file must contain exactly one field for $PKG_NAME"
}

test_name() {
    PKG_NAME=`path_leaf "$1"`

    ROOT_DIR=`default_value "$PKG_ROOT" "/"`
    ROOT_DIR=`trim_slash "$ROOT_DIR"`
    LOCAL_ROOT=$ROOT_DIR/usr/local
    DB_ROOT=`default_value "$PKG_DB" "$LOCAL_ROOT/var/pkg/db"`
    INST_DIR=$DB_ROOT/installed/$PKG_NAME

    [ -d "$INST_DIR" ] || die "package is not installed: $PKG_NAME"

    read_installed_version
    require_file "$INST_DIR/test"

    log "testing $PKG_NAME $PKG_VERSION"

    # Use the build shell for tests too. Stock OPENSTEP sh can replace a
    # failing hook's exit status with the status of its EXIT cleanup trap.
    test_shell=`build_shell_path "$PKG_NAME"`
    [ -x "$test_shell" ] || die "missing test shell: $test_shell"

    if trace_enabled; then
        PKG_NAME=$PKG_NAME PKG_VERSION=$PKG_VERSION ROOT_DIR=$ROOT_DIR LOCAL_ROOT=$LOCAL_ROOT \
            PATH=$LOCAL_ROOT/bin:$LOCAL_ROOT/sbin:$PATH \
            "$test_shell" -x "$INST_DIR/test" || die "test failed for $PKG_NAME $PKG_VERSION"
    else
        PKG_NAME=$PKG_NAME PKG_VERSION=$PKG_VERSION ROOT_DIR=$ROOT_DIR LOCAL_ROOT=$LOCAL_ROOT \
            PATH=$LOCAL_ROOT/bin:$LOCAL_ROOT/sbin:$PATH \
            "$test_shell" "$INST_DIR/test" || die "test failed for $PKG_NAME $PKG_VERSION"
    fi

    log "test passed for $PKG_NAME $PKG_VERSION"
}

test_pkgs() {
    [ $# -ge 1 ] || die "test requires at least one <name>"

    for pkg_name
    do
        test_name "$pkg_name"
    done
}

list_pkgs() {
    ROOT_DIR=`default_value "$PKG_ROOT" "/"`
    ROOT_DIR=`trim_slash "$ROOT_DIR"`
    LOCAL_ROOT=$ROOT_DIR/usr/local
    DB_ROOT=`default_value "$PKG_DB" "$LOCAL_ROOT/var/pkg/db"`

    if [ ! -d "$DB_ROOT/installed" ]; then
        log "no installed packages"
        return 0
    fi

    for dir in $DB_ROOT/installed/*; do
        [ -d "$dir" ] || continue
        name=`path_leaf "$dir"`
        read version extra < "$dir/version" || version=unknown
        stale=`stale_features "$dir"`
        if [ -n "$stale" ]; then
            echo "$name $version  [rebuild to apply: $stale]"
        else
            echo "$name $version"
        fi
    done
}

remove_name() {
    name=$1
    ROOT_DIR=`default_value "$PKG_ROOT" "/"`
    ROOT_DIR=`trim_slash "$ROOT_DIR"`
    LOCAL_ROOT=$ROOT_DIR/usr/local
    DB_ROOT=`default_value "$PKG_DB" "$LOCAL_ROOT/var/pkg/db"`
    INST_DIR=$DB_ROOT/installed/$name

    require_file "$INST_DIR/manifest"

    if [ -f "$INST_DIR/pre-remove" ]; then
        log "running pre-remove"
        PKG_NAME=$name ROOT_DIR=$ROOT_DIR sh "$INST_DIR/pre-remove"
    fi

    log "removing $name"

    sort -r "$INST_DIR/manifest" | while read rel; do
        rel_path=`strip_leading_slash "$rel"`
        path=$ROOT_DIR/$rel_path

        if [ -h "$path" ] || [ -f "$path" ]; then
            rm -f "$path"
            continue
        fi

        if [ -d "$path" ]; then
            rmdir "$path" 2>/dev/null || :
        fi
    done

    rm -rf "$INST_DIR"
}

# Some old Bourne shells do not restore the positional parameters after a
# function call, so take what we need from them before calling anything.
ACTION=$1
ARGC=$#
ARG2=$2
if [ $# -gt 1 ]; then
    shift
    PKG_ARGS="$*"
else
    PKG_ARGS=
fi

detect_arch
load_config

case $ACTION in
    arch)
        [ "$ARGC" -eq 1 ] || die "arch takes no arguments"
        echo "PKG_ARCH=$PKG_ARCH"
        echo "PKG_TARGET=$PKG_TARGET"
        echo "PKG_SYSCC_ARCH_FLAGS=$PKG_SYSCC_ARCH_FLAGS"
        echo "PKG_GCC42_ARCH_FLAGS=$PKG_GCC42_ARCH_FLAGS"
    ;;

    config)
        [ "$ARGC" -eq 1 ] || die "config takes no arguments"
        echo "PKG_CONF_FILE=$PKG_CONF_FILE"
        echo "HAVE_X11=$HAVE_X11"
        echo "X11_PREFIX=$X11_PREFIX"
        echo "WITH_PYTHON=$WITH_PYTHON"
    ;;

    download)
        [ "$ARGC" -eq 2 ] || die "download requires <package-dir>"
        load_pkg "$ARG2"
        download_pkg
    ;;

    build)
        [ "$ARGC" -eq 2 ] || die "build requires <package-dir>"
        load_pkg "$ARG2"
        check_requires_tree "$PKG_DIR"
        run_build
    ;;

    install)
        install_pkgs $PKG_ARGS
    ;;

    list)
        [ "$ARGC" -eq 1 ] || die "list takes no arguments"
        list_pkgs
    ;;

    remove)
        [ "$ARGC" -eq 2 ] || die "remove requires <name>"
        remove_name "$ARG2"
    ;;

    test)
        test_pkgs $PKG_ARGS
    ;;

    ""|-h|--help|help)
        usage
    ;;

    *)
        die "unknown action: $ACTION"
    ;;
esac
