#!/bin/sh
# shellcheck disable=SC2006

set -e

die() {
    echo "error: $*" >&2
    exit 1
}

# One build per package at a time.  Two builds in the same tree overwrite each
# other's files (configure's conftest.c, objects, the staged image) and fail in
# confusing ways.  The lock is a directory beside the build tree holding the
# pid of the pkg that owns it.  A lock whose pid is gone (a build that was
# interrupted, failed or died) is stale and is removed automatically; PKG_RESUME does
# not override a live one.  PKG_BREAK_LOCK=1 removes the lock regardless.
BUILD_LOCK_DIR=

acquire_build_lock() {
    ab_dir=$CACHE_ROOT/build/$PKG_NAME.lock
    ensure_dir "$CACHE_ROOT/build"
    ab_tries=0
    while :; do
        if mkdir "$ab_dir" 2>/dev/null; then
            echo $$ > "$ab_dir/pid"
            BUILD_LOCK_DIR=$ab_dir
            return 0
        fi
        ab_pid=`cat "$ab_dir/pid" 2>/dev/null || :`
        if [ -z "$ab_pid" ] && [ $ab_tries -lt 3 ]; then
            # The owner may be between mkdir and writing its pid.
            ab_tries=`expr $ab_tries + 1`
            sleep 1
            continue
        fi
        if [ -n "$ab_pid" ] && [ "$ab_pid" != "$$" ] && kill -0 "$ab_pid" 2>/dev/null; then
            if [ "${PKG_BREAK_LOCK-}" = 1 ]; then
                log "removing the build lock of $PKG_NAME held by pid $ab_pid (PKG_BREAK_LOCK=1)"
            else
                die "another pkg (pid $ab_pid) is already building $PKG_NAME; wait for it to finish, or stop it. If you are sure none is running, PKG_BREAK_LOCK=1 removes the lock ($ab_dir)"
            fi
        else
            log "removing a stale build lock for $PKG_NAME (${ab_pid:-no pid})"
        fi
        rm -rf "$ab_dir"
        ab_tries=0
    done
}

release_build_lock() {
    if [ -n "$BUILD_LOCK_DIR" ]; then
        rm -rf "$BUILD_LOCK_DIR"
        BUILD_LOCK_DIR=
    fi
}

log() {
    echo "==> $*"
}

trace_enabled() {
    case $PKG_XTRACE in
        1|yes|true|on)
            return 0
        ;;
    esac

    return 1
}

# Work out which OPENSTEP architecture we are running on and export it, along
# with the default compiler flags for it.  arch(1) prints i386, sparc, m68k or
# hppa; when it is missing, assume i386 as pkg always has.  An architecture
# pkg does not know is passed through with no default flags.
detect_arch() {
    arch_raw=${PKG_ARCH:-`/usr/bin/arch 2>/dev/null`}

    case $arch_raw in
        ""|i[3-9]86|i386*)  PKG_ARCH=i386 ;;
        sparc*)             PKG_ARCH=sparc ;;
        m68*)               PKG_ARCH=m68k ;;
        hppa*)              PKG_ARCH=hppa ;;
        *)                  PKG_ARCH=$arch_raw ;;
    esac

    PKG_TARGET=$PKG_ARCH-next-openstep4

    case $PKG_ARCH in
        i386)
            arch_syscc=-m486
            arch_gcc42=-march=i486
        ;;
        sparc)
            # gcc-4.2 is configured for V8 (sun4m), so it needs no flag.
            arch_syscc=-mv8
            arch_gcc42=
        ;;
        *)
            arch_syscc=
            arch_gcc42=
        ;;
    esac

    PKG_SYSCC_ARCH_FLAGS=${PKG_SYSCC_ARCH_FLAGS-$arch_syscc}
    PKG_GCC42_ARCH_FLAGS=${PKG_GCC42_ARCH_FLAGS-$arch_gcc42}

    export PKG_ARCH PKG_TARGET PKG_SYSCC_ARCH_FLAGS PKG_GCC42_ARCH_FLAGS
}

# Site configuration lives outside the package tree, in a plain sh file of
# VAR=value lines: $PKG_CONF, else $PKG_ROOT/usr/local/etc/pkg.conf.  Every
# option has a default, so the file is optional.  The options are exported to
# build, test, post-install and pre-remove.
load_config() {
    conf_file=$PKG_CONF
    if [ "x$conf_file" = x ]; then
        conf_file=$PKG_ROOT/usr/local/etc/pkg.conf
    fi
    PKG_CONF_FILE=$conf_file

    # HAVE_X11: 1 when an X11 server (CubXWindow or similar) and its
    # development headers and libraries are installed, else 0.
    HAVE_X11=${HAVE_X11-0}

    # X11_PREFIX: directory holding the X11 include/ and lib/ (CubXWindow
    # installs under /usr/X11R6).
    X11_PREFIX=${X11_PREFIX-/usr/X11R6}

    # WITH_PYTHON: 1 to build packages' optional Python support (git-p4 in git)
    # against the python311 package, 0 to leave it out.
    WITH_PYTHON=${WITH_PYTHON-1}

    if [ -f "$conf_file" ]; then
        . "$conf_file"
    fi

    case $HAVE_X11 in
        0|1)
        ;;
        *)
            die "$conf_file: HAVE_X11 must be 0 or 1, not '$HAVE_X11'"
        ;;
    esac

    case $WITH_PYTHON in
        0|1)
        ;;
        *)
            die "$conf_file: WITH_PYTHON must be 0 or 1, not '$WITH_PYTHON'"
        ;;
    esac

    export PKG_CONF_FILE HAVE_X11 X11_PREFIX WITH_PYTHON
}

# A package's optional `requires` file names the pkg.conf options it needs:
#   HAVE_X11     required; build and install are refused when it is not 1
#   ?HAVE_X11    optional; the build script enables extra features when it is 1
# Comments (#) and blank lines are allowed.
option_value() {
    case $1 in
        HAVE_X11)
            echo "$HAVE_X11"
        ;;
        WITH_PYTHON)
            echo "$WITH_PYTHON"
        ;;
        *)
            return 1
        ;;
    esac
}

# Print "required" or "optional" lines for each entry in DIR/requires, as
# "<kind> <option>"; dies on an unknown option.
read_requires() {
    rr_file=$1/requires
    rr_pkg=$2

    [ -f "$rr_file" ] || return 0

    while read rr_entry rr_extra || [ -n "$rr_entry" ]; do
        case $rr_entry in
            ''|\#*)
                continue
            ;;
            \?*)
                rr_kind=optional
                rr_opt=`echo "$rr_entry" | sed 's/^?//'`
            ;;
            *)
                rr_kind=required
                rr_opt=$rr_entry
            ;;
        esac

        option_value "$rr_opt" > /dev/null ||
            die "unknown option in $rr_pkg requires: $rr_entry"
        echo "$rr_kind $rr_opt"
    done < "$rr_file"
}

# Check the requires files of a package and everything it would pull in via
# depends, before anything is built.  Dependencies that are already installed
# are skipped.
check_requires_tree() {
    rq_top=$1
    rq_root=`path_parent "$rq_top"`
    rq_todo=$rq_top
    rq_seen=:
    rq_bad=

    while [ -n "$rq_todo" ]; do
        set -- $rq_todo
        rq_cur=$1
        shift
        rq_todo="$*"

        rq_name=`path_leaf "$rq_cur"`
        case $rq_seen in
            *:$rq_name:*)
                continue
            ;;
        esac
        rq_seen=$rq_seen$rq_name:

        rq_list=`read_requires "$rq_cur" "$rq_name"` || exit 1
        while read rq_kind rq_opt; do
            [ "x$rq_kind" = xrequired ] || continue
            rq_val=`option_value "$rq_opt"`
            if [ "x$rq_val" != x1 ]; then
                rq_bad="$rq_bad
  $rq_name needs $rq_opt=1"
            fi
        done <<EOF
$rq_list
EOF

        [ -f "$rq_cur/depends" ] || continue

        while read rq_dep rq_extra || [ -n "$rq_dep" ]; do
            rq_dep=`dep_resolve "$rq_dep"` || exit 1
            case $rq_dep in
                ''|\#*|!*)
                    continue
                ;;
            esac
            [ -d "$DB_ROOT/installed/$rq_dep" ] && continue
            for rq_cand in "$rq_root/$rq_dep" "$rq_dep"
            do
                if [ -d "$rq_cand" ]; then
                    rq_todo="$rq_todo $rq_cand"
                    break
                fi
            done
        done < "$rq_cur/depends"
    done

    if [ -n "$rq_bad" ]; then
        die "cannot build $PKG_NAME with the current configuration ($PKG_CONF_FILE):$rq_bad"
    fi
}

# Tell the person which optional features this build will use.
log_optional_features() {
    rq_list=`read_requires "$PKG_DIR" "$PKG_NAME"` || exit 1
    while read rq_kind rq_opt; do
        [ "x$rq_kind" = xoptional ] || continue
        rq_val=`option_value "$rq_opt"`
        if [ "x$rq_val" = x1 ]; then
            log "optional feature $rq_opt: enabled"
        else
            log "optional feature $rq_opt: disabled"
        fi
    done <<EOF
$rq_list
EOF
}

# Record the optional options this build saw, so a later change to pkg.conf can
# be noticed ("built without HAVE_X11; reinstall to enable").
write_features_to() {
    wf_file=$1
    rq_list=`read_requires "$PKG_DIR" "$PKG_NAME"` || exit 1
    rm -f "$wf_file"
    while read rq_kind rq_opt; do
        [ "x$rq_kind" = xoptional ] || continue
        rq_val=`option_value "$rq_opt"`
        echo "$rq_opt=$rq_val" >> "$wf_file"
    done <<EOF
$rq_list
EOF
}

write_features() {
    write_features_to "$INST_DIR/features"
}

# Print the optional options whose value now differs from the recorded build.
stale_features() {
    sf_dir=$1
    [ -f "$sf_dir/features" ] || return 0
    while read sf_line; do
        sf_opt=`echo "$sf_line" | sed 's/=.*//'`
        sf_old=`echo "$sf_line" | sed 's/.*=//'`
        sf_now=`option_value "$sf_opt"` || continue
        if [ "x$sf_now" != "x$sf_old" ]; then
            echo "$sf_opt (built with $sf_old, now $sf_now)"
        fi
    done < "$sf_dir/features"
}

usage() {
    cat <<'EOF'
usage:
  pkg download <package-dir>
  pkg build <package-dir>
  pkg install <package-dir>...
  pkg reinstall <package-dir>...    (alias: forceinstall)
  pkg binpkg <package-dir>...
  pkg installpkg <file>...
  pkg list
  pkg remove <name>
  pkg test <name>...
  pkg arch
  pkg config

install actions:
  install      builds and installs a package and what it depends on; a package
               already installed at the same version is skipped
  reinstall    rebuilds and installs the named package even when it is already
               installed at that version (its dependencies are only installed
               when missing)
  binpkg       builds a package like install does, but instead of installing it
               writes <name>-<version>-<arch>.binpkg.tar.gz (into PKG_BINPKG_DIR,
               default the current directory); dependencies are installed first,
               as the build needs them
  installpkg   installs such a file: it replaces any installed version, copies
               the files in, records the package database and runs post-install,
               as install does.  It first checks the file's SHA-256 against
               <file>.sha256 (written by binpkg) or PKG_SHA256, and refuses a
               package that fails, or has no checksum, unless PKG_NO_VERIFY=1.
               It also refuses a package built for another PKG_ARCH, and one
               whose dependencies are not installed

configuration:
  pkg reads options from /usr/local/etc/pkg.conf (override with PKG_CONF; under
  PKG_ROOT when that is set).  The file is optional, plain sh VAR=value lines.
  See pkg.conf.example.  Options are exported to build, test, post-install and
  pre-remove.
    HAVE_X11   1 if an X11 server (CubXWindow or similar) and its development
               headers are installed; default 0
    X11_PREFIX directory holding the X11 include/ and lib/; default /usr/X11R6
               (where CubXWindow installs)
    WITH_PYTHON 1 (default) builds optional Python support (git-p4 in git) and
               depends on python311; 0 leaves it out

architecture:
  pkg detects the machine with arch(1) (override with PKG_ARCH=i386|sparc|m68k|hppa)
  and exports these to build, test, post-install and pre-remove:
    PKG_ARCH               i386, sparc, m68k or hppa
    PKG_TARGET             <arch>-next-openstep4, for configure --build/--host
    PKG_SYSCC_ARCH_FLAGS   default flags for the system /bin/cc (i386 -m486, sparc -mv8)
    PKG_GCC42_ARCH_FLAGS   default flags for gcc-4.2 (i386 -march=i486, sparc none:
                           V8 is its default)
  Set either *_FLAGS variable (even to empty) to override it.

package layout:
  build         required build script
  version       required, contains version
  depends       optional, one package name per line (?OPTION:name = only when OPTION is 1)
  requires      optional, pkg.conf options: HAVE_X11 (needed) or ?HAVE_X11 (extra features)
  sources       optional, one source per line
  checksums     SHA-256 and filename for each remote source
  post-install  optional shell hook
  pre-remove    optional shell hook
  test          optional installed-package test hook
EOF
}

# A depends entry may be conditional on a pkg.conf option: "?HAVE_X11:neXtaw"
# is a dependency on neXtaw only when HAVE_X11 is 1 (and is ignored otherwise).
# Print the entry to act on: the plain entry, or nothing when it is inactive.
dep_resolve() {
    dr_entry=$1

    case $dr_entry in
        \?*:*)
            dr_opt=`echo "$dr_entry" | sed 's/^?//; s/:.*//'`
            dr_rest=`echo "$dr_entry" | sed 's/^[^:]*://'`
            dr_val=`option_value "$dr_opt"` ||
                die "unknown option in depends entry: $dr_entry"
            if [ "x$dr_val" = x1 ]; then
                echo "$dr_rest"
            fi
        ;;
        *)
            echo "$dr_entry"
        ;;
    esac
}

dep_name() {
    case $1 in
        !*)
            echo "$1" | sed 's/^!//'
        ;;
        *)
            echo "$1"
        ;;
    esac
}

dep_is_negative() {
    case $1 in
        !*)
            return 0
        ;;
    esac

    return 1
}

require_file() {
    [ -f "$1" ] || die "missing file: $1"
}

default_value() {
    if [ "x$1" = x ]; then
        echo "$2"
    else
        echo "$1"
    fi
}

path_leaf() {
    echo "$1" | sed 's#/$##; s#.*/##'
}

path_parent() {
    case $1 in
        */*)
            echo "$1" | sed 's#/$##; s#/[^/]*$##'
        ;;
        *)
            echo .
        ;;
    esac
}

strip_leading_slash() {
    echo "$1" | sed 's#^/##'
}

ensure_dir() {
    dir=$1

    [ -d "$dir" ] && return 0

    case $dir in
        /*) current=/ ;;
         *) current=. ;;
    esac

    old_ifs=$IFS
    IFS=/
    set -- $dir
    IFS=$old_ifs

    for part
    do
        [ -n "$part" ] || continue

        if [ "$current" = / ]; then
            current=/$part
        else
            current=$current/$part
        fi

        [ -d "$current" ] || mkdir "$current" 2>/dev/null || [ -d "$current" ]
    done
}

trim_slash() {
    case $1 in
        /) echo / ;;
        */) echo "$1" | sed 's#/$##' ;;
        *) echo "$1" ;;
    esac
}

root_join() {
    rel=`strip_leading_slash "$1"`

    if [ "$ROOT_DIR" = / ]; then
        echo "/$rel"
    else
        echo "$ROOT_DIR/$rel"
    fi
}

find_tool() {
    tool=$1

    old_ifs=$IFS
    IFS=:
    set -- $PATH
    IFS=$old_ifs

    for dir
    do
        [ -n "$dir" ] || dir=.

        if [ -x "$dir/$tool" ]; then
            echo "$dir/$tool"
            return 0
        fi
    done

    return 1
}

is_bootstrap_pkg() {
    # Only the shell bootstrap must build without package dependencies.
    case $1 in
        pdksh)
            return 0
        ;;
    esac

    return 1
}

requires_pdksh_sh() {
    is_bootstrap_pkg "$1" && return 1

    return 0
}

build_shell_path() {
    # PKG_BUILD_SHELL overrides the shell for every build and test script, for
    # when pdksh trips over a package (e.g. PKG_BUILD_SHELL=/usr/local/bin/bash).
    if [ -n "${PKG_BUILD_SHELL-}" ]; then
        echo "$PKG_BUILD_SHELL"
    elif requires_pdksh_sh "$1"; then
        echo /usr/local/bin/ksh
    else
        echo /bin/sh
    fi
}

check_build_shell() {
    build_shell=`build_shell_path "$PKG_NAME"`

    if [ -x "$build_shell" ]; then
        return 0
    fi

    if [ "$build_shell" = /usr/local/bin/ksh ]; then
        parent_pkg_dir=$PKG_DIR
        parent_pkg_name=$PKG_NAME

        case :$PKG_INSTALL_STACK: in
            *:pdksh:*)
                die "required build shell pdksh is unavailable while already in the install stack for $parent_pkg_name"
            ;;
        esac

        pdksh_pkg_dir=`resolve_dep_pkg_dir pdksh` ||
            die "missing required build shell for $parent_pkg_name: $build_shell (and could not locate local pdksh package)"

        log "installing required build shell pdksh for $parent_pkg_name"
        ( install_pkg "$pdksh_pkg_dir" ) < /dev/null
        load_pkg "$parent_pkg_dir"

        build_shell=`build_shell_path "$PKG_NAME"`
    fi

    [ -x "$build_shell" ] || die "missing required build shell for $PKG_NAME: $build_shell"
}

load_pkg() {
    PKG_DIR=$1
    [ -d "$PKG_DIR" ] || die "package directory not found: $PKG_DIR"

    PKG_DIR=`cd "$PKG_DIR" && pwd`
    PKG_NAME=`path_leaf "$PKG_DIR"`

    require_file "$PKG_DIR/build"
    require_file "$PKG_DIR/version"

    read PKG_VERSION PKG_VERSION_EXTRA < "$PKG_DIR/version" ||
        die "failed to read version file"

    [ -n "$PKG_VERSION" ] || die "version file did not contain a version"
    [ -z "$PKG_VERSION_EXTRA" ] || die "version file must contain exactly one field"

    set_paths
}

# Work out the install, cache and database locations for PKG_NAME.
set_paths() {
    ROOT_DIR=`default_value "$PKG_ROOT" "/"`
    ROOT_DIR=`trim_slash "$ROOT_DIR"`
    LOCAL_ROOT=$ROOT_DIR/usr/local
    CACHE_ROOT=`default_value "$PKG_CACHE" "$LOCAL_ROOT/var/pkg/cache"`
    DB_ROOT=`default_value "$PKG_DB" "$LOCAL_ROOT/var/pkg/db"`

    SRC_CACHE=$CACHE_ROOT/sources/$PKG_NAME
    BUILD_ROOT=$CACHE_ROOT/build/$PKG_NAME
    IMAGE_DIR=$CACHE_ROOT/pkg/$PKG_NAME
    INST_DIR=$DB_ROOT/installed/$PKG_NAME
}

source_name() {
    source_leaf=`echo "$1" | sed 's/[?#].*$//; s#.*/##'`
    case $source_leaf in
        ''|.|..|*[!A-Za-z0-9._+-]*) die "invalid source filename: $1" ;;
    esac
    echo "$source_leaf"
}

source_checksum() (
    checksum_name=$1
    require_file "$PKG_DIR/checksums"
    # Stock sh runs a redirected loop in a subshell; capture its output.
    entries=`while read checksum filename extra || [ -n "$checksum" ]; do
        case $checksum in ''|\#*) continue ;; esac
        if [ "$filename" = "$checksum_name" ]; then
            echo "$checksum $filename $extra"
        fi
    done < "$PKG_DIR/checksums"`
    [ -n "$entries" ] || die "missing checksum for $checksum_name"
    set -f
    set -- $entries
    [ $# -eq 2 ] || die "invalid or duplicate checksum entry for $checksum_name"
    expected=$1
    case $expected in *[!0-9a-f]*) die "invalid SHA-256 for $checksum_name" ;; esac
    [ "`expr "$expected" : '.*'`" = 64 ] || die "invalid SHA-256 for $checksum_name"
    echo "$expected"
)

install_download_bootstrap() {
    case :$PKG_INSTALL_STACK:$PKG_NAME: in
        *:wget-bootstrap:*)
            die "download tools unavailable while bootstrapping wget-bootstrap; its dependencies must use local sources"
        ;;
    esac

    bootstrap_pkg_dir=`resolve_dep_pkg_dir wget-bootstrap` ||
        die "need to install wget-bootstrap but could not locate its local package directory"
    log "installing required download tools wget-bootstrap for $PKG_NAME" >&2
    # A fresh shell keeps install's set -e active inside a download error check.
    /bin/sh "$bootstrap_pkg_dir/../pkg" install "$bootstrap_pkg_dir" < /dev/null >&2
}

hash_file() (
    hash_path=$1
    PATH=$PATH:${LOCAL_ROOT:-/usr/local}/bin
    export PATH
    for attempt in existing bootstrap; do
        if [ "$attempt" = bootstrap ]; then
            install_download_bootstrap || exit 1
        fi
        hash_tool=`find_tool sha256sum 2>/dev/null || :`
        if [ -n "$hash_tool" ]; then
            hash_output=`"$hash_tool" "$hash_path"` || exit 1
            echo "$hash_output" | sed 's/ .*//'
            exit 0
        fi
        hash_tool=`find_tool openssl 2>/dev/null || :`
        if [ -n "$hash_tool" ]; then
            hash_output=`"$hash_tool" dgst -sha256 "$hash_path"` || exit 1
            echo "$hash_output" | sed 's/^.*= *//'
            exit 0
        fi
    done
    die "wget-bootstrap did not provide a usable sha256sum or openssl"
)

fetch_source() (
    url=$1
    output=$2
    scheme=`echo "$url" | sed 's/:.*//'`
    PATH=$PATH:${LOCAL_ROOT:-/usr/local}/bin
    export PATH
    for attempt in existing bootstrap; do
        if [ "$attempt" = bootstrap ]; then
            install_download_bootstrap || exit 1
        fi
        curl_path=`find_tool curl 2>/dev/null || :`
        if [ -n "$curl_path" ]; then
            protocols=`"$curl_path" -V 2>/dev/null | sed -n 's/^Protocols: *//p'`
            case " $protocols " in
                *" $scheme "*)
                    # -C - continues a partial file left by an earlier attempt.
                    "$curl_path" -fL -C - --retry 3 --connect-timeout 30 -o "$output" "$url"
                    exit $?
                ;;
            esac
        fi
        for tool in wget-bootstrap wget; do
            wget_path=`find_tool "$tool" 2>/dev/null || :`
            [ -n "$wget_path" ] || continue
            if [ "$scheme" = https ]; then
                features=`"$wget_path" --version 2>/dev/null || :`
                case $features in *+https*) : ;; *) continue ;; esac
            fi
            # --continue resumes the partial file from an earlier attempt
            # instead of starting over.  The retries are done here, one wget
            # process per attempt, because wget's own retry (which sleeps in
            # xsleep() first) hangs on some OPENSTEP builds.
            wget_try=1
            while :; do
                "$wget_path" --continue --timeout=30 --tries=1 -O "$output" "$url" &&
                    exit 0
                [ "$wget_try" -lt 5 ] || exit 1
                wget_try=`expr $wget_try + 1`
                log "download interrupted; retrying (attempt $wget_try of 5)" >&2
                sleep 2
            done
        done
    done
    die "wget-bootstrap did not provide a downloader supporting $scheme"
)

download_one() (
    src=$1
    dest=$2

    case $src in
        \#*|'')
            return 0
        ;;
    esac

    case $src in
        http://*|https://*|ftp://*)
            src_name=`source_name "$src"` || exit 1
            expected=`source_checksum "$src_name"` || exit 1
            ensure_dir "$SRC_CACHE"
            out=$SRC_CACHE/$src_name

            if [ -f "$out" ]; then
                actual=`hash_file "$out"` || exit 1
                if [ "$actual" = "$expected" ]; then
                    log "using verified cached $src_name"
                    exit 0
                fi
                log "discarding corrupt cached $src_name"
                rm -f "$out"
            fi

            # A download that fails or is interrupted leaves its partial file in
            # the cache; the next attempt continues it.  It is dropped when the
            # finished file does not match its checksum.
            partial=$out.part
            if [ -f "$partial" ]; then
                partial_size=`wc -c < "$partial" | sed 's/ //g'`
                log "resuming download of $src ($partial_size bytes already fetched)"
            else
                log "downloading $src"
            fi
            # Stock sh can report zero in an EXIT trap after an error.
            cleanup_status=1
            trap 'exit "$cleanup_status"' 0
            trap 'exit 1' 1 2 3 15
            fetch_source "$src" "$partial" ||
                die "download failed: $src (the partial file $partial is kept; run again to resume, or delete it to start over)"
            actual=`hash_file "$partial"` || exit 1
            if [ "$actual" != "$expected" ]; then
                rm -f "$partial"
                die "SHA-256 mismatch: $src (partial file discarded; run again to fetch it afresh)"
            fi
            mv "$partial" "$out" || die "cannot cache $src_name"
            cleanup_status=0
        ;;
        *://*) die "unsupported source URL: $src" ;;
    esac
)

download_pkg() {
    ensure_dir "$SRC_CACHE"

    [ -f "$PKG_DIR/sources" ] || return 0

    log "resolving sources for $PKG_NAME"

    while read src dest || [ -n "$src" ]; do
        download_one "$src" "$dest"
    done < "$PKG_DIR/sources"
}

pkg_tar() (
    PATH=${LOCAL_ROOT:-/usr/local}/bin:$PATH
    export PATH
    if [ -x "${LOCAL_ROOT:-/usr/local}/bin/gnutar" ]; then
        "${LOCAL_ROOT:-/usr/local}/bin/gnutar" "$@"
    else
        gnutar "$@"
    fi
)

copy_local_source() {
    src=$1
    dest=$2

    case $src in
        /*) path=$src ;;
        *) path=$PKG_DIR/$src ;;
    esac

    [ -f "$path" ] || [ -d "$path" ] || die "local source not found: $src"

    build_dest=`default_value "$dest" ""`
    target_dir=$BUILD_ROOT

    if [ -n "$build_dest" ]; then
        target_dir=$BUILD_ROOT/$build_dest
    fi

    ensure_dir "$target_dir"

    if [ -d "$path" ]; then
        copy_tree "$path" "$target_dir"
    else
        case $path in
            *.tar.gz|*.tgz|*.tar|*.tar.bz2|*.tbz2|*.tar.xz|*.txz|*.tar.zst|*.tzst)
                extract_archive "$path" "$dest"
            ;;
            *)
                cp "$path" "$target_dir/"
            ;;
        esac
    fi
}

# gnutar 1.15.1 rejects an archive whose uid or gid does not fit OPENSTEP's
# 16-bit uid_t ("Archive value 197609 is out of uid_t range").  Retry through
# tarfix, which zeroes the owner fields; $3... is the command that writes the
# archive as a plain tar stream on stdout when given the file name.
untar_retry() {
    ur_archive=$1
    ur_dir=$2
    shift 2
    ur_src=$PKG_DIR/../tarfix.c
    [ -f "$ur_src" ] || return 1
    ur_bin=$BUILD_ROOT/.tarfix-$$
    log "extraction failed; retrying with owner ids cleared"
    ( ${PKG_TARFIX_CC:-cc} -o "$ur_bin" "$ur_src" ) || return 1
    "$@" "$ur_archive" | "$ur_bin" |
        pkg_tar -xf - --no-same-owner -C "$ur_dir"
    ur_status=$?
    rm -f "$ur_bin"
    return $ur_status
}

extract_archive() {
    archive=$1
    dest=$2

    build_dest=`default_value "$dest" ""`
    target_dir=$BUILD_ROOT

    if [ -n "$build_dest" ]; then
        target_dir=$BUILD_ROOT/$build_dest
    fi

    ensure_dir "$target_dir"

    case $archive in
        *.tar.gz|*.tgz)
            pkg_tar -xzf "$archive" --no-same-owner -C "$target_dir" ||
                untar_retry "$archive" "$target_dir" gzip -dc
        ;;
        *.tar)
            pkg_tar -xf "$archive" --no-same-owner -C "$target_dir" ||
                untar_retry "$archive" "$target_dir" cat
        ;;
        *.tar.bz2|*.tbz2|*.tar.xz|*.txz|*.tar.zst|*.tzst)
            (
                case $archive in
                    *.tar.bz2|*.tbz2) unpacker=bzip2 ;;
                    *.tar.zst|*.tzst) unpacker=zstd ;;
                    *) unpacker=xz ;;
                esac
                unpack_path=`find_tool "$unpacker" 2>/dev/null || :`
                [ -n "$unpack_path" ] ||
                    die "need $unpacker to extract $archive; declare it in depends"
                unpack_tmp=$BUILD_ROOT/.unpack-$$.tar
                cleanup_status=1
                trap 'rm -f "$unpack_tmp"; exit "$cleanup_status"' 0
                trap 'exit 1' 1 2 3 15
                "$unpack_path" -dc "$archive" > "$unpack_tmp" ||
                    die "decompression failed: $archive"
                pkg_tar -xf "$unpack_tmp" --no-same-owner -C "$target_dir" ||
                    untar_retry "$unpack_tmp" "$target_dir" cat || exit 1
                cleanup_status=0
            )
        ;;
        *)
            cp "$archive" "$target_dir/"
        ;;
    esac
}

stage_source() {
    src=$1
    dest=$2

    case $src in
        \#*|'')
            return 0
        ;;
        *://*)
            src_name=`source_name "$src"`
            extract_archive "$SRC_CACHE/$src_name" "$dest"
        ;;
        *)
            copy_local_source "$src" "$dest"
        ;;
    esac
}

prepare_build_root() {
    # PKG_RESUME=1 keeps the build tree of an earlier, failed run (sources
    # already extracted, patched and configured, objects already built) instead
    # of starting over; the package's build script skips the steps it has
    # already completed (see pkg_step and pkg_apply_patch in build-helpers.sh).
    resume_build=
    if [ -n "${PKG_RESUME-}" ] && [ -d "$BUILD_ROOT" ]; then
        resume_build=1
    fi

    if [ -n "$resume_build" ]; then
        log "resuming build in $BUILD_ROOT"
        rm -rf "$IMAGE_DIR"
    else
        log "preparing build root $BUILD_ROOT"
        rm -rf "$BUILD_ROOT" "$IMAGE_DIR"
        ensure_dir "$BUILD_ROOT"
    fi
    ensure_dir "$IMAGE_DIR"

    if [ -z "$resume_build" ] && [ -f "$PKG_DIR/sources" ]; then
        while read src dest || [ -n "$src" ]; do
            case $src in
                ''|\#*)
                    :
                ;;
                *)
                    log "staging source $src"
                ;;
            esac
            stage_source "$src" "$dest"
        done < "$PKG_DIR/sources"
    fi

    set -- $BUILD_ROOT/*

    if [ "$1" != "$BUILD_ROOT/*" ] && [ $# -eq 1 ] && [ -d "$1" ]; then
        BUILD_CWD=$1
    else
        BUILD_CWD=$BUILD_ROOT
    fi
}

run_build() {
    build_shell=`build_shell_path "$PKG_NAME"`
    build_trace_flag=
    check_build_shell
    check_depends
    acquire_build_lock
    download_pkg
    prepare_build_root

    log "building $PKG_NAME $PKG_VERSION"
    log_optional_features
    log "build directory $BUILD_CWD"
    log "image directory $IMAGE_DIR"
    log "build shell $build_shell"

    if trace_enabled; then
        log "running build script with shell trace"
        build_trace_flag=-x
    fi

    (
        cd "$BUILD_CWD"
        DESTDIR=$IMAGE_DIR \
        PKG_BUILD_HELPERS=$PKG_DIR/../build-helpers.sh \
        "$build_shell" $build_trace_flag "$PKG_DIR/build" "$IMAGE_DIR" "$PKG_VERSION"
    )

    release_build_lock
    clean_work_cache
}

copy_tree() {
    src=$1
    dst=$2

    ensure_dir "$dst"
    copy_tar=tar
    copy_tar_flags=
    if [ -x "${LOCAL_ROOT:-/usr/local}/bin/gnutar" ]; then
        copy_tar=${LOCAL_ROOT:-/usr/local}/bin/gnutar
        # Shared ancestors such as /usr belong to the system, not the package.
        copy_tar_flags=--no-overwrite-dir
    fi

    (
        cd "$src"
        "$copy_tar" cf - .
    ) | (
        cd "$dst"
        "$copy_tar" xpf - $copy_tar_flags
    )
}

dir_writable() {
    probe=$1/.pkg-write-test-$$

    if mkdir "$probe" 2>/dev/null; then
        rmdir "$probe" 2>/dev/null || :
        return 0
    fi

    return 1
}

find_existing_dir() {
    dir=$1

    while :
    do
        if [ -d "$dir" ]; then
            echo "$dir"
            return 0
        fi

        parent=`path_parent "$dir"`

        if [ "$parent" = "$dir" ]; then
            break
        fi

        dir=$parent
    done

    return 1
}

check_depends() {
    dep_file=$PKG_DIR/depends

    [ -f "$dep_file" ] || return 0

    if is_bootstrap_pkg "$PKG_NAME"; then
        die "$PKG_NAME is a bootstrap package and must not declare dependencies"
    fi

    missing=
    conflicts=

    while read dep extra || [ -n "$dep" ]; do
        dep=`dep_resolve "$dep"` || exit 1
        case $dep in
            ''|\#*)
                continue
            ;;
        esac

        dep_pkg=`dep_name "$dep"`
        [ -n "$dep_pkg" ] || die "invalid dependency entry for $PKG_NAME: $dep"

        if dep_is_negative "$dep"; then
            if [ -d "$DB_ROOT/installed/$dep_pkg" ]; then
                if [ -n "$conflicts" ]; then
                    conflicts="$conflicts $dep_pkg"
                else
                    conflicts=$dep_pkg
                fi
            fi
        else
            if [ ! -d "$DB_ROOT/installed/$dep_pkg" ]; then
                if [ -n "$missing" ]; then
                    missing="$missing $dep_pkg"
                else
                    missing=$dep_pkg
                fi
            fi
        fi
    done < "$dep_file"

    if [ -n "$missing" ]; then
        die "missing dependencies for $PKG_NAME:$missing"
    fi

    if [ -n "$conflicts" ]; then
        die "conflicting installed packages for $PKG_NAME:$conflicts"
    fi
}

resolve_dep_pkg_dir() {
    dep=$1
    pkg_root=`path_parent "$PKG_DIR"`

    for candidate in "$pkg_root/$dep" "$dep"
    do
        if [ -d "$candidate" ]; then
            (
                cd "$candidate"
                pwd
            )
            return 0
        fi
    done

    return 1
}

install_depends() {
    dep_file=$PKG_DIR/depends

    [ -f "$dep_file" ] || return 0

    if is_bootstrap_pkg "$PKG_NAME"; then
        die "$PKG_NAME is a bootstrap package and must not declare dependencies"
    fi

    parent_pkg_dir=$PKG_DIR
    parent_pkg_name=$PKG_NAME

    while read dep extra || [ -n "$dep" ]; do
        dep=`dep_resolve "$dep"` || exit 1
        case $dep in
            ''|\#*)
                continue
            ;;
        esac

        dep_pkg=`dep_name "$dep"`
        [ -n "$dep_pkg" ] || die "invalid dependency entry for $parent_pkg_name: $dep"

        if dep_is_negative "$dep"; then
            if [ -d "$DB_ROOT/installed/$dep_pkg" ]; then
                die "conflicting installed package for $parent_pkg_name: $dep_pkg"
            fi
            continue
        fi

        if [ -d "$DB_ROOT/installed/$dep_pkg" ]; then
            log "dependency already installed: $dep_pkg"
            continue
        fi

        dep_dir=`resolve_dep_pkg_dir "$dep_pkg"` ||
            die "could not locate dependency package directory for $parent_pkg_name: $dep_pkg"

        case :$PKG_INSTALL_STACK: in
            *:$dep_pkg:*)
                die "dependency cycle detected while installing $parent_pkg_name: $dep_pkg"
            ;;
        esac

        log "installing dependency $dep_pkg for $parent_pkg_name"
        ( install_pkg "$dep_dir" ) < /dev/null
        load_pkg "$parent_pkg_dir"
    done < "$dep_file"
}

install_preflight() {
    (
        cd "$IMAGE_DIR"
        find . ! -name . -print | sed 's#^\./##' | sort
    ) | while read rel; do
        [ -n "$rel" ] || continue

        staged=$IMAGE_DIR/$rel
        target=`root_join "$rel"`

        if [ -d "$staged" ]; then
            if [ -d "$target" ]; then
                :
            else
                parent=`path_parent "$target"`
                existing=`find_existing_dir "$parent"` ||
                    die "could not find existing parent directory for: $target"
                dir_writable "$existing" || die "install target parent not writable: $existing"
            fi
        else
            parent=`path_parent "$target"`
            existing=`find_existing_dir "$parent"` ||
                die "could not find existing parent directory for: $target"
            dir_writable "$existing" || die "install target parent not writable: $existing"
        fi
    done
}

log_install_contents() {
    log "staged install contents:"

    (
        cd "$IMAGE_DIR"
        find . ! -name . -print | sed 's#^\./#/#' | sort
    ) | while read rel; do
        echo "  $rel"
    done
}

write_manifest() {
    ensure_dir "$INST_DIR"

    (
        cd "$IMAGE_DIR"
        find . ! -name . -print | sed 's#^\./#/#' | sort
    ) > "$INST_DIR/manifest"

    echo "$PKG_VERSION" > "$INST_DIR/version"
    if [ -n "$FEATURES_FILE" ]; then
        rm -f "$INST_DIR/features"
        if [ -f "$FEATURES_FILE" ]; then
            cp "$FEATURES_FILE" "$INST_DIR/features"
        fi
    else
        write_features
    fi

    for hook in pre-remove post-install test; do
        if [ -f "$HOOK_DIR/$hook" ]; then
            cp "$HOOK_DIR/$hook" "$INST_DIR/$hook"
            chmod +x "$INST_DIR/$hook" 2>/dev/null || :
        else
            rm -f "$INST_DIR/$hook"
        fi
    done
}

clean_image_cache() {
    if [ -d "$IMAGE_DIR" ]; then
        log "cleaning staged image $IMAGE_DIR"
        rm -rf "$IMAGE_DIR"
    fi
}

clean_source_cache() {
    if [ -d "$SRC_CACHE" ]; then
        log "cleaning source cache $SRC_CACHE"
        rm -rf "$SRC_CACHE"
    fi
}

clean_build_cache() {
    if [ -d "$BUILD_ROOT" ]; then
        log "cleaning build root $BUILD_ROOT"
        rm -rf "$BUILD_ROOT"
    fi
}

clean_work_cache() {
    clean_source_cache
    clean_build_cache
}

installed_same_version() {
    [ -f "$INST_DIR/version" ] || return 1

    read installed_version installed_version_extra < "$INST_DIR/version" ||
        return 1

    [ "x$installed_version" = "x$PKG_VERSION" ] && [ -z "$installed_version_extra" ]
}

restore_install_context() {
    PKG_INSTALL_STACK=$saved_install_stack
    PKG_DIR=$saved_pkg_dir
    PKG_NAME=$saved_pkg_name
    PKG_VERSION=$saved_pkg_version
    ROOT_DIR=$saved_root_dir
    LOCAL_ROOT=$saved_local_root
    CACHE_ROOT=$saved_cache_root
    DB_ROOT=$saved_db_root
    SRC_CACHE=$saved_src_cache
    BUILD_ROOT=$saved_build_root
    IMAGE_DIR=$saved_image_dir
    INST_DIR=$saved_inst_dir
    BUILD_CWD=$saved_build_cwd
    export PKG_INSTALL_STACK
}

install_pkg() {
    pkg_arg=$1
    # Only the package named on the command line is forced, not its dependencies.
    install_force=$PKG_FORCE
    PKG_FORCE=0
    saved_install_stack=$PKG_INSTALL_STACK
    saved_pkg_dir=$PKG_DIR
    saved_pkg_name=$PKG_NAME
    saved_pkg_version=$PKG_VERSION
    saved_root_dir=$ROOT_DIR
    saved_local_root=$LOCAL_ROOT
    saved_cache_root=$CACHE_ROOT
    saved_db_root=$DB_ROOT
    saved_src_cache=$SRC_CACHE
    saved_build_root=$BUILD_ROOT
    saved_image_dir=$IMAGE_DIR
    saved_inst_dir=$INST_DIR
    saved_build_cwd=$BUILD_CWD

    load_pkg "$pkg_arg"

    case :$PKG_INSTALL_STACK: in
        *:$PKG_NAME:*)
            die "dependency cycle detected while installing $PKG_NAME"
        ;;
    esac

    if [ -z "$PKG_INSTALL_STACK" ]; then
        check_requires_tree "$PKG_DIR"
    fi

    PKG_INSTALL_STACK=$PKG_INSTALL_STACK:$PKG_NAME
    export PKG_INSTALL_STACK

    log "starting install for $PKG_NAME"
    install_depends
    check_depends

    if [ "x$install_force" != x1 ] && installed_same_version; then
        log "already installed: $PKG_NAME $PKG_VERSION"
        stale=`stale_features "$INST_DIR"`
        if [ -n "$stale" ]; then
            log "note: $PKG_NAME was built with different options: $stale"
            log "      remove and reinstall it to pick up the current configuration"
        fi
        restore_install_context
        return 0
    fi

    check_build_shell

    if [ "x$install_force" = x1 ]; then
        log "reinstalling $PKG_NAME $PKG_VERSION: rebuilding it"
        clean_image_cache
    fi

    build_or_reuse_image

    HOOK_DIR=$PKG_DIR
    FEATURES_FILE=
    commit_install

    restore_install_context
}

# Build the package into its staged image unless one is already there.
build_or_reuse_image() {
    if [ ! -d "$IMAGE_DIR" ] || [ -z "`find "$IMAGE_DIR" -print 2>/dev/null | sed 1d`" ]; then
        run_build
    else
        log "using existing staged image $IMAGE_DIR"
    fi
}

# Install the staged image of PKG_NAME into ROOT_DIR, replacing any installed
# version, record it in the package database and run its post-install hook.
# HOOK_DIR holds the package's hooks; FEATURES_FILE, when set, is the recorded
# feature list to keep (otherwise it is worked out from PKG_DIR).  Shared by
# install, reinstall and installpkg.
commit_install() {
    if [ -d "$INST_DIR" ]; then
        log "replacing installed package $PKG_NAME"
        remove_name "$PKG_NAME"
        set_paths
    fi

    log_install_contents
    log "installing $PKG_NAME into $ROOT_DIR"
    install_preflight
    copy_tree "$IMAGE_DIR" "$ROOT_DIR"
    write_manifest
    log "recorded package database in $INST_DIR"

    if [ -f "$INST_DIR/post-install" ]; then
        log "running post-install"
        PKG_NAME=$PKG_NAME PKG_VERSION=$PKG_VERSION ROOT_DIR=$ROOT_DIR \
            sh "$INST_DIR/post-install"
    fi

    clean_image_cache
    log "installed $PKG_NAME $PKG_VERSION"
}

install_pkgs() {
    [ $# -ge 1 ] || die "$ACTION requires at least one <package-dir>"

    for pkg_arg
    do
        PKG_FORCE=$FORCE_INSTALL
        install_pkg "$pkg_arg"
    done
}

# --- binary packages -------------------------------------------------------
#
# A binary package is a gzipped tar of a built package's staged image, plus a
# .pkg/ directory at its top with what installpkg needs:
#   format  name  version  arch  target   identification
#   depends     the resolved depends entries (!name = conflicts)
#   requires    pkg.conf options the package needs
#   features    optional options it was built with
#   post-install, pre-remove, test   the package's hooks, when it has them
# installpkg then does what install does after the build: it replaces any
# installed version, copies the files in, records the package database and
# runs post-install.

write_resolved_depends() {
    [ -f "$PKG_DIR/depends" ] || return 0

    while read rd_dep rd_extra || [ -n "$rd_dep" ]; do
        rd_dep=`dep_resolve "$rd_dep"` || exit 1
        case $rd_dep in
            ''|\#*)
                continue
            ;;
        esac
        echo "$rd_dep"
    done < "$PKG_DIR/depends"
}

binpkg_pkg() {
    pkg_arg=$1

    load_pkg "$pkg_arg"
    check_requires_tree "$PKG_DIR"

    PKG_INSTALL_STACK=$PKG_INSTALL_STACK:$PKG_NAME
    export PKG_INSTALL_STACK

    log "starting binary package build for $PKG_NAME"
    install_depends
    check_depends
    check_build_shell
    build_or_reuse_image

    bp_dir=`default_value "$PKG_BINPKG_DIR" "."`
    ensure_dir "$bp_dir"
    bp_dir=`cd "$bp_dir" && pwd`
    bp_file=$bp_dir/$PKG_NAME-$PKG_VERSION-$PKG_ARCH.binpkg.tar.gz

    bp_meta=$IMAGE_DIR/.pkg
    [ ! -e "$bp_meta" ] || die "$PKG_NAME's image already contains a .pkg: $bp_meta"
    mkdir "$bp_meta"

    echo 1 > "$bp_meta/format"
    echo "$PKG_NAME" > "$bp_meta/name"
    echo "$PKG_VERSION" > "$bp_meta/version"
    echo "$PKG_ARCH" > "$bp_meta/arch"
    echo "$PKG_TARGET" > "$bp_meta/target"
    write_resolved_depends > "$bp_meta/depends"
    write_features_to "$bp_meta/features"
    if [ -f "$PKG_DIR/requires" ]; then
        cp "$PKG_DIR/requires" "$bp_meta/requires"
    fi
    for hook in pre-remove post-install test; do
        if [ -f "$PKG_DIR/$hook" ]; then
            cp "$PKG_DIR/$hook" "$bp_meta/$hook"
        fi
    done

    log "writing $bp_file"
    rm -f "$bp_file"
    (
        cd "$IMAGE_DIR"
        pkg_tar -czf "$bp_file" .
    ) || { rm -rf "$bp_meta"; rm -f "$bp_file"; die "could not write $bp_file"; }
    rm -rf "$bp_meta"

    # The checksum travels with the package; installpkg refuses a package
    # whose SHA-256 it cannot check.
    bp_hash=`hash_file "$bp_file"` || die "could not checksum $bp_file"
    echo "$bp_hash  `path_leaf "$bp_file"`" > "$bp_file.sha256"

    clean_image_cache
    log "wrote binary package $bp_file (sha256 $bp_hash)"
}

binpkg_pkgs() {
    [ $# -ge 1 ] || die "binpkg requires at least one <package-dir>"

    for pkg_arg
    do
        ( binpkg_pkg "$pkg_arg" ) < /dev/null || exit 1
    done
}

# Print the first line of one of a binary package's .pkg/ metadata files.
binpkg_field() {
    bf_line=`pkg_tar -xzOf "$1" "./.pkg/$2" 2>/dev/null | sed 1q` || :
    echo "$bf_line"
}

binpkg_check_requires() {
    bc_meta=$1
    [ -f "$bc_meta/requires" ] || return 0

    bc_list=`read_requires "$bc_meta" "$PKG_NAME"` || exit 1
    bc_bad=
    while read bc_kind bc_opt; do
        [ "x$bc_kind" = xrequired ] || continue
        bc_val=`option_value "$bc_opt"`
        if [ "x$bc_val" != x1 ]; then
            bc_bad="$bc_bad $bc_opt"
        fi
    done <<EOF
$bc_list
EOF
    if [ -n "$bc_bad" ]; then
        clean_image_cache
        die "$PKG_NAME needs these pkg.conf options set to 1:$bc_bad"
    fi
}

binpkg_check_depends() {
    bd_meta=$1
    [ -f "$bd_meta/depends" ] || return 0

    bd_missing=
    bd_conflicts=
    while read bd_dep bd_extra || [ -n "$bd_dep" ]; do
        case $bd_dep in
            ''|\#*)
                continue
            ;;
        esac
        bd_pkg=`dep_name "$bd_dep"`
        if dep_is_negative "$bd_dep"; then
            if [ -d "$DB_ROOT/installed/$bd_pkg" ]; then
                bd_conflicts="$bd_conflicts $bd_pkg"
            fi
        elif [ ! -d "$DB_ROOT/installed/$bd_pkg" ]; then
            bd_missing="$bd_missing $bd_pkg"
        fi
    done < "$bd_meta/depends"

    if [ -n "$bd_missing" ]; then
        clean_image_cache
        die "missing dependencies for $PKG_NAME (install them first):$bd_missing"
    fi
    if [ -n "$bd_conflicts" ]; then
        clean_image_cache
        die "conflicting installed packages for $PKG_NAME:$bd_conflicts"
    fi
}

installpkg_file() {
    ip_file=$1
    [ -f "$ip_file" ] || die "binary package not found: $ip_file"
    case $ip_file in
        /*)
        ;;
        *)
            ip_file=`pwd`/$ip_file
        ;;
    esac

    # Check the package before reading anything out of it.  The expected hash
    # is PKG_SHA256, or the one in <file>.sha256 that binpkg wrote.
    # PKG_NO_VERIFY=1 skips the check.
    if [ "x$PKG_NO_VERIFY" != x1 ]; then
        ip_want=$PKG_SHA256
        if [ -z "$ip_want" ] && [ -f "$ip_file.sha256" ]; then
            read ip_want ip_want_rest < "$ip_file.sha256"
        fi
        [ -n "$ip_want" ] ||
            die "no checksum for $ip_file: put its SHA-256 in $ip_file.sha256 (binpkg writes one), set PKG_SHA256, or set PKG_NO_VERIFY=1 to install it unchecked"
        ip_got=`hash_file "$ip_file"` || die "could not checksum $ip_file"
        [ "x$ip_got" = "x$ip_want" ] ||
            die "SHA-256 mismatch for $ip_file (expected $ip_want, got $ip_got); not installing it"
        log "verified $ip_file"
    else
        log "warning: installing $ip_file without verifying it (PKG_NO_VERIFY=1)"
    fi

    ip_format=`binpkg_field "$ip_file" format`
    [ "x$ip_format" = x1 ] ||
        die "not a binary package made by this pkg (format '$ip_format'): $ip_file"

    PKG_NAME=`binpkg_field "$ip_file" name`
    PKG_VERSION=`binpkg_field "$ip_file" version`
    ip_arch=`binpkg_field "$ip_file" arch`
    case $PKG_NAME in
        ''|*/*|.*)
            die "invalid package name in $ip_file: '$PKG_NAME'"
        ;;
    esac
    [ -n "$PKG_VERSION" ] || die "no version in $ip_file"
    [ "x$ip_arch" = "x$PKG_ARCH" ] ||
        die "$PKG_NAME was built for $ip_arch, this machine is $PKG_ARCH"

    PKG_DIR=
    set_paths
    log "starting install of binary package $PKG_NAME $PKG_VERSION from $ip_file"

    clean_image_cache
    ensure_dir "$IMAGE_DIR"
    pkg_tar -xzpf "$ip_file" -C "$IMAGE_DIR" ||
        { clean_image_cache; die "could not unpack $ip_file"; }

    ip_meta=$CACHE_ROOT/binpkg-meta/$PKG_NAME
    rm -rf "$ip_meta"
    ensure_dir "$CACHE_ROOT/binpkg-meta"
    [ -d "$IMAGE_DIR/.pkg" ] ||
        { clean_image_cache; die "$ip_file has no .pkg metadata"; }
    mv "$IMAGE_DIR/.pkg" "$ip_meta"

    binpkg_check_requires "$ip_meta"
    binpkg_check_depends "$ip_meta"

    HOOK_DIR=$ip_meta
    FEATURES_FILE=$ip_meta/features
    commit_install
    rm -rf "$ip_meta"
}

installpkg_files() {
    [ $# -ge 1 ] || die "installpkg requires at least one <file>"

    for ip_arg
    do
        ( installpkg_file "$ip_arg" ) < /dev/null || exit 1
    done
}

read_installed_version() {
    require_file "$INST_DIR/version"

    read PKG_VERSION PKG_VERSION_EXTRA < "$INST_DIR/version" ||
        die "failed to read installed version file for $PKG_NAME"

    [ -n "$PKG_VERSION" ] || die "installed version file did not contain a version for $PKG_NAME"
    [ -z "$PKG_VERSION_EXTRA" ] || die "installed version file must contain exactly one field for $PKG_NAME"
}

test_name() {
    PKG_NAME=`path_leaf "$1"`

    ROOT_DIR=`default_value "$PKG_ROOT" "/"`
    ROOT_DIR=`trim_slash "$ROOT_DIR"`
    LOCAL_ROOT=$ROOT_DIR/usr/local
    DB_ROOT=`default_value "$PKG_DB" "$LOCAL_ROOT/var/pkg/db"`
    INST_DIR=$DB_ROOT/installed/$PKG_NAME

    [ -d "$INST_DIR" ] || die "package is not installed: $PKG_NAME"

    read_installed_version
    require_file "$INST_DIR/test"

    log "testing $PKG_NAME $PKG_VERSION"

    # Use the build shell for tests too. Stock OPENSTEP sh can replace a
    # failing hook's exit status with the status of its EXIT cleanup trap.
    test_shell=`build_shell_path "$PKG_NAME"`
    [ -x "$test_shell" ] || die "missing test shell: $test_shell"

    if trace_enabled; then
        PKG_NAME=$PKG_NAME PKG_VERSION=$PKG_VERSION ROOT_DIR=$ROOT_DIR LOCAL_ROOT=$LOCAL_ROOT \
            PATH=$LOCAL_ROOT/bin:$LOCAL_ROOT/sbin:$PATH \
            "$test_shell" -x "$INST_DIR/test" || die "test failed for $PKG_NAME $PKG_VERSION"
    else
        PKG_NAME=$PKG_NAME PKG_VERSION=$PKG_VERSION ROOT_DIR=$ROOT_DIR LOCAL_ROOT=$LOCAL_ROOT \
            PATH=$LOCAL_ROOT/bin:$LOCAL_ROOT/sbin:$PATH \
            "$test_shell" "$INST_DIR/test" || die "test failed for $PKG_NAME $PKG_VERSION"
    fi

    log "test passed for $PKG_NAME $PKG_VERSION"
}

test_pkgs() {
    [ $# -ge 1 ] || die "test requires at least one <name>"

    for pkg_name
    do
        test_name "$pkg_name"
    done
}

list_pkgs() {
    ROOT_DIR=`default_value "$PKG_ROOT" "/"`
    ROOT_DIR=`trim_slash "$ROOT_DIR"`
    LOCAL_ROOT=$ROOT_DIR/usr/local
    DB_ROOT=`default_value "$PKG_DB" "$LOCAL_ROOT/var/pkg/db"`

    if [ ! -d "$DB_ROOT/installed" ]; then
        log "no installed packages"
        return 0
    fi

    for dir in $DB_ROOT/installed/*; do
        [ -d "$dir" ] || continue
        name=`path_leaf "$dir"`
        read version extra < "$dir/version" || version=unknown
        stale=`stale_features "$dir"`
        if [ -n "$stale" ]; then
            echo "$name $version  [rebuild to apply: $stale]"
        else
            echo "$name $version"
        fi
    done
}

remove_name() {
    name=$1
    ROOT_DIR=`default_value "$PKG_ROOT" "/"`
    ROOT_DIR=`trim_slash "$ROOT_DIR"`
    LOCAL_ROOT=$ROOT_DIR/usr/local
    DB_ROOT=`default_value "$PKG_DB" "$LOCAL_ROOT/var/pkg/db"`
    INST_DIR=$DB_ROOT/installed/$name

    require_file "$INST_DIR/manifest"

    if [ -f "$INST_DIR/pre-remove" ]; then
        log "running pre-remove"
        PKG_NAME=$name ROOT_DIR=$ROOT_DIR sh "$INST_DIR/pre-remove"
    fi

    log "removing $name"

    sort -r "$INST_DIR/manifest" | while read rel; do
        rel_path=`strip_leading_slash "$rel"`
        path=$ROOT_DIR/$rel_path

        if [ -h "$path" ] || [ -f "$path" ]; then
            rm -f "$path"
            continue
        fi

        if [ -d "$path" ]; then
            rmdir "$path" 2>/dev/null || :
        fi
    done

    rm -rf "$INST_DIR"
}

# Some old Bourne shells do not restore the positional parameters after a
# function call, so take what we need from them before calling anything.
ACTION=$1
ARGC=$#
FORCE_INSTALL=0
PKG_FORCE=0
HOOK_DIR=
FEATURES_FILE=
ARG2=$2
if [ $# -gt 1 ]; then
    shift
    PKG_ARGS="$*"
else
    PKG_ARGS=
fi

detect_arch
load_config

case $ACTION in
    arch)
        [ "$ARGC" -eq 1 ] || die "arch takes no arguments"
        echo "PKG_ARCH=$PKG_ARCH"
        echo "PKG_TARGET=$PKG_TARGET"
        echo "PKG_SYSCC_ARCH_FLAGS=$PKG_SYSCC_ARCH_FLAGS"
        echo "PKG_GCC42_ARCH_FLAGS=$PKG_GCC42_ARCH_FLAGS"
    ;;

    config)
        [ "$ARGC" -eq 1 ] || die "config takes no arguments"
        echo "PKG_CONF_FILE=$PKG_CONF_FILE"
        echo "HAVE_X11=$HAVE_X11"
        echo "X11_PREFIX=$X11_PREFIX"
        echo "WITH_PYTHON=$WITH_PYTHON"
    ;;

    download)
        [ "$ARGC" -eq 2 ] || die "download requires <package-dir>"
        load_pkg "$ARG2"
        download_pkg
    ;;

    build)
        [ "$ARGC" -eq 2 ] || die "build requires <package-dir>"
        load_pkg "$ARG2"
        check_requires_tree "$PKG_DIR"
        run_build
    ;;

    install)
        FORCE_INSTALL=0
        install_pkgs $PKG_ARGS
    ;;

    reinstall|forceinstall)
        FORCE_INSTALL=1
        install_pkgs $PKG_ARGS
    ;;

    binpkg)
        binpkg_pkgs $PKG_ARGS
    ;;

    installpkg)
        installpkg_files $PKG_ARGS
    ;;

    list)
        [ "$ARGC" -eq 1 ] || die "list takes no arguments"
        list_pkgs
    ;;

    remove)
        [ "$ARGC" -eq 2 ] || die "remove requires <name>"
        remove_name "$ARG2"
    ;;

    test)
        test_pkgs $PKG_ARGS
    ;;

    ""|-h|--help|help)
        usage
    ;;

    *)
        die "unknown action: $ACTION"
    ;;
esac
