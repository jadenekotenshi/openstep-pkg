@@ -0,0 +1,63 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdarg.h>
+#include <string.h>
+#include <errno.h>
+#include "err.h"
+
+extern char *progname;
+
+static void report(const char *format, va_list ap, int error)
+{
+    fprintf(stderr, "%s: ", progname);
+    if (format != NULL) {
+        vfprintf(stderr, format, ap);
+        if (error != 0)
+            fputs(": ", stderr);
+    }
+    if (error != 0)
+        fputs(strerror(error), stderr);
+    fputc('\n', stderr);
+}
+
+void err(int status, const char *format, ...)
+{
+    int error = errno;
+    va_list ap;
+    va_start(ap, format);
+    report(format, ap, error);
+    va_end(ap);
+    exit(status);
+}
+
+void warn(const char *format, ...)
+{
+    int error = errno;
+    va_list ap;
+    va_start(ap, format);
+    report(format, ap, error);
+    va_end(ap);
+}
+
+void warnx(const char *format, ...)
+{
+    va_list ap;
+    va_start(ap, format);
+    report(format, ap, 0);
+    va_end(ap);
+}
+
+void strmode(int mode, char *buffer)
+{
+    int i;
+    strcpy(buffer, "---------- ");
+    for (i = 0; i < 9; ++i)
+        if (mode & (0400 >> i))
+            buffer[i + 1] = "rwx"[i % 3];
+    if (mode & 04000)
+        buffer[3] = mode & 0100 ? 's' : 'S';
+    if (mode & 02000)
+        buffer[6] = mode & 0010 ? 's' : 'S';
+    if (mode & 01000)
+        buffer[9] = mode & 0001 ? 't' : 'T';
+}
