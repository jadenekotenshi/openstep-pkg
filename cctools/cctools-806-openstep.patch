+++ b/libstuff/openstep.c
@@ -0,0 +1,77 @@
+#include "compat.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <mach/mach.h>
+#include <sys/mman.h>
+
+void *openstep_mmap(void *address, size_t length, int protection,
+                    int flags, int fd, off_t offset)
+{
+    vm_offset_t mapped;
+    kern_return_t result;
+    if (address != NULL || flags != MAP_PRIVATE || length == 0 ||
+        protection != (PROT_READ | PROT_WRITE)) {
+        errno = EINVAL;
+        return (void *)-1;
+    }
+    result = map_fd(fd, offset, &mapped, TRUE, length);
+    if (result != KERN_SUCCESS) {
+        errno = result == KERN_NO_SPACE ? ENOMEM : EINVAL;
+        return (void *)-1;
+    }
+    return (void *)mapped;
+}
+
+char *strdup(const char *string)
+{
+    size_t length = strlen(string) + 1;
+    char *copy = malloc(length);
+    if (copy != NULL)
+        memcpy(copy, string, length);
+    return copy;
+}
+
+/* Only trace diagnostics use this; a temporary stream keeps formatting bounded. */
+int vsnprintf(char *buffer, size_t size, const char *format, va_list arguments)
+{
+    FILE *stream;
+    int length;
+    size_t copied;
+    if (size != 0)
+        buffer[0] = '\0';
+    stream = tmpfile();
+    if (stream == NULL)
+        return -1;
+    length = vfprintf(stream, format, arguments);
+    if (length >= 0 && size != 0) {
+        rewind(stream);
+        copied = fread(buffer, 1, size - 1, stream);
+        buffer[copied] = '\0';
+        if (ferror(stream))
+            length = -1;
+    }
+    fclose(stream);
+    return length;
+}
+
+/* These command-line tools are single threaded; preserve nested sort state. */
+static void *sort_context;
+static int (*sort_compare)(void *, const void *, const void *);
+
+static int compare(const void *left, const void *right)
+{
+    return sort_compare(sort_context, left, right);
+}
+
+void qsort_r(void *base, size_t count, size_t size, void *context,
+             int (*callback)(void *, const void *, const void *))
+{
+    void *saved_context = sort_context;
+    int (*saved_compare)(void *, const void *, const void *) = sort_compare;
+    sort_context = context;
+    sort_compare = callback;
+    qsort(base, count, size, compare);
+    sort_context = saved_context;
+    sort_compare = saved_compare;
+}
