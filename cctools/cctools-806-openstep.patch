+# Native OPENSTEP bootstrap: no GCC 4.2 or newer cctools required.
+CC = /bin/cc
+CFLAGS = -traditional-cpp -O2 -D__OPENSTEP__ -DDEBUG \
+    -Iinclude/openstep -Iinclude -Ild -include include/openstep/compat.h
+OUT = openstep-build
+STUFF = allocate errors arch execute bytesex rnd hppa swap_headers reloc \
+    version_number get_toc_byte_sex best_arch fatals arch_usage ofile \
+    ofile_error print set_arch_flag_name seg_addr_table dylib_table breakout \
+    writeout checkout fatal_arch ofile_get_word vm_flush_cache hash_string \
+    dylib_roots guess_short_name get_arch_from_host crc32 \
+    macosx_deployment_target symbol_list unix_standard_mode openstep
+ARFILES = append ar archive contents delete extract misc move print replace openstep
+LDFILES = ld pass1 objects sections cstring_literals symbols fvmlibs layout \
+    specs pass2 generic_reloc rld sets 4byte_literals 8byte_literals \
+    literal_pointers dylibs indirect_sections mod_sections i860_reloc \
+    ppc_reloc m88k_reloc hppa_reloc sparc_reloc coalesced_sections \
+    debugcompunit debugline arm_reloc
+STUFFOBJ = $(STUFF:%=$(OUT)/libstuff/%.o)
+AROBJ = $(ARFILES:%=$(OUT)/ar/%.o)
+LDOBJ = $(LDFILES:%=$(OUT)/ld/%.o)
+
+all: $(OUT)/ar-tool $(OUT)/ranlib $(OUT)/ld-tool
+
+$(OUT)/libstuff/%.o: libstuff/%.c
+	$(CC) $(CFLAGS) -c $< -o $@
+
+$(OUT)/ar/%.o: ar/%.c
+	$(CC) $(CFLAGS) -c $< -o $@
+
+$(OUT)/ld/%.o: ld/%.c
+	$(CC) $(CFLAGS) -c $< -o $@
+
+$(OUT)/libstuff.a: $(STUFFOBJ)
+	/bin/ar cr $@ $(STUFFOBJ)
+	/bin/ranlib $@
+
+$(OUT)/vers.o:
+	echo 'const char apple_version[] = "cctools-806 (OPENSTEP)";' > $(OUT)/vers.c
+	$(CC) -c $(OUT)/vers.c -o $@
+
+$(OUT)/libtool.o: misc/libtool.c
+	$(CC) $(CFLAGS) -c $< -o $@
+
+$(OUT)/ar-tool: $(AROBJ) $(OUT)/libstuff.a
+	$(CC) -o $@ $(AROBJ) $(OUT)/libstuff.a
+
+$(OUT)/ranlib: $(OUT)/libtool.o $(OUT)/vers.o $(OUT)/libstuff.a
+	$(CC) -o $@ $(OUT)/libtool.o $(OUT)/vers.o $(OUT)/libstuff.a
+
+$(OUT)/ld-tool: $(LDOBJ) $(OUT)/vers.o $(OUT)/libstuff.a
+	$(CC) -o $@ $(LDOBJ) $(OUT)/vers.o $(OUT)/libstuff.a
