--- a/lib/argp-fmtstream.c
+++ b/lib/argp-fmtstream.c
@@ -47,6 +47,38 @@
 
 #define INIT_BUF_SIZE 200
 #define PRINTF_SIZE_GUESS 150
+
+#ifdef NeXT
+/* OPENSTEP has no vsnprintf; its vfprintf returns zero on success. */
+static int
+next_vsnprintf (char *buf, size_t size, const char *fmt, va_list args)
+{
+  FILE *stream = tmpfile ();
+  long length;
+  size_t count;
+  if (!stream)
+    return -1;
+  if (vfprintf (stream, fmt, args) < 0 || fflush (stream) != 0
+      || (length = ftell (stream)) < 0
+      || fseek (stream, 0L, SEEK_SET) != 0)
+    {
+      fclose (stream);
+      return -1;
+    }
+  count = size ? (length < size ? length : size - 1) : 0;
+  if (fread (buf, 1, count, stream) != count)
+    {
+      fclose (stream);
+      return -1;
+    }
+  if (size)
+    buf[count] = '\0';
+  fclose (stream);
+  return length;
+}
+# undef __vsnprintf
+# define __vsnprintf next_vsnprintf
+#endif
 
 /* Return an argp_fmtstream that outputs to STREAM, and which prefixes lines
    written on it with LMARGIN spaces and limits them to RMARGIN columns
@@ -421,6 +453,8 @@
