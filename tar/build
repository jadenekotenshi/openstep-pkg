#!/bin/sh
set -e
DESTDIR=$1
VERSION=$2
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin
CC=/usr/local/bin/gcc-4.2
CFLAGS="$PKG_GCC42_ARCH_FLAGS "'-O2 -DNeXT -D_POSIX_SOURCE'
GREP=/usr/local/bin/grep
EGREP='/usr/local/bin/grep -E'
AWK=/usr/local/bin/gawk
# tar's configure refuses to run as root without this.
FORCE_UNSAFE_CONFIGURE=1
export PATH CC CFLAGS GREP EGREP AWK FORCE_UNSAFE_CONFIGURE
if test -d "tar-$VERSION"; then cd "tar-$VERSION"; fi
patch -p1 < "tar-$VERSION-openstep.patch"
. "$PKG_BUILD_HELPERS"

# gnulib's wrappers for <fcntl.h> and <sys/stat.h> #include the system header by
# absolute name, which configure finds by running `sed -n '\#/fcntl.h#{...}'`
# over the preprocessor's output.  That sed script does not work here, and the
# result is an empty name ("empty filename in #include").  Ask the compiler for
# the dependency list instead and hand configure the answers.
abs_header() {
    echo "#include <$1>" > absh.c
    for abs_w in `$CC $CFLAGS -M absh.c 2> /dev/null`; do
        case $abs_w in
            */$1)
                echo "$abs_w"
                break
            ;;
        esac
    done
}
abs_fcntl_h=`abs_header fcntl.h`
abs_sys_stat_h=`abs_header sys/stat.h`
/bin/rm -f absh.c
test -n "$abs_fcntl_h" && test -n "$abs_sys_stat_h" ||
    { echo "tar: cannot locate the system fcntl.h/sys/stat.h" >&2; exit 1; }
gl_cv_absolute_fcntl_h=$abs_fcntl_h
gl_cv_absolute_sys_stat_h=$abs_sys_stat_h
export gl_cv_absolute_fcntl_h gl_cv_absolute_sys_stat_h

# OPENSTEP's libc has no snprintf(), sysconf() or fchdir() (gnulib's at-function
# emulation and chdir-long need fchdir), and its headers may still declare them.
# The shim below implements them under private names, and the -D renames send
# tar's calls there so they can never clash with a system prototype.  fchdir()
# has no kernel support here, so open/close/dup/dup2/fcntl are renamed too, and
# the shim remembers the absolute path behind every descriptor it hands out.
/bin/cat > openstep_tarshim.c <<'SHIMEOF'
#include <sys/types.h>
#include <sys/stat.h>
#include <errno.h>
#include <fcntl.h>
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

#define MAXFDS 1024
static char *fd_path[MAXFDS];

extern char *getwd();

static void
forget(int fd)
{
    if (fd >= 0 && fd < MAXFDS && fd_path[fd] != 0) {
	free(fd_path[fd]);
	fd_path[fd] = 0;
    }
}

static void
remember(int fd, const char *path)
{
    char cwd[2048];
    char *copy;
    size_t n;

    if (fd < 0 || fd >= MAXFDS)
	return;
    forget(fd);
    if (path[0] == '/') {
	copy = (char *)malloc(strlen(path) + 1);
	if (copy != 0)
	    strcpy(copy, path);
    } else {
	if (getwd(cwd) == 0)
	    return;
	n = strlen(cwd) + 1 + strlen(path) + 1;
	copy = (char *)malloc(n);
	if (copy != 0) {
	    strcpy(copy, cwd);
	    strcat(copy, "/");
	    strcat(copy, path);
	}
    }
    fd_path[fd] = copy;
}

static void
copy_path(int from, int to)
{
    if (to < 0 || to >= MAXFDS)
	return;
    forget(to);
    if (from >= 0 && from < MAXFDS && fd_path[from] != 0) {
	fd_path[to] = (char *)malloc(strlen(fd_path[from]) + 1);
	if (fd_path[to] != 0)
	    strcpy(fd_path[to], fd_path[from]);
    }
}

int
openstep_open(const char *path, int flags, ...)
{
    va_list ap;
    int mode, fd;

    va_start(ap, flags);
    mode = va_arg(ap, int);
    va_end(ap);
    fd = open(path, flags, mode);
    if (fd >= 0)
	remember(fd, path);
    return fd;
}

int
openstep_close(int fd)
{
    forget(fd);
    return close(fd);
}

int
openstep_dup(int fd)
{
    int nfd = dup(fd);

    if (nfd >= 0)
	copy_path(fd, nfd);
    return nfd;
}

int
openstep_dup2(int fd, int fd2)
{
    int r = dup2(fd, fd2);

    if (r >= 0)
	copy_path(fd, fd2);
    return r;
}

int
openstep_fcntl(int fd, int cmd, ...)
{
    va_list ap;
    long arg;
    int r;

    va_start(ap, cmd);
    arg = va_arg(ap, long);
    va_end(ap);
    r = fcntl(fd, cmd, arg);
    if (r >= 0 && cmd == F_DUPFD)
	copy_path(fd, r);
    return r;
}

int
openstep_fchdir(int fd)
{
    if (fd < 0 || fd >= MAXFDS || fd_path[fd] == 0) {
	errno = EBADF;
	return -1;
    }
    return chdir(fd_path[fd]);
}

long
openstep_sysconf(int name)
{
    switch (name) {
#ifdef _SC_PAGESIZE
    case _SC_PAGESIZE:
	return getpagesize();
#endif
#ifdef _SC_OPEN_MAX
    case _SC_OPEN_MAX:
	return getdtablesize();
#endif
#ifdef _SC_ARG_MAX
    case _SC_ARG_MAX:
	return 262144;
#endif
#ifdef _SC_NGROUPS_MAX
    case _SC_NGROUPS_MAX:
	return 16;
#endif
    }
    errno = EINVAL;
    return -1;
}

/* The output is formatted into a large buffer and cut to fit. */
int
openstep_snprintf(char *buf, size_t size, const char *fmt, ...)
{
    static char tmp[65536];
    va_list ap;
    int n;

    va_start(ap, fmt);
    n = vsprintf(tmp, fmt, ap);
    va_end(ap);
    if (n < 0)
	return n;
    if (size > 0) {
	size_t m = ((size_t)n < size - 1) ? (size_t)n : size - 1;
	memcpy(buf, tmp, m);
	buf[m] = 0;
    }
    return n;
}
SHIMEOF
$CC $CFLAGS -c openstep_tarshim.c -o openstep_tarshim.o
LIBS=`pwd`/openstep_tarshim.o
CPPFLAGS='-Dopen=openstep_open -Dclose=openstep_close -Ddup=openstep_dup -Ddup2=openstep_dup2 -Dfcntl=openstep_fcntl -Dfchdir=openstep_fchdir -Dsysconf=openstep_sysconf -Dsnprintf=openstep_snprintf'
export LIBS CPPFLAGS

# --program-prefix=g installs the program as gtar (and the man page as gtar.1,
# the remote tape helper as grmt, whose compiled-in default path matches).
# It must never be installed as "tar" or "gnutar": the system has its own, and
# tools may expect the BSD or old-GNU behaviour of those names.
run_configure --prefix=/usr/local --build=$PKG_TARGET --host=$PKG_TARGET \
    --program-prefix=g --disable-nls --disable-dependency-tracking
/bin/gnumake
/bin/gnumake install DESTDIR="$DESTDIR"

BINDIR="$DESTDIR/usr/local/bin"
test -x "$BINDIR/gtar" || { echo "tar: gtar was not installed" >&2; exit 1; }
for name in tar gnutar; do
    if test -e "$BINDIR/$name" || test -e "$DESTDIR/usr/local/man/man1/$name.1" ||
       test -e "$DESTDIR/usr/local/share/man/man1/$name.1"; then
        echo "tar: the image contains $name; refusing to ship it" >&2
        exit 1
    fi
done
# Shared files other packages own: libiconv's charset.alias and the info index.
/bin/rm -f "$DESTDIR/usr/local/lib/charset.alias" "$DESTDIR/usr/local/share/info/dir" \
    "$DESTDIR/usr/local/info/dir"
