diff -ruN ta2/tar-1.16.1/lib/dirent.h tb2/tar-1.16.1/lib/dirent.h
--- a/lib/dirent.h	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/dirent.h	2026-10-06 03:17:16.598336281 +0000
@@ -0,0 +1,21 @@
+/* Wrapper for <dirent.h> on OPENSTEP.  Its libc's readdir() returns the BSD
+   "struct direct" (d_name at a different offset from SVID "struct dirent"),
+   so go through <sys/dir.h> and rename the type.  Elsewhere defer to the real
+   header.  */
+#ifndef TAR_OPENSTEP_DIRENT_H
+#define TAR_OPENSTEP_DIRENT_H
+
+#ifdef NeXT
+# undef _POSIX_SOURCE
+# ifndef _NEXT_SOURCE
+#  define _NEXT_SOURCE 1
+# endif
+# include <sys/types.h>
+# include <sys/dir.h>
+# define _POSIX_SOURCE 1
+# define dirent direct
+#else
+# include_next <dirent.h>
+#endif
+
+#endif /* TAR_OPENSTEP_DIRENT_H */
