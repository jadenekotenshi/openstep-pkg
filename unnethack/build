#!/bin/sh
set -e
DESTDIR=$1
VERSION=$2
PREFIX=/usr/local
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin
CC="/usr/local/bin/gcc-4.2 $PKG_GCC42_ARCH_FLAGS -std=gnu99"
# On i386 the archives and objects come from the cctools tools; a gcc42 built
# before the cctools package needs the specs file to pick the right linker.
if [ "$PKG_ARCH" = i386 ] && [ -f /usr/local/lib/cctools/gcc42.specs ]; then
    CC="$CC -specs=/usr/local/lib/cctools/gcc42.specs"
fi
export PATH CC
# GitHub's archive unpacks as UnNetHack-<commit>
for d in UnNetHack-*; do
    if test -d "$d"; then cd "$d"; break; fi
done
. "$PKG_BUILD_HELPERS"

# UnNetHack is NetHack 3.4.3 with a great deal added, built with autoconf.  OPENSTEP
# is configured as a System V system by default; like the nethack and slashem
# packages it is treated as a BSD system without POSIX job control or types.  The
# terminal handling stays terminfo (through ncurses): the termcap-only paths in the
# tty code are not kept up to date upstream and do not compile.  The rewritten lines
# are checked below.
/bin/sed \
    -e 's|^/\* #define BSD 1 \*/|#define BSD 1|' \
    -e 's|^#define SYSV[ 	]|#undef SYSV |' \
    -e 's|^#define SVR4[ 	]|#undef SVR4 |' \
    -e 's|^#define LINUX[ 	]|#undef LINUX |' \
    -e 's|^#define POSIX_JOB_CONTROL[ 	]|#undef POSIX_JOB_CONTROL |' \
    -e 's|^#define POSIX_TYPES[ 	]|#undef POSIX_TYPES |' \
    include/unixconf.h > include/unixconf.h.new
/bin/mv include/unixconf.h.new include/unixconf.h
/bin/grep '^#define BSD 1' include/unixconf.h > /dev/null
/bin/grep '^#undef SYSV' include/unixconf.h > /dev/null
/bin/grep '^#undef POSIX_TYPES' include/unixconf.h > /dev/null

# This libc lacks <stdint.h>, snprintf() and strdup(), and may lack some types.  A
# private include directory and a header read with -include supply them as static
# code, so nothing needs linking.  The directory is not called "openstep": make
# would take that for a target.
inc=`pwd`/ostep-inc
/usr/local/bin/mkdir -p ostep-inc
/bin/cat > ostep-inc/stdint.h <<'SEOF'
#ifndef OPENSTEP_STDINT_H
#define OPENSTEP_STDINT_H
#include <sys/types.h>
typedef signed char int8_t;
typedef short int16_t;
typedef int int32_t;
typedef long long int64_t;
typedef unsigned char uint8_t;
typedef unsigned short uint16_t;
typedef unsigned int uint32_t;
typedef unsigned long long uint64_t;
typedef long intptr_t;
typedef unsigned long uintptr_t;
#define INT32_MAX 2147483647
#define UINT32_MAX 4294967295U
#endif
SEOF
/bin/cat > ostep-inc/inttypes.h <<'SEOF'
#ifndef OPENSTEP_INTTYPES_H
#define OPENSTEP_INTTYPES_H
#include <stdint.h>
#define PRId32 "d"
#define PRIu32 "u"
#define PRIx32 "x"
#define PRId64 "lld"
#define PRIu64 "llu"
#define PRIx64 "llx"
#endif
SEOF
/bin/cp snprintf-shim.h ostep-inc/snprintf-shim.h
# Types the <sys/types.h> may lack (probed, since a duplicate typedef is an error too).
: > ostep-inc/types-extra.h
for t in pid_t uid_t gid_t mode_t; do
    {
        echo '#include <sys/types.h>'
        echo "$t probe_var;"
    } > probe.c
    if $CC -c probe.c -o probe.o 2> /dev/null; then :; else
        echo "typedef int $t;" >> ostep-inc/types-extra.h
    fi
done
/bin/cat > ostep-inc/unnethack-compat.h <<'HEOF'
#ifndef OPENSTEP_UNNETHACK_H
#define OPENSTEP_UNNETHACK_H
#include <sys/types.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <sys/time.h>
#include <unistd.h>
#ifndef PATH_MAX
#define PATH_MAX 1024
#endif
#include "types-extra.h"
#include <sys/stat.h>
#ifndef S_IRUSR
# define S_IRUSR 0000400
# define S_IWUSR 0000200
# define S_IXUSR 0000100
# define S_IRGRP 0000040
# define S_IWGRP 0000020
# define S_IXGRP 0000010
# define S_IROTH 0000004
# define S_IWOTH 0000002
# define S_IXOTH 0000001
#endif
#include "snprintf-shim.h"
static char *
ostep_strdup(const char *s)
{
    size_t n = strlen(s) + 1;
    char *p = (char *) malloc(n);

    if (p != 0)
	memcpy(p, s, n);
    return p;
}
#define strdup ostep_strdup
/* strtoull() is missing here (makedefs reads SOURCE_DATE_EPOCH with it) */
static unsigned long long
ostep_strtoull(const char *s, char **end, int base)
{
    unsigned long long v = 0;
    int d;

    while (*s == ' ' || *s == '\t')
	s++;
    if (base == 0)
	base = 10;
    for (;; s++) {
	if (*s >= '0' && *s <= '9')
	    d = *s - '0';
	else if (*s >= 'a' && *s <= 'z')
	    d = *s - 'a' + 10;
	else if (*s >= 'A' && *s <= 'Z')
	    d = *s - 'A' + 10;
	else
	    break;
	if (d >= base)
	    break;
	v = v * base + d;
    }
    if (end)
	*end = (char *) s;
    return v;
}
#define strtoull ostep_strtoull
#endif
HEOF

# Configure: tty and curses interfaces (curses through the ncurses package), gzip for
# compressed files, the Guidebook is not formatted (nroff is not used), and the
# bison and flex packages for the level and dungeon compilers.  The compat header is
# not read by configure's own tests (a forced header breaks them); it is added to the
# makefiles afterwards.
# (A resumed build, PKG_RESUME=1, skips this step once it has succeeded; PKG_REDO=configure
# runs it again.)
unnethack_configure() {
    ncinc=/usr/local/include/ncurses
    # (Exported rather than set in front of the command: the shell here does not pass
    # assignments made in front of a function call on to the programs it runs.)
    CFLAGS="-O2 -I$inc -I$ncinc"
    CPPFLAGS="-I$inc -I$ncinc -I/usr/local/include"
    LDFLAGS="-L/usr/local/lib"
    LUA=/usr/local/bin/lua
    LUA_INCLUDE="-I/usr/local/include"
    LUA_LIB="-L/usr/local/lib -llua -lm"
    YACC="/usr/local/bin/bison -y"
    LEX=/usr/local/bin/flex
    HAVE_NROFF=no
    HAVE_COL=yes
    export CFLAGS CPPFLAGS LDFLAGS LUA LUA_INCLUDE LUA_LIB YACC LEX HAVE_NROFF HAVE_COL
    run_configure --prefix=$PREFIX --build=$PKG_TARGET --host=$PKG_TARGET \
        --with-compression=/usr/local/bin/gzip --disable-file-areas \
        --enable-tty-graphics --enable-curses-graphics --disable-utf8-glyphs \
        --with-owner=root --with-group=wheel

    # configure treats this as System V; the game is built as BSD (see above).
    /bin/sed -e 's|^#define SYSV.*|/* #undef SYSV */|' \
        -e 's|^#undef BSD$|#define BSD 1|' \
        -e 's|^#define LINUX.*|/* #undef LINUX */|' \
        include/autoconf.h > include/autoconf.h.new
    /bin/mv include/autoconf.h.new include/autoconf.h
    /bin/grep '^#define BSD 1' include/autoconf.h > /dev/null
    # <utime.h> exists here but has no struct utimbuf (utime() takes a time_t array); the
    # game then skips setting the time stamps of its dump files.
    /bin/sed -e 's|^#define HAVE_UTIME_H.*|/* #undef HAVE_UTIME_H */|' include/autoconf.h > include/autoconf.h.new
    /bin/mv include/autoconf.h.new include/autoconf.h

    for mk in src/Makefile util/Makefile; do
        /bin/sed -e "s|^CFLAGS = |CFLAGS = -I$inc -I$ncinc -include $inc/unnethack-compat.h -DHACKDIR=\\\\\"$PREFIX/share/unnethack\\\\\" -DNeXT -DYYMALLOC=malloc -DYYFREE=free |" \
            $mk > $mk.new
        /bin/mv $mk.new $mk
        /bin/grep 'unnethack-compat.h' $mk > /dev/null
    done
}
pkg_step configure unnethack_configure

# With the file areas off the game keeps everything in one playground, which it enters
# by name: the HACKDIR above, where the install puts the game and its data.
/bin/grep 'DHACKDIR' src/Makefile > /dev/null

/bin/gnumake
/usr/local/bin/mkdir -p "$DESTDIR$PREFIX/bin"
# There is no games user or group here; ownership is left alone and the score and
# save files are writable by everyone who can run it.
/bin/gnumake install DESTDIR="$DESTDIR" CHOWN=true CHGRP=true

# Replace the stock launcher (it uses "test -e", which the system sh lacks).
/bin/cat > "$DESTDIR$PREFIX/bin/unnethack" <<'LEOF'
#!/bin/sh
HACKDIR=/usr/local/share/unnethack
export HACKDIR
# a first-time player gets the default configuration file
if test ! -f "$HOME/.unnethackrc" && test ! -f "$HOME/.nethackrc"; then
    cp "$HACKDIR/unnethackrc.default" "$HOME/.unnethackrc"
fi
cd $HACKDIR
exec $HACKDIR/unnethack ${1+"$@"}
LEOF
/bin/chmod 755 "$DESTDIR$PREFIX/bin/unnethack"

test -x "$DESTDIR$PREFIX/share/unnethack/unnethack"
test -f "$DESTDIR$PREFIX/share/unnethack/unnethackrc.default"
