--- a/ncurses/tinfo/getenv_num.c
+++ b/ncurses/tinfo/getenv_num.c
@@ -69,6 +69,40 @@
 	_nc_SPRINTF(buffer, _nc_SLIMIT(sizeof(buffer)) "%s=%d", name, value);
 	if ((s = strdup(buffer)) != 0)
 	    putenv(s);
+#elif defined(NeXT)
+	/* OPENSTEP has neither setenv nor putenv.  Keep the environment
+	 * strings alive, as the putenv branch above does. */
+	extern char **environ;
+	static char **owned_environment;
+	char **new_environment;
+	char *s;
+	size_t n = strlen(name);
+	size_t count = 0;
+
+	s = malloc(n + 32);
+	if (s == 0)
+	    return;
+	sprintf(s, "%s=%d", name, value);
+	while (environ != 0 && environ[count] != 0) {
+	    if (strncmp(environ[count], name, n) == 0
+		&& environ[count][n] == '=') {
+		environ[count] = s;
+		return;
+	    }
+	    ++count;
+	}
+	new_environment = malloc((count + 2) * sizeof(char *));
+	if (new_environment == 0) {
+	    free(s);
+	    return;
+	}
+	if (count != 0)
+	    memcpy(new_environment, environ, count * sizeof(char *));
+	new_environment[count] = s;
+	new_environment[count + 1] = 0;
+	if (environ == owned_environment)
+	    free(owned_environment);
+	environ = owned_environment = new_environment;
 #else
 #error expected setenv/putenv functions
 #endif
