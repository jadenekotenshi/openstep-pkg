+/* libcurl's formatter returns the bytes stored, so retry in a growing
+   buffer to implement C99's untruncated result count.  Use that count,
+   rather than strlen, to preserve embedded NUL characters. */
+int
+vsnprintf (char *dst, size_t size, const char *format, va_list ap)
+{
+  size_t capacity = 128;
+  char *buffer;
+  int count, saved_errno = errno;
+  char *converted = openstep_format (format);
+  if (!converted) return -1;
+  for (;;)
+    {
+      va_list copy;
+      buffer = malloc (capacity);
+      if (!buffer) { free (converted); errno = ENOMEM; return -1; }
+      __builtin_va_copy (copy, ap);
+      count = curl_mvsnprintf (buffer, capacity, converted, copy);
+      va_end (copy);
+      if (count < 0) { free (buffer); free (converted); return -1; }
+      if ((size_t) count < capacity - 1) break;
+      free (buffer);
+      if (capacity > INT_MAX / 2)
+        { free (converted); errno = EOVERFLOW; return -1; }
+      capacity *= 2;
+    }
+  if (size)
+    {
+      size_t n = (size_t) count < size - 1 ? count : size - 1;
+      memcpy (dst, buffer, n);
+      dst[n] = 0;
+    }
+  free (buffer);
+  free (converted);
+  errno = saved_errno;
+  return count;
+}
+
+int
+snprintf (char *dst, size_t size, const char *format, ...)
+{
+  va_list ap;
+  int count;
+  va_start (ap, format);
