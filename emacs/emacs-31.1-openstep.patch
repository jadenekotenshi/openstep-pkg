+static __inline__ int openstep_isfinite (double x)
+{ return -DBL_MAX <= x && x <= DBL_MAX; }
+#define isfinite openstep_isfinite
+#endif
+#ifndef isinf
+static __inline__ int openstep_isinf (double x)
+{ return x < -DBL_MAX || x > DBL_MAX; }
