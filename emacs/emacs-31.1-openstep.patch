+/* POSIX signal masks use the same 32-bit representation as BSD masks. */
+int sigemptyset (sigset_t *set) { *set = 0; return 0; }
+int sigfillset (sigset_t *set) { *set = 0x7fffffff; return 0; }
+static int openstep_signal_valid (int sig)
+{ if (sig > 0 && sig < 32) return 1; errno = EINVAL; return 0; }
+int sigaddset (sigset_t *set, int sig)
+{ if (!openstep_signal_valid (sig)) return -1; *set |= 1U << (sig - 1); return 0; }
+int sigdelset (sigset_t *set, int sig)
+{ if (!openstep_signal_valid (sig)) return -1; *set &= ~(1U << (sig - 1)); return 0; }
+int sigismember (const sigset_t *set, int sig)
+{ return openstep_signal_valid (sig) ? !!(*set & (1U << (sig - 1))) : -1; }
+int sigprocmask (int how, const sigset_t *set, sigset_t *old)
+{
+  int previous;
+  if (!set) previous = sigblock (0);
+  else switch (how)
+    {
+    case SIG_BLOCK: previous = sigblock (*set); break;
+    case SIG_UNBLOCK: previous = sigsetmask (sigblock (0) & ~*set); break;
+    case SIG_SETMASK: previous = sigsetmask (*set); break;
+    default: errno = EINVAL; return -1;
+    }
+  if (old) *old = previous;
+  return 0;
+}
+int sigsuspend (const sigset_t *set) { return sigpause (*set); }
+int sigaction (int sig, const struct sigaction *action, struct sigaction *old)
+{
+  struct sigvec vector, previous;
+  int result;
+  if (action)
+    {
+      if (action->sa_flags & ~SA_RESTART) { errno = EINVAL; return -1; }
+      vector.sv_handler = action->sa_handler;
+      vector.sv_mask = action->sa_mask;
+      vector.sv_flags = action->sa_flags & SA_RESTART ? 0 : SV_INTERRUPT;
+    }
+  result = sigvec (sig, action ? &vector : NULL, old ? &previous : NULL);
+  if (!result && old)
+    {
+      old->sa_handler = previous.sv_handler;
+      old->sa_mask = previous.sv_mask;
+      old->sa_flags = previous.sv_flags & SV_INTERRUPT ? 0 : SA_RESTART;
+    }
