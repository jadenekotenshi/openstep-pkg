+static __inline__ double
+openstep_scalbn (double x, int n)
+{
+  return ldexp (x, n);
+}
+
+static __inline__ double
+openstep_trunc (double x)
+{
+  return copysign (floor (fabs (x)), x);
+}
+
+static __inline__ long
+openstep_lrint (double x)
+{
+  return (long) rint (x);
+}
+
+static __inline__ long
+openstep_lround (double x)
+{
+  return (long) (x < 0 ? ceil (x - 0.5) : floor (x + 0.5));
+}
+
+static __inline__ int
+openstep_ilogb (double x)
+{
+  int exponent;
+  if (x == 0 || x != x)
+    return INT_MIN;
+  if (x > DBL_MAX || x < -DBL_MAX)
+    return INT_MAX;
+  frexp (x, &exponent);
+  return exponent - 1;
+}
+
+static __inline__ float
+openstep_powf (float x, float y)
+{
+  return (float) pow (x, y);
+}
