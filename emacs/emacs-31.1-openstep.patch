+char *strdup (const char *s)
+{
+  size_t n = strlen (s) + 1;
+  char *copy = malloc (n);
+  if (copy) memcpy (copy, s, n);
+  return copy;
+}
+/* Preserve putenv's ownership contract: the caller owns the string. */
+extern char **environ;
+int putenv (char *entry)
+{
+  static char **owned;
+  char *equals = strchr (entry, '=');
+  size_t length = equals ? equals - entry : strlen (entry);
+  size_t count = 0, i;
+  char **replacement;
+  if (!length) { errno = EINVAL; return -1; }
+  while (environ && environ[count])
+    {
+      if (!strncmp (environ[count], entry, length) && environ[count][length] == '=')
+        {
+          if (equals) environ[count] = entry;
+          else do environ[count] = environ[count + 1]; while (environ[count++]);
+          return 0;
+        }
+      count++;
+    }
+  if (!equals) return 0;
+  if (count > SIZE_MAX / sizeof (char *) - 2) { errno = ENOMEM; return -1; }
+  replacement = malloc ((count + 2) * sizeof (char *));
+  if (!replacement) { errno = ENOMEM; return -1; }
+  for (i = 0; i < count; ++i) replacement[i] = environ[i];
+  replacement[count] = entry;
+  replacement[count + 1] = NULL;
+  if (environ == owned) free (owned);
+  owned = environ = replacement;
+  return 0;
+}
