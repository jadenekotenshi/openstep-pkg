+{
+  static const char *const names[] = {
+    "alnum", "alpha", "blank", "cntrl", "digit", "graph",
+    "lower", "print", "punct", "space", "upper", "xdigit"
+  };
+  unsigned int i;
+  for (i = 0; i < sizeof names / sizeof names[0]; ++i)
+    if (!strcmp (name, names[i])) return i + 1;
+  return 0;
