+/* The kernel implements termios ioctls, but libsys omits these interfaces. */
+int tcgetattr (int fd, struct termios *attributes)
+{ return ioctl (fd, TIOCGETA, attributes); }
+int tcsetattr (int fd, int action, const struct termios *attributes)
+{
+  struct termios copy = *attributes;
+  unsigned long request;
+  if (action & TCSASOFT)
+    { copy.c_cflag |= CIGNORE; action &= ~TCSASOFT; }
+  switch (action)
+    {
+    case TCSANOW: request = TIOCSETA; break;
+    case TCSADRAIN: request = TIOCSETAW; break;
+    case TCSAFLUSH: request = TIOCSETAF; break;
+    default: errno = EINVAL; return -1;
+    }
+  return ioctl (fd, request, &copy);
+}
+speed_t cfgetispeed (const struct termios *attributes)
+{ return attributes->c_ispeed; }
+speed_t cfgetospeed (const struct termios *attributes)
+{ return attributes->c_ospeed; }
+int cfsetispeed (struct termios *attributes, int speed)
+{
