+     requests (especially AI_NUMERICHOST) completely independent of DNS. */
+# ifdef NeXT
+  struct in_addr numeric;
+  struct hostent numeric_host;
+  char *numeric_addresses[2];
+  struct hostent *he;
+  if (inet_pton (AF_INET, nodename, &numeric) == 1)
+    {
+      memset (&numeric_host, 0, sizeof numeric_host);
+      numeric_addresses[0] = (char *) &numeric;
+      numeric_addresses[1] = NULL;
+      numeric_host.h_name = (char *) nodename;
+      numeric_host.h_addrtype = AF_INET;
+      numeric_host.h_length = sizeof numeric;
+      numeric_host.h_addr_list = numeric_addresses;
+      he = &numeric_host;
+    }
+  else
+    he = gethostbyname (nodename);
+# else
+  /* FIXME: Use gethostbyname_r if available. */
+  struct hostent *he = gethostbyname (nodename);
+# endif
+  if (!he || he->h_addr_list[0] == NULL)
+    return EAI_NONAME;
+
+  size_t size;
+  switch (he->h_addrtype)
+    {
+# if HAVE_IPV6
+    case PF_INET6:
+      size = sizeof (struct v6_pair);
+      break;
+# endif
+
+# if HAVE_IPV4
+    case PF_INET:
+      size = sizeof (struct v4_pair);
+      break;
+# endif
+
+    default:
+      return EAI_NODATA;
+    }
+
+  void *storage = calloc (1, size);
+  if (!storage)
+    return EAI_MEMORY;
+
