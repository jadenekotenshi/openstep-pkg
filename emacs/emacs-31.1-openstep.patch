+    case TCIFLUSH: mask = 1; break; /* FREAD */
+    case TCOFLUSH: mask = 2; break; /* FWRITE */
+    case TCIOFLUSH: mask = 3; break;
+    default: errno = EINVAL; return -1;
+    }
+  return ioctl (fd, TIOCFLUSH, &mask);
