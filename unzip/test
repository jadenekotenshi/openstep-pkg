printf '%b' '\0120\0113\0003\0004\0024\0000\0000\0000\0010\0000\0000\0000\0041\0134\0270\0105\0070\0247\0031\0000\0000\0000\0027\0000\0000\0000\0010\0000\0000\0000\0144\0145\0146\0154\0141\0164\0145\0144\0363\0017\0160\0365\0013\0016\0161\0015\0120\0050\0315\0253\0312\0054\0120\0110\0313\0254\0050\0051\0055\0112\0345\0002\0000\0120\0113\0003\0004\0056\0000\0000\0000\0014\0000\0000\0000\0041\0134\0270\0105\0070\0247\0104\0000\0000\0000\0027\0000\0000\0000\0005\0000\0000\0000\0142\0172\0151\0160\0062\0102\0132\0150\0071\0061\0101\0131\0046\0123\0131\0035\0347\0324\0334\0000\0000\0003\0127\0200\0000\0020\0100\0000\0002\0001\0314\0000\0003\0041\0126\0120\0040\0000\0061\0115\0062\0061\0061\0061\0012\0150\0150\0364\0230\0207\0250\0043\0124\0154\0252\0000\0323\0263\0036\0342\0025\0070\0077\0027\0162\0105\0070\0120\0220\0035\0347\0324\0334\0120\0113\0001\0002\0024\0000\0024\0000\0000\0000\0010\0000\0000\0000\0041\0134\0270\0105\0070\0247\0031\0000\0000\0000\0027\0000\0000\0000\0010\0000\0000\0000\0000\0000\0000\0000\0000\0000\0000\0000\0200\0001\0000\0000\0000\0000\0144\0145\0146\0154\0141\0164\0145\0144\0120\0113\0001\0002\0056\0000\0056\0000\0000\0000\0014\0000\0000\0000\0041\0134\0270\0105\0070\0247\0104\0000\0000\0000\0027\0000\0000\0000\0005\0000\0000\0000\0000\0000\0000\0000\0000\0000\0000\0000\0200\0001\0077\0000\0000\0000\0142\0172\0151\0160\0062\0120\0113\0005\0006\0000\0000\0000\0000\0002\0000\0002\0000\0151\0000\0000\0000\0246\0000\0000\0000\0000\0000' > fixture.zip
"$PREFIX/bin/unzip" -t fixture.zip
"$PREFIX/bin/unzip" -q fixture.zip
cmp expected deflated
cmp expected bzip2
"$PREFIX/bin/funzip" fixture.zip > output
cmp expected output
"$PREFIX/bin/zipinfo" -1 fixture.zip > names
test "`wc -l < names`" -eq 2
"$PREFIX/bin/zipgrep" OPENSTEP fixture.zip > matches
test "`wc -l < matches`" -eq 2
printf 'not a zip\n' > invalid.zip
if "$PREFIX/bin/unzip" -t invalid.zip >/dev/null 2>&1; then exit 1; fi
