 static const char *l_str2dloc (const char *s, lua_Number *result, int mode) {
   char *endptr;
+#if defined(NeXT)
+  /* NeXT strtod accepts empty mantissas and incomplete exponents. */
+  if (mode != 'x') {
+    const char *p = s;
+    int digits = 0;
+    while (lisspace(cast_uchar(*p))) p++;
+    isneg(&p);
+    while (lisdigit(cast_uchar(*p))) { p++; digits++; }
+    if (*p == lua_getlocaledecpoint()) {
+      p++;
+      while (lisdigit(cast_uchar(*p))) { p++; digits++; }
+    }
+    if (digits == 0) return NULL;
+    if (*p == 'e' || *p == 'E') {
+      p++;
+      isneg(&p);
+      if (!lisdigit(cast_uchar(*p))) return NULL;
+      while (lisdigit(cast_uchar(*p))) p++;
+    }
+    while (lisspace(cast_uchar(*p))) p++;
+    if (*p != '\0') return NULL;
+  }
+#endif
   *result = (mode == 'x') ? lua_strx2number(s, &endptr)  /* try to convert */
                           : lua_str2number(s, &endptr);
   if (endptr == s) return NULL;  /* nothing recognized? */
