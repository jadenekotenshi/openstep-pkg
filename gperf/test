#!/bin/sh

set -e

GPERF="$LOCAL_ROOT/bin/gperf"
TMPDIR=/tmp/gperf-test-$$

test -x "$GPERF"
mkdir "$TMPDIR"
trap 'rm -rf "$TMPDIR"' 0 1 2 3 15

"$GPERF" --version >/dev/null

{
  echo '%{'
  echo '#include <string.h>'
  echo '%}'
  echo 'struct word { const char *name; int token; };'
  echo '%%'
  echo 'alpha, 1'
  echo 'beta, 2'
} > "$TMPDIR/conftest.gperf"

"$GPERF" --struct-type --language=ANSI-C \
  --lookup-function-name=in_word_set "$TMPDIR/conftest.gperf" \
  > "$TMPDIR/conftest.c"
cat >> "$TMPDIR/conftest.c" <<'EOF'
int main(void)
{
    const struct word *word;
    word = in_word_set("alpha", 5);
    if (!word || word->token != 1) return 1;
    word = in_word_set("beta", 4);
    if (!word || word->token != 2) return 2;
    return in_word_set("missing", 7) != 0;
}
EOF
/bin/cc "$TMPDIR/conftest.c" -o "$TMPDIR/conftest"
"$TMPDIR/conftest"
