#!/bin/sh
set -e
DESTDIR=$1
VERSION=$2
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin
export PATH
# perl's makefile makes gnumake use a lot of stack and heap; on x86 it was dying
# with memory faults.  Raise the soft limits as far as the hard limits allow (a
# shell without ulimit, or one that refuses, just keeps its defaults).
for res in s d; do
    ulimit -$res unlimited > /dev/null 2>&1 ||
        ulimit -$res `ulimit -H -$res 2>/dev/null` > /dev/null 2>&1 || :
done
echo "perl: stack limit `ulimit -s 2>&1`, data limit `ulimit -d 2>&1`"
if test -d "perl-$VERSION"; then cd "perl-$VERSION"; fi
. "$PKG_BUILD_HELPERS"
pkg_apply_patch "perl-$VERSION-openstep.patch"
# The 68k libc has the stdio.h macro fileno() but no function of that name, and some of
# perl's code calls the function (miniperl failed to link with _fileno undefined).  Define
# it in util.c, which every perl binary links.
if [ "$PKG_ARCH" = m68k ] && ! /bin/grep 'return fp->_file;' util.c > /dev/null; then
    /bin/cat >> util.c <<'FEOF'

/* OPENSTEP on the 68k: only the stdio.h macro exists, not the function */
#ifdef fileno
#undef fileno
#endif
int
fileno(FILE *fp)
{
    return fp->_file;
}
FEOF
fi
# PERL_SYSMALLOC=1 in the environment builds perl with the system malloc instead of
# perl's own (which this system's hints select, with an sbrk emulation); ext/Encode's
# enc2xs has died with a bus error on the first make, on x86 and on the 68k.
sysmalloc=
if [ "${PERL_SYSMALLOC-}" = 1 ]; then
    sysmalloc=-Dusemymalloc=n
fi
perl_configure() {
# GCC 4.2 cannot emit usable PIC for this target; link the bundled XS modules.
/usr/local/bin/ksh ./Configure -des -O -Dprefix=/usr/local \
    -Dcc=/usr/local/bin/gcc-4.2 -Dld=/usr/local/bin/gcc-4.2 \
    -Accflags="$PKG_GCC42_ARCH_FLAGS" \
    -Dhintfile=next_4 -Dosname=next -Dosvers=4.2 \
    -Dmake=/bin/gnumake -Dsh=/usr/local/bin/ksh -Duseposix=true \
    -Uusedl -Duseshrplib=false -Dd_mmap=undef $sysmalloc \
    -Dldflags='-Wl,-prebind' \
    -Dccflags='-fno-common -DUSE_NEXT_CTYPE -DUSE_PERL_SBRK -DNX_CURRENT_COMPILER_RELEASE=400 -DNS_TARGET_MAJOR=4'
}
pkg_step configure perl_configure
# On x86 the first run of ext/Encode's enc2xs under this make has died with a
# bus error (make status 138) although the very same command passes when the
# make is repeated in the kept tree.  Record the environment so the failure can
# be reproduced by hand, and give the make one more try.
perl_made=0
for attempt in 1 2 3 4; do
    if /bin/gnumake; then
        perl_made=1
        break
    fi
    echo "perl: make failed (attempt $attempt); the environment and limits it ran with:"
    ulimit -a 2>&1 || :
    export 2>&1 || :
    echo "perl: running make once more"
done
if [ "$perl_made" != 1 ]; then
    echo "perl: make failed four times" >&2
    exit 1
fi
/bin/gnumake install DESTDIR="$DESTDIR"
/bin/ranlib "$DESTDIR/usr/local/lib/perl5/$VERSION/OPENSTEP-Mach/CORE/libperl.a"
