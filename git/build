#!/bin/sh
set -e
DESTDIR=$1
VERSION=$2
test -f Makefile || cd git-$VERSION
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin
CC=/usr/local/bin/gcc-4.2
# gcc-4.2 on SPARC has miscompiled other packages at -O2 and above (gzip's
# deflate.c, python's dictionary code), and git's pack index code failed there
# with "wrong index v2 file size", so SPARC builds git unoptimized.
# PKG_GIT_OPT overrides the optimization flags.
case $PKG_ARCH in
    sparc) git_opt=-O0 ;;
    *)     git_opt=-O2 ;;
esac
git_opt=${PKG_GIT_OPT-$git_opt}
CFLAGS="$PKG_GCC42_ARCH_FLAGS $git_opt "'-std=gnu99 -I/usr/local/include -Icompat/openstep'
LDFLAGS='-L/usr/local/lib'
CONFIG_SHELL=/usr/local/bin/ksh
SHELL_PATH=/usr/local/bin/ksh
GREP=/usr/local/bin/grep
AWK=/usr/local/bin/gawk

export PATH CC CFLAGS LDFLAGS CONFIG_SHELL SHELL_PATH GREP AWK

# Report what this machine and compiler say about byte order, and tell git's
# SHA-1 code (sha1dc) when the target is big-endian: its own detection looks
# for __BYTE_ORDER__ (gcc 4.6+) or <endian.h> macros that gcc 4.2 on OPENSTEP
# may not provide, and tigerbrew carries the same fix for big-endian PowerPC.
/bin/cat > endian-probe.c <<'EPEOF'
#include <stdio.h>
#include <sys/types.h>
#include <netinet/in.h>
int main(void)
{
    unsigned int x = 0x01020304;
    unsigned char *p = (unsigned char *) &x;
    printf("byte0=%d ntohl-identity=%d sizeof(int)=%d sizeof(long)=%d sizeof(off_t)=%d\n",
        p[0], ntohl(x) == x, (int) sizeof(int), (int) sizeof(long), (int) sizeof(off_t));
#ifdef __BYTE_ORDER__
    printf("__BYTE_ORDER__ defined\n");
#endif
#ifdef BYTE_ORDER
    printf("BYTE_ORDER=%d BIG_ENDIAN=%d\n", BYTE_ORDER, BIG_ENDIAN);
#endif
#ifdef __sparc
    printf("__sparc defined\n");
#endif
    return p[0] == 1 ? 3 : 0;
}
EPEOF
big_endian=0
if $CC $CFLAGS endian-probe.c -o endian-probe; then
    if ./endian-probe; then probe_rc=0; else probe_rc=$?; fi
    if test "$probe_rc" = 3; then big_endian=1; fi
fi
/bin/rm -f endian-probe endian-probe.c
if test "$big_endian" = 1; then
    echo "git: big-endian target, building with -DSHA1DC_FORCE_BIGENDIAN"
    CFLAGS="$CFLAGS -DSHA1DC_FORCE_BIGENDIAN"
    export CFLAGS
fi

. "$PKG_BUILD_HELPERS"
patch -p1 < "git-$VERSION-openstep.patch"
# Python is only used for git-p4; WITH_PYTHON=0 in pkg.conf builds without it.
if test "$WITH_PYTHON" = 0; then
    python_conf=--without-python
    python_make="NO_PYTHON=YesPlease"
else
    python_conf=--with-python=/usr/local/bin/python3.11
    python_make="NO_PYTHON= PYTHON_PATH=/usr/local/bin/python3.11"
fi
run_configure \
    --build=$PKG_TARGET \
    --host=$PKG_TARGET \
    --prefix=/usr/local \
    --with-shell=/usr/local/bin/ksh \
    --with-curl=/usr/local \
    --with-iconv=/usr/local \
    --with-openssl=/usr/local \
    --with-expat=/usr/local \
    $python_conf \
    --without-tcltk \
    --disable-pthreads

make_git() {
/usr/local/bin/gnumake -j2 \
    SHELL="$CONFIG_SHELL" \
    CC="$CC" \
    CFLAGS="$PKG_GCC42_ARCH_FLAGS $CFLAGS" \
    LDFLAGS="$LDFLAGS" \
    SHELL_PATH="$SHELL_PATH" \
    CURL_CONFIG=/usr/local/bin/curl-config \
    NO_GETTEXT=YesPlease \
    NO_PERL=YesPlease \
    $python_make \
    NO_TCLTK=YesPlease \
    NO_PTHREADS=YesPlease \
    NO_RUST=YesPlease \
    NO_POLL=YesPlease NO_MMAP=YesPlease \
    COMPUTE_HEADER_DEPENDENCIES=no \
    NEEDS_SOCKET= NEEDS_LIBGEN= CURL_LDFLAGS="-L/usr/local/lib -lcurl -lssl -lcrypto -lz" \
    MKDIR_WO_TRAILING_SLASH=YesPlease DEFAULT_PAGER=/usr/ucb/more DEFAULT_EDITOR=/usr/ucb/vi \
    ARFLAGS=rc OVERRIDE_STRDUP=YesPlease \
    uname_S=NeXT uname_M=$PKG_ARCH uname_R=4.2 uname_V=Mach uname_O=NeXT NO_SETITIMER= NO_PREAD=YesPlease CSPRNG_METHOD=openssl \
    NO_CURL= SOCKLEN_T= NO_INTTYPES_H= COCCI_GOALS= COCCI_GLOB= COCCI_TEST_RES= \
    INSTALL=/usr/local/bin/install INSTALL_STRIP=-s "$@"
}

echo "git: building with CC=$CC CFLAGS=$CFLAGS"
make_git
echo "git: GIT-CFLAGS used by the build:"
/bin/cat GIT-CFLAGS
# Known-answer check of the SHA-1 and object code before anything else runs: a
# wrong id here means byte order or compiler trouble, not a repository problem.
hello_id=`printf 'hello\n' | ./git hash-object --stdin`
if test "$hello_id" != ce013625030ba8dba906f756967f9e9ca394464a; then
    echo "git: hash-object gave $hello_id, expected ce013625030ba8dba906f756967f9e9ca394464a" >&2
    exit 1
fi
# Exercise the platform behavior that repository storage and child processes need.
"$CC" $PKG_GCC42_ARCH_FLAGS -O2 -Icompat/openstep -I/usr/local/include \
    compat/openstep-test.c compat/openstep.o compat/snprintf.o \
    compat/poll/poll.o ctype.o hex-ll.o \
    -L/usr/local/lib -lcurl -lssl -lcrypto -lz -o openstep-test
./openstep-test
# Static dependencies carry large symbol tables on this host.
# Strip the build copies as well to keep staged-install disk usage bounded.
make_git strip STRIP=/bin/strip STRIP_OPTS=
/bin/rm -f openstep-test
make_git install DESTDIR="$DESTDIR"
