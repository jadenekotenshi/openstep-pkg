#!/bin/sh
set -e
DESTDIR=$1
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin:$PATH
CC=/usr/local/bin/gcc-4.2
AR=/usr/local/lib/cctools/bin/ar
RANLIB=/usr/local/lib/cctools/bin/ranlib
export AR RANLIB
CFLAGS='-O2 -march=i486 -DNeXT'
CPPFLAGS=-I/usr/local/include
LDFLAGS=-L/usr/local/lib
export CPPFLAGS LDFLAGS
AWK=/usr/local/bin/gawk
GREP=/usr/local/bin/grep
EGREP='/usr/local/bin/grep -E'
export PATH CC CFLAGS AWK GREP EGREP
. "$PKG_BUILD_HELPERS"
if test -d "libmpeg2-$2"; then cd "libmpeg2-$2"; fi
patch -p1 < "libmpeg2-$2-openstep.patch"
run_configure --build=i386-next-openstep4 --prefix=/usr/local \
    --disable-shared --enable-static --disable-dependency-tracking
/bin/gnumake SHELL="$CONFIG_SHELL"
/bin/csh -f /usr/local/bin/sdl-fix-macho-i486-subtype src/mpeg2dec
/bin/gnumake SHELL="$CONFIG_SHELL" install DESTDIR="$DESTDIR"
"$RANLIB" "$DESTDIR/usr/local/lib/libmpeg2.a"
"$RANLIB" "$DESTDIR/usr/local/lib/libmpeg2convert.a"
