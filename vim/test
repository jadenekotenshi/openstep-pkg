#!/bin/sh
set -e
work=${TMPDIR-/tmp}/vim-pkg-test-$$
mkdir "$work"
trap 'result=$?; set +e; if test "$result" -ne 0; then cat "$work/errors.log" 2>/dev/null; tail -30 "$work/script.log" 2>/dev/null; tail -c 3000 "$work/terminal.log" 2>/dev/null; fi; rm -rf "$work"; exit "$result"' 0
trap 'exit 1' 1 2 3 15
HOME=$work
TERM=xterm
TERMINFO="$LOCAL_ROOT/share/terminfo"
VIM_TEST_VIM9="$work/vim9.vim"
export HOME TERM TERMINFO VIM_TEST_VIM9
unset VIM VIMRUNTIME || :
vim="$LOCAL_ROOT/bin/vim"
"$vim" --version
"$LOCAL_ROOT/bin/vimtutor" --help > "$work/tutor-help"
test -s "$work/tutor-help"
test -f "$LOCAL_ROOT/share/man/man1/vim.1"
test -f "$LOCAL_ROOT/share/vim/vim92/doc/help.txt"
test -f "$LOCAL_ROOT/share/vim/vim92/tutor/en/vim-01-beginner.tutor"
test -x "$LOCAL_ROOT/bin/vimdiff"
echo 'xxd round trip' > "$work/xxd.in"
"$LOCAL_ROOT/bin/xxd" "$work/xxd.in" > "$work/xxd.hex"
"$LOCAL_ROOT/bin/xxd" -r "$work/xxd.hex" > "$work/xxd.out"
cmp "$work/xxd.in" "$work/xxd.out"
cat > "$work/smoke.vim" <<'VIM_TEST_EOF'
set nocompatible nomore
set encoding=utf-8
set shell=/usr/local/bin/ksh
let &shellredir = '>%s 2>&1'
call assert_equal(1, has('eval'))
call assert_equal(1, has('multi_byte'))
call assert_equal(1, has('terminal'))
call assert_equal(1, has('job'))
call assert_equal(1, has('timers'))
call assert_equal(4, strchars('café'))
call assert_equal(['a', 'b', 'c'], sort(['c', 'a', 'b']))
call assert_equal(['a', 'b', 'c'], sort(['c', 'a', 'b'], 'l'))
call assert_equal(3.0, sqrt(9.0))
call assert_equal(1, isinf(1.0 / 0.0))
call assert_equal(1, isnan(0.0 / 0.0))
call assert_equal({'a': [1, 2]}, json_decode(json_encode({'a': [1, 2]})))
call assert_equal('00e9', printf('%04x', char2nr('é')))
call assert_equal('9223372036854775807', printf('%d', 0x7fffffffffffffff))
call assert_equal('-9223372036854775808', printf('%d', -0x7fffffffffffffff - 1))
call assert_equal('0xffffffffffffffff', printf('%#x', -1))
call assert_equal('18446744073709551615', printf('%u', -1))
call assert_equal('-0000042', printf('%08d', -42))
call assert_equal("caf\xe9", iconv('café', 'utf-8', 'latin1'))
new
call setline(1, ['alpha beta', 'second line'])
%s/beta/Vim/g
call assert_equal('alpha Vim', getline(1))
write! edited.txt
call assert_equal(['alpha Vim', 'second line'], readfile('edited.txt'))
call assert_equal(['edited.txt'], glob('edited.*', 0, 1))
call assert_match('shell-ok', system('/bin/echo shell-ok'))
let g:timer_fired = 0
func TimerFired(id)
  let g:timer_fired = 1
endfunc
call timer_start(20, 'TimerFired')
sleep 100m
call assert_equal(1, g:timer_fired)
new
call setline(1, ['aaa', repeat('abc ', 200), 'ccc'])
for attempt in range(5)
  call cursor(1, 1)
  let started = reltime()
  call assert_equal(0, search('\%#=1a*.*X\@<=b*', 'W', 0, 20))
  call assert_inrange(0.01, 1.0, reltimefloat(reltime(started)))
  call assert_equal(3, search('ccc', 'W', 0, 1000))
  sleep 30m
endfor
bwipe!
let job = job_start(['/bin/echo', 'job-ok'], {'out_io': 'file', 'out_name': 'job.txt'})
for attempt in range(100)
  if job_status(job) !=# 'run' | break | endif
  sleep 20m
endfor
call assert_equal('dead', job_status(job))
call assert_equal(0, job_info(job).exitval)
call assert_equal(['job-ok'], readfile('job.txt'))
let termbuf = term_start(['/bin/echo', 'terminal-ok'], {'hidden': 1})
call assert_notequal(0, termbuf)
for attempt in range(100)
  call term_wait(termbuf, 20)
  if job_status(term_getjob(termbuf)) !=# 'run' | break | endif
endfor
call assert_equal('dead', job_status(term_getjob(termbuf)))
call assert_match('terminal-ok', term_getline(termbuf, 1))
call delete('terminal-input.txt')
let shellbuf = term_start(['/usr/local/bin/ksh', '-i'], {'hidden': 1})
let shelljob = term_getjob(shellbuf)
call term_wait(shellbuf, 1000)
call term_sendkeys(shellbuf, "/bin/echo terminal-input > terminal-input.txt; /bin/echo controlling-tty > /dev/tty; exit\r")
for attempt in range(200)
  call term_wait(shellbuf, 20)
  if job_status(shelljob) !=# 'run' | break | endif
endfor
call assert_equal('dead', job_status(shelljob))
call job_stop(shelljob, 'kill')
call assert_equal(['terminal-input'], readfile('terminal-input.txt'))
let ttylines = []
for row in range(1, 24)
  call add(ttylines, term_getline(shellbuf, row))
endfor
call assert_true(index(ttylines, 'controlling-tty') >= 0)
enew!
syntax on
setfiletype c
call assert_equal('c', b:current_syntax)
help usr_01.txt
call assert_equal('usr_01.txt', expand('%:t'))
execute 'source ' . fnameescape($VIM_TEST_VIM9)
call writefile(v:errors, 'errors.log')
if !empty(v:errors)
  cquit
endif
call writefile(['Vim editing, UTF-8, sort, math, JSON, iconv, shell, timer, job, terminal and Vim9 tests passed'], 'success.log')
qa!

VIM_TEST_EOF
cat > "$work/vim9.vim" <<'VIM_TEST_EOF'
vim9script
def Sum(values: list<number>): number
  var total = 0
  for value in values
    total += value
  endfor
  return total
enddef
assert_equal(6, Sum([1, 2, 3]))

VIM_TEST_EOF
cat > "$work/pty-test.c" <<'VIM_TEST_EOF'
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <libc.h>
#include <fcntl.h>
#include <signal.h>
#include <sys/ioctl.h>
#include <sys/wait.h>

static int master, child;
static FILE *transcript;

static void cleanup(void)
{
    if (child > 0) {
        kill(child, SIGKILL);
        wait4(child, NULL, 0, NULL);
        child = 0;
    }
}

static void fail(const char *message)
{
    fprintf(stderr, "Vim PTY test: %s\n", message);
    cleanup();
    exit(1);
}

static void pump(int tenths)
{
    char buffer[4096];
    int i, count;
    for (i = 0; i < tenths; i++) {
        while ((count = read(master, buffer, sizeof(buffer))) > 0)
            fwrite(buffer, 1, count, transcript);
        fflush(transcript);
        usleep(100000);
    }
}

static void keys(const char *text)
{
    int length = strlen(text);
    if (write(master, text, length) != length)
        fail("could not send input");
    pump(4);
}

static void start(const char *vim, const char *filename)
{
    char device[] = "/dev/ptyp0";
    const char *bank, *unit;
    struct winsize size;
    int fd, found = 0;
    for (bank = "pqrs"; *bank && !found; bank++) {
        for (unit = "0123456789abcdef"; *unit; unit++) {
            device[8] = *bank;
            device[9] = *unit;
            master = open(device, O_RDWR);
            if (master >= 0) { found = 1; break; }
        }
    }
    if (!found)
        fail("no free BSD pseudo-terminal");
    memset(&size, 0, sizeof(size));
    size.ws_row = 24;
    size.ws_col = 80;
    ioctl(master, TIOCSWINSZ, &size);
    device[5] = 't';
    child = fork();
    if (child < 0)
        fail("fork failed");
    if (child == 0) {
        close(master);
        fd = open("/dev/tty", O_RDWR);
        if (fd >= 0) {
            ioctl(fd, TIOCNOTTY, 0);
            close(fd);
        }
        setpgrp(0, getpid());
        fd = open(device, O_RDWR);
        if (fd < 0) _exit(126);
        dup2(fd, 0);
        dup2(fd, 1);
        dup2(fd, 2);
        if (fd > 2) close(fd);
        execl(vim, vim, "-Nu", "NONE", "-i", "NONE", "-n", "-N", filename, (char *)0);
        _exit(127);
    }
    fcntl(master, F_SETFL, FNDELAY);
    pump(15);
}

static void finish(int expected)
{
    union wait status;
    int i, result;
    for (i = 0; i < 100; i++) {
        pump(1);
        result = wait4(child, &status, WNOHANG, NULL);
        if (result == child) {
            child = 0;
            close(master);
            if (!WIFEXITED(status) || status.w_retcode != expected)
                fail("unexpected editor exit status");
            return;
        }
    }
    fail("editor did not exit");
}

static void contents(const char *filename, const char *expected)
{
    char buffer[4096];
    FILE *file = fopen(filename, "rb");
    size_t count;
    if (!file) fail("output file missing");
    count = fread(buffer, 1, sizeof(buffer) - 1, file);
    buffer[count] = 0;
    fclose(file);
    if (strcmp(buffer, expected)) {
        fprintf(stderr, "Unexpected contents in %s: <%s>\n", filename, buffer);
        fail("saved text differs");
    }
}

int main(int argc, char **argv)
{
    char filename[1024];
    struct winsize size;
    union wait status;
    int i, stopped = 0;
    if (argc != 3) return 2;
    transcript = fopen("terminal.log", "w");
    if (!transcript) return 2;
    sprintf(filename, "%s/edit.txt", argv[2]);
    unlink(filename);
    start(argv[1], filename);
    keys("ialpha beta\rsecond line\033");
    keys(":wq\r");
    finish(0);
    contents(filename, "alpha beta\nsecond line\n");

    start(argv[1], filename);
    keys("/beta\rceVim\033");
    keys("u");
    keys("\022");
    keys("GoUTF-8: caf\303\251\033");
    memset(&size, 0, sizeof(size));
    size.ws_row = 30; size.ws_col = 100;
    ioctl(master, TIOCSWINSZ, &size);
    kill(child, SIGWINCH);
    pump(10);
    keys("\032");
    for (i = 0; i < 30; i++) {
        if (wait4(child, &status, WNOHANG | WUNTRACED, NULL) == child) {
            if (WIFSTOPPED(status)) { stopped = 1; break; }
            child = 0;
            fail("editor exited while suspending");
        }
        pump(1);
    }
    if (!stopped) fail("suspend did not stop editor");
    kill(child, SIGCONT);
    pump(10);
    keys(":wq\r");
    finish(0);
    contents(filename, "alpha Vim\nsecond line\nUTF-8: caf\303\251\n");
    fclose(transcript);
    puts("Vim PTY editing, search, undo/redo, UTF-8, resize and suspend/resume passed");
    return 0;
}

VIM_TEST_EOF
"$LOCAL_ROOT/bin/gcc-4.2" -I/NextDeveloper/Headers/bsd "$work/pty-test.c" -o "$work/pty-test"
cd "$work"
"$vim" -Nu NONE -i NONE -n -es -V1script.log -S smoke.vim
cat success.log
./pty-test "$vim" "$work"
