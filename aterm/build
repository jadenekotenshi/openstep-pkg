#!/bin/sh
set -e
DESTDIR=$1
VERSION=$2
PREFIX=/usr/local
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin:$PATH
CC="/usr/local/bin/gcc-4.2 $PKG_GCC42_ARCH_FLAGS"
CONFIG_SHELL=/usr/local/bin/ksh
GREP=/usr/local/bin/grep
EGREP='/usr/local/bin/grep -E'
AWK=/usr/local/bin/gawk
SED=/usr/local/bin/sed

# aterm needs the X11 development files.  X11_PREFIX in pkg.conf says where
# they live (default /usr/X11R6, where CubXWindow installs).
x11_prefix=
for d in $X11_PREFIX /usr/X11R6; do
    if test -n "$d" && test -f "$d/include/X11/Xlib.h"; then
        x11_prefix=$d
        break
    fi
done
if test -z "$x11_prefix"; then
    echo "aterm: cannot find X11/Xlib.h; install the X11 development files" >&2
    echo "aterm: and set X11_PREFIX in pkg.conf to the directory holding include/ and lib/" >&2
    exit 1
fi
echo "aterm: using X11 under $x11_prefix"
CFLAGS='-O2'
CPPFLAGS="-I$x11_prefix/include -I/usr/local/include"
LDFLAGS="-L$x11_prefix/lib -L/usr/local/lib"
export PATH CC CFLAGS CPPFLAGS LDFLAGS CONFIG_SHELL GREP EGREP AWK SED
if test -d "aterm-$VERSION"; then cd "aterm-$VERSION"; fi
. "$PKG_BUILD_HELPERS"

# OPENSTEP's libc may lack unsetenv(), which aterm calls unconditionally: if a
# program using it does not link, supply a private one (forced into every
# compile).
cat > probe_unsetenv.c <<'PEOF'
extern int unsetenv(const char *);
int main(void) { unsetenv("PKG_PROBE"); return 0; }
PEOF
if $CC probe_unsetenv.c -o probe_unsetenv > /dev/null 2>&1; then
    echo "aterm: unsetenv is available"
else
    echo "aterm: no unsetenv; using a private one"
    /bin/cat > aterm-compat.h <<'CEOF'
#ifndef ATERM_OPENSTEP_COMPAT_H
#define ATERM_OPENSTEP_COMPAT_H
#include <string.h>
extern char **environ;
static int
ostep_unsetenv(const char *name)
{
    char **src, **dst;
    size_t n = strlen(name);

    if (environ == 0)
        return 0;
    for (src = dst = environ; *src != 0; src++) {
        if (strncmp(*src, name, n) == 0 && (*src)[n] == '=')
            continue;
        *dst++ = *src;
    }
    *dst = 0;
    return 0;
}
#define unsetenv ostep_unsetenv
#endif
CEOF
    CFLAGS="$CFLAGS -include `pwd`/aterm-compat.h"
    export CFLAGS
fi
rm -f probe_unsetenv probe_unsetenv.c probe_unsetenv.o

# This libc has no waitpid(), setsid(), putenv() or the termios calls (cfsetispeed,
# cfsetospeed, tcgetattr, tcsetattr), which aterm uses; supply them on top of the
# BSD calls, as the vim and ntp packages do, and link the object into aterm.
/bin/cat > openstep_posix.c <<'PXEOF'
/* Rename the speed setters before any header is read, so a header prototype for
   them (whose parameter type differs) does not clash with ours. */
#define cfsetispeed hdr_cfsetispeed
#define cfsetospeed hdr_cfsetospeed
#include <sys/types.h>
#include <sys/ioctl.h>
#include <sys/file.h>
#include <fcntl.h>
#include <termios.h>
#undef cfsetispeed
#undef cfsetospeed
#include <errno.h>
#include <stdlib.h>
#include <string.h>

extern int wait4();
extern int setpgrp();
extern int getpid();
extern int close();
extern char **environ;

int
waitpid(int pid, int *status, int options)
{
    return wait4(pid, (void *) status, options, (void *) 0);
}

int
setsid(void)
{
    int fd;

    if (setpgrp(0, getpid()) < 0)
	return -1;
    fd = open("/dev/tty", O_RDWR);
    if (fd >= 0) {
	ioctl(fd, TIOCNOTTY, (char *) 0);
	close(fd);
    }
    return getpid();
}

int
tcgetattr(int fd, struct termios *t)
{
    return ioctl(fd, TIOCGETA, (char *) t);
}

int
tcsetattr(int fd, int actions, const struct termios *t)
{
    switch (actions) {
    case 0:	/* TCSANOW */
	return ioctl(fd, TIOCSETA, (char *) t);
    case 1:	/* TCSADRAIN */
	return ioctl(fd, TIOCSETAW, (char *) t);
    case 2:	/* TCSAFLUSH */
	return ioctl(fd, TIOCSETAF, (char *) t);
    }
    errno = EINVAL;
    return -1;
}

#ifdef HAVE_TERMIOS_SPEED_FIELDS
int
cfsetispeed(struct termios *t, unsigned long speed)
{
    t->c_ispeed = speed;
    return 0;
}

int
cfsetospeed(struct termios *t, unsigned long speed)
{
    t->c_ospeed = speed;
    return 0;
}
#else
int
cfsetispeed(struct termios *t, unsigned long speed)
{
    return 0;
}

int
cfsetospeed(struct termios *t, unsigned long speed)
{
    return 0;
}
#endif

/* putenv(): replace the variable if it is there, else grow environ by one. */
int
putenv(char *string)
{
    char *eq = strchr(string, '=');
    size_t n, count;
    char **e, **newenv;

    if (eq == 0) {
	errno = EINVAL;
	return -1;
    }
    n = eq - string;
    count = 0;
    for (e = environ; e != 0 && *e != 0; e++) {
	if (strncmp(*e, string, n) == 0 && (*e)[n] == '=') {
	    *e = string;
	    return 0;
	}
	count++;
    }
    newenv = (char **) malloc((count + 2) * sizeof(char *));
    if (newenv == 0) {
	errno = ENOMEM;
	return -1;
    }
    for (count = 0; environ != 0 && environ[count] != 0; count++)
	newenv[count] = environ[count];
    newenv[count++] = string;
    newenv[count] = 0;
    environ = newenv;
    return 0;
}
PXEOF
/bin/cat > probe_ts.c <<'PEOF'
#include <sys/types.h>
#include <termios.h>
int probe_f(struct termios *t) { t->c_ispeed = 0; t->c_ospeed = 0; return 0; }
PEOF
ts_def=
if $CC $CFLAGS -c probe_ts.c -o probe_ts.o > /dev/null 2>&1; then
    ts_def=-DHAVE_TERMIOS_SPEED_FIELDS
fi
/bin/rm -f probe_ts.c probe_ts.o
$CC $CFLAGS $ts_def -c openstep_posix.c -o openstep_posix.o
POSIX_OBJ="`pwd`/openstep_posix.o"

# The pixmap, JPEG and PNG support of the AfterStep libraries is left out; the
# scrollbar is the NeXT-style one (the default).  No utmp/wtmp logging: that
# needs root.  TERM is set to xterm: OPENSTEP's /etc/termcap has no rxvt entry
# (aterm -tn NAME or the termName resource still changes it).
run_configure --build=$PKG_TARGET --prefix="$PREFIX" \
    --x-includes="$x11_prefix/include" --x-libraries="$x11_prefix/lib" \
    --disable-aftersteplibs --without-jpeg --without-png \
    --disable-utmp --disable-wtmp \
    --with-term=xterm

# The Makefiles run their sub-makes in "for ... (cd dir; make || exit 1)" loops,
# which the stock sh does not stop on a failure: a compile error then looked like
# success.  Run each directory's make here, so a failure stops the build.
MKDIRP="/usr/local/bin/mkdir -p"
# (src/graphics is the separate grx client library, written for SysV ttys; aterm
# itself needs none of it.)
for dir in src doc; do
    (cd $dir && /usr/local/bin/gnumake "MKDIR=$MKDIRP" "LIBS=$POSIX_OBJ") || exit 1
done
test -f src/aterm || { echo "aterm: src/aterm was not built" >&2; exit 1; }

$MKDIRP "$DESTDIR$PREFIX/bin" "$DESTDIR$PREFIX/man/man1"
for dir in src doc; do
    (cd $dir && /usr/local/bin/gnumake "MKDIR=$MKDIRP" "LIBS=$POSIX_OBJ" install DESTDIR="$DESTDIR") || exit 1
done
test -x "$DESTDIR$PREFIX/bin/aterm" || { echo "aterm: the binary was not installed" >&2; exit 1; }
