#!/bin/sh
set -e
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin
export PATH
LR=${LOCAL_ROOT-/usr/local}
work=${TMPDIR-/tmp}/aterm-pkg-test-$$
mkdir "$work"
trap 'rm -rf "$work"' 0
trap 'exit 1' 1 2 3 15

# aterm needs an X display to run; check what can be checked without one.
test -x "$LR/bin/aterm"
"$LR/bin/aterm" -h > "$work/help" 2>&1 || :
grep -i 'usage' "$work/help" > /dev/null
test -f "$LR/man/man1/aterm.1" || test -f "$LR/share/man/man1/aterm.1"

# A Mach-O executable (magic 0xfeedface, in either byte order).
magic=`dd if="$LR/bin/aterm" bs=4 count=1 2>/dev/null | od -b | sed -n 1p | sed 's/^[0-9]* *//'`
magic=`echo $magic`
case "$magic" in
    "316 372 355 376"|"376 355 372 316") ;;
    *) echo "aterm: $LR/bin/aterm is not a Mach-O executable ($magic)" >&2; exit 1 ;;
esac
echo "aterm checks passed (the terminal itself needs an X display)"
