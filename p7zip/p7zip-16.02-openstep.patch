diff -ruN p7a/p7zip_16.02/makefile.openstep p7b/p7zip_16.02/makefile.openstep
--- a/makefile.openstep	1970-01-01 00:00:00.000000000 +0000
+++ b/makefile.openstep	2026-10-06 01:48:13.682147023 +0000
@@ -0,0 +1,23 @@
+#
+# makefile.machine for OPENSTEP (i386, sparc) with gcc-4.2, single-threaded.
+#
+# OPENSTEP_INC is the openstep/ directory of the source tree (pthread, wchar
+# and dirent stand-ins); PKG_GCC42_ARCH_FLAGS is the pkg architecture flag.
+
+OPTFLAGS=-O2 $(PKG_GCC42_ARCH_FLAGS)
+
+ALLFLAGS=${OPTFLAGS} -pipe \
+	-D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE \
+	-DNDEBUG -D_REENTRANT -DENV_UNIX -DENV_OPENSTEP -D_7ZIP_ST -DNeXT \
+	-DCLOCKS_PER_SEC=CLK_TCK \
+	-I$(OPENSTEP_INC) \
+	$(LOCAL_FLAGS)
+
+CXX=/usr/local/bin/g++-4.2
+CC=/usr/local/bin/gcc-4.2
+
+LOCAL_LIBS=
+LOCAL_LIBS_DLL=$(LOCAL_LIBS)
+
+OBJ_CRC32=$(OBJ_CRC32_C)
+OBJ_AES=
diff -ruN p7a/p7zip_16.02/openstep/dirent.h p7b/p7zip_16.02/openstep/dirent.h
--- a/openstep/dirent.h	1970-01-01 00:00:00.000000000 +0000
+++ b/openstep/dirent.h	2026-10-06 01:09:43.102827606 +0000
@@ -0,0 +1,13 @@
+/* OPENSTEP's libc returns the BSD "struct direct" from readdir() (d_name at a
+   different offset from SVID "struct dirent"), so use <sys/dir.h> and rename
+   the type.  */
+#ifndef P7ZIP_OPENSTEP_DIRENT_H
+#define P7ZIP_OPENSTEP_DIRENT_H
+#undef _POSIX_SOURCE
+#ifndef _NEXT_SOURCE
+# define _NEXT_SOURCE 1
+#endif
+#include <sys/types.h>
+#include <sys/dir.h>
+#define dirent direct
+#endif
diff -ruN p7a/p7zip_16.02/openstep/pthread.h p7b/p7zip_16.02/openstep/pthread.h
--- a/openstep/pthread.h	1970-01-01 00:00:00.000000000 +0000
+++ b/openstep/pthread.h	2026-10-06 01:09:43.102856035 +0000
@@ -0,0 +1,54 @@
+/* Single-thread stand-in for <pthread.h> on OPENSTEP, which has none.
+   p7zip is built with -D_7ZIP_ST, so no second thread ever exists: mutexes are
+   bookkeeping only, thread creation fails, and a condition wait (which could
+   never be satisfied) aborts instead of hanging.  */
+#ifndef P7ZIP_OPENSTEP_PTHREAD_H
+#define P7ZIP_OPENSTEP_PTHREAD_H
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+typedef struct { int locked; } pthread_mutex_t;
+typedef struct { int type; } pthread_mutexattr_t;
+typedef struct { int unused; } pthread_cond_t;
+typedef struct { int unused; } pthread_attr_t;
+typedef int pthread_t;
+
+#define PTHREAD_MUTEX_INITIALIZER { 0 }
+#define PTHREAD_MUTEX_NORMAL 0
+#define PTHREAD_MUTEX_ERRORCHECK 1
+#define PTHREAD_MUTEX_ERRORCHECK_NP PTHREAD_MUTEX_ERRORCHECK
+#define PTHREAD_CREATE_JOINABLE 0
+#define PTHREAD_CREATE_DETACHED 1
+
+static __inline__ int pthread_mutexattr_init(pthread_mutexattr_t *a) { a->type = 0; return 0; }
+static __inline__ int pthread_mutexattr_destroy(pthread_mutexattr_t *a) { (void)a; return 0; }
+static __inline__ int pthread_mutexattr_settype(pthread_mutexattr_t *a, int t) { a->type = t; return 0; }
+static __inline__ int pthread_mutex_init(pthread_mutex_t *m, const pthread_mutexattr_t *a) { (void)a; m->locked = 0; return 0; }
+static __inline__ int pthread_mutex_destroy(pthread_mutex_t *m) { (void)m; return 0; }
+static __inline__ int pthread_mutex_lock(pthread_mutex_t *m) { m->locked = 1; return 0; }
+static __inline__ int pthread_mutex_unlock(pthread_mutex_t *m) { m->locked = 0; return 0; }
+
+static __inline__ int pthread_cond_init(pthread_cond_t *c, const void *a) { (void)c; (void)a; return 0; }
+static __inline__ int pthread_cond_destroy(pthread_cond_t *c) { (void)c; return 0; }
+static __inline__ int pthread_cond_broadcast(pthread_cond_t *c) { (void)c; return 0; }
+static __inline__ int pthread_cond_signal(pthread_cond_t *c) { (void)c; return 0; }
+static __inline__ int pthread_cond_wait(pthread_cond_t *c, pthread_mutex_t *m)
+{
+  (void)c; (void)m;
+  fprintf(stderr, "p7zip: waited on a condition in a single-threaded build\n");
+  abort();
+  return 0;
+}
+
+static __inline__ pthread_t pthread_self(void) { return 1; }
+static __inline__ int pthread_attr_init(pthread_attr_t *a) { (void)a; return 0; }
+static __inline__ int pthread_attr_destroy(pthread_attr_t *a) { (void)a; return 0; }
+static __inline__ int pthread_attr_setdetachstate(pthread_attr_t *a, int s) { (void)a; (void)s; return 0; }
+static __inline__ int pthread_create(pthread_t *t, const pthread_attr_t *a, void *(*f)(void *), void *arg)
+{ (void)t; (void)a; (void)f; (void)arg; return EAGAIN; }
+static __inline__ int pthread_join(pthread_t t, void **r) { (void)t; (void)r; return ESRCH; }
+static __inline__ int pthread_detach(pthread_t t) { (void)t; return ESRCH; }
+
+#endif
diff -ruN p7a/p7zip_16.02/openstep/wchar.h p7b/p7zip_16.02/openstep/wchar.h
--- a/openstep/wchar.h	1970-01-01 00:00:00.000000000 +0000
