# pkg site configuration.  Copy to /usr/local/etc/pkg.conf (or point PKG_CONF at
# it).  This is a plain sh file; every option is optional.

# Set to 1 if an X11 server such as CubXWindow and its development headers and
# libraries are installed.  Packages that can use X11 check this.
HAVE_X11=0

# Directory holding the X11 include/ and lib/ directories.  CubXWindow installs
# under /usr/X11R6, which is the default.
X11_PREFIX=/usr/X11R6

# 1 (default) builds optional Python support, which makes git depend on the
# python311 package (for git-p4).  Set 0 to build git without Python, for example
# on a machine where python311 does not build yet.
WITH_PYTHON=1

# 1 strips the symbols from every executable as it is installed (and before a
# binary package is written).  "pkg install-strip NAME" and "pkg strip NAME"
# do it for single packages without this.
STRIP_BINARIES=0

# The strip to run, and its flags.  -x keeps the global symbols, which programs
# that load code at run time (python, emacs) need.
#STRIP_PROGRAM=/bin/strip
#STRIP_FLAGS=-x

# 1 symlinks every .app bundle a package installs in /usr/local/Apps from
# APPS_LINK_DIR, so that the Workspace Manager lists it with the local
# applications.  The links are part of the package: "pkg remove" deletes them.
LINK_APPS=0

# The directory the links go in.
#APPS_LINK_DIR=/LocalApps

# 1 also makes a NeXT package (.pkg) of every package that knows how (it has a
# "nextpkg" script) when it is built.  The packages go in NEXT_PACKAGES_DIR and are
# kept when the package is removed.  "pkg --next-packages install NAME" does it once.
NEXT_PACKAGES=0

# Where the NeXT packages are put.
#NEXT_PACKAGES_DIR=/usr/local/var/pkg/NeXTpackages
