#!/bin/sh
set -e
DESTDIR=$1
VERSION=$2
PREFIX=/usr/local
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin
CC="/usr/local/bin/gcc-4.2 $PKG_GCC42_ARCH_FLAGS -std=gnu99"
# On i386 the archives and objects come from the cctools tools; a gcc42 built
# before the cctools package needs the specs file to pick the right linker.
if [ "$PKG_ARCH" = i386 ] && [ -f /usr/local/lib/cctools/gcc42.specs ]; then
    CC="$CC -specs=/usr/local/lib/cctools/gcc42.specs"
fi
export PATH CC
# GitHub's archive unpacks as HackEM-<commit>
for d in HackEM-*; do
    if test -d "$d"; then cd "$d"; break; fi
done
. "$PKG_BUILD_HELPERS"

# Hack'EM is built on HackEM (NetHack 3.6), so it is set up the way the nethack package
# does it: OPENSTEP is treated as a BSD system with termcap and no POSIX job control
# or types.  The rewritten lines are checked below.
# Everything up to the build itself is one step: a resumed build (PKG_RESUME=1) skips it
# once it has succeeded, so the files it edited are not touched again and only what
# changed is recompiled; PKG_REDO=prepare runs it again.
hackem_prepare() {
/bin/sed \
    -e 's|^/\* #define BSD 1 \*/|#define BSD 1|' \
    -e 's|^#define SYSV[ 	]|#undef SYSV |' \
    -e 's|^#define SVR4[ 	]|#undef SVR4 |' \
    -e 's|^#define LINUX[ 	]|#undef LINUX |' \
    -e 's|^#define TERMINFO[ 	]|#undef TERMINFO |' \
    -e 's|^#define POSIX_JOB_CONTROL[ 	]|#undef POSIX_JOB_CONTROL |' \
    -e 's|^#define POSIX_TYPES[ 	]|#undef POSIX_TYPES |' \
    include/unixconf.h > include/unixconf.h.new
/bin/mv include/unixconf.h.new include/unixconf.h
/bin/grep '^#define BSD 1' include/unixconf.h > /dev/null
/bin/grep '^#undef SYSV' include/unixconf.h > /dev/null
/bin/grep '^#undef POSIX_TYPES' include/unixconf.h > /dev/null
/bin/grep '^#undef TERMINFO' include/unixconf.h > /dev/null

# This libc lacks snprintf(), vsnprintf(), strdup() and getcwd() (getwd() takes a
# MAXPATHLEN buffer), and may lack some types.  A private include directory and a
# header read with -include supply them as static code, so nothing needs linking.
# The directory is not called "openstep": make would take that for a target.
inc=`pwd`/ostep-inc
/usr/local/bin/mkdir -p ostep-inc
/bin/cp snprintf-shim.h ostep-inc/snprintf-shim.h
/bin/cat > ostep-inc/stdint.h <<'SEOF'
#ifndef OPENSTEP_STDINT_H
#define OPENSTEP_STDINT_H
#include <sys/types.h>
typedef signed char int8_t;
typedef short int16_t;
typedef int int32_t;
typedef long long int64_t;
typedef unsigned char uint8_t;
typedef unsigned short uint16_t;
typedef unsigned int uint32_t;
typedef unsigned long long uint64_t;
typedef long intptr_t;
typedef unsigned long uintptr_t;
#define INT32_MAX 2147483647
#define UINT32_MAX 4294967295U
#define UINT64_MAX 18446744073709551615ULL
#endif
SEOF
/bin/cat > ostep-inc/inttypes.h <<'SEOF'
#ifndef OPENSTEP_INTTYPES_H
#define OPENSTEP_INTTYPES_H
#include <stdint.h>
#define PRId32 "d"
#define PRIu32 "u"
#define PRIx32 "x"
#define PRId64 "lld"
#define PRIu64 "llu"
#define PRIx64 "llx"
#endif
SEOF
# Types the <sys/types.h> may lack (probed, since a duplicate typedef is an error too).
: > ostep-inc/types-extra.h
for t in pid_t uid_t gid_t mode_t ssize_t; do
    {
        echo '#include <sys/types.h>'
        echo "$t probe_var;"
    } > probe.c
    if $CC -c probe.c -o probe.o 2> /dev/null; then :; else
        echo "typedef int $t;" >> ostep-inc/types-extra.h
    fi
done
/bin/cat > ostep-inc/hackem-compat.h <<'HEOF'
#ifndef OPENSTEP_EVILHACK_H
#define OPENSTEP_EVILHACK_H
#include <sys/types.h>
#include <sys/param.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <sys/time.h>
#ifndef PATH_MAX
#define PATH_MAX 1024
#endif
#include "types-extra.h"
#include <sys/stat.h>
#ifndef S_IRUSR
# define S_IRUSR 0000400
# define S_IWUSR 0000200
# define S_IXUSR 0000100
# define S_IRGRP 0000040
# define S_IWGRP 0000020
# define S_IXGRP 0000010
# define S_IROTH 0000004
# define S_IWOTH 0000002
# define S_IXOTH 0000001
#endif
#include "snprintf-shim.h"
static char *
ostep_strdup(const char *s)
{
    size_t n = strlen(s) + 1;
    char *p = (char *) malloc(n);

    if (p != 0)
	memcpy(p, s, n);
    return p;
}
#define strdup ostep_strdup
extern char *getwd();
#define getcwd(buf, size) getwd(buf)
#endif
HEOF

# SPARC and m68k libc compare bytes as signed in memcmp(), strcmp() and strncmp(); the
# unsigned versions are forced into the game's code (empty on x86).
CMPFLAGS=`pkg_cmp_shim "\`pwd\`/ostep-cmp"`
# Optimization level.  HACKEM_OPT in the environment overrides it.  On the 68k the
# assembler cannot encode a displacement of more than 32K ("Fixup ... too large for field
# width of 2"): gcc's switch jump tables there hold 16-bit offsets, and a big function
# (mhitm.c has some) spreads a table further than that.  -fno-jump-tables (Apple's gcc 4.2
# has it) compiles those switches as branches, which the assembler can lengthen; -O1
# without the inlining of once-called functions keeps the functions smaller.
OPT=${HACKEM_OPT-}
if [ -z "$OPT" ]; then
    case "$PKG_ARCH" in
        m68k) OPT="-O1 -fno-inline-functions-called-once -fno-jump-tables" ;;
        *) OPT=-O2 ;;
    esac
fi
hints=sys/unix/hints/openstep
/bin/cat > "$hints" <<HEOF
#-PRE
# OPENSTEP hints (generated by the pkg build script)
PREFIX=$PREFIX
HACKDIR=\$(PREFIX)/lib/\$(GAME)dir
INSTDIR=\$(DESTDIR)\$(HACKDIR)
VARDIR=\$(DESTDIR)\$(HACKDIR)
SHELLDIR=\$(DESTDIR)\$(PREFIX)/bin

POSTINSTALL=cp sys/unix/sysconf \$(INSTDIR)/sysconf; chmod 644 \$(INSTDIR)/sysconf

CFLAGS=$OPT -I../include -I$inc -include $inc/hackem-compat.h $CMPFLAGS -I/usr/local/include/ncurses -DNeXT -DNOTPARMDECL -DYYMALLOC=malloc -DYYFREE=free
# ncurses' <term.h> (which termcap.c includes) declares tputs() itself; the game's own
# prototype for it must stay out of the way.
CFLAGS+=-DHAVE_TPUTS
# pline.c defines replace() and piratesay() only when DUMPLOG is on, but other files use
# them unconditionally (a bug upstream; the public server's build always has DUMPLOG).
# Without a DUMPLOGFILE in the sysconf no dump files are written.
CFLAGS+=-DDUMPLOG
CFLAGS+=-DDLB -DTIMED_DELAY
CFLAGS+=-DCOMPRESS=\\"/usr/local/bin/gzip\\" -DCOMPRESS_EXTENSION=\\".gz\\"
CFLAGS+=-DSYSCF -DSYSCF_FILE=\\"\$(HACKDIR)/sysconf\\"
CFLAGS+=-DHACKDIR=\\"\$(HACKDIR)\\"
CFLAGS+=-DCURSES_GRAPHICS
LINK=\$(CC)

WINSRC = \$(WINTTYSRC) \$(WINCURSESSRC)
WINOBJ = \$(WINTTYOBJ) \$(WINCURSESOBJ)
WINLIB = \$(WINTTYLIB) \$(WINCURSESLIB)
WINTTYLIB = -L/usr/local/lib -lncurses

CHOWN=true
CHGRP=true
ROOTCHECK=true
DIRPERM = 0755
FILEPERM = 0644
EXEPERM = 0755
GAMEPERM = 0755
VARDIRPERM = 0777
VARFILEPERM = 0666
HEOF

/bin/sh sys/unix/setup.sh sys/unix/hints/openstep

# Makefile.src wants a wide-character ncurses; this one is not.  The ncurses link is
# in WINTTYLIB (it includes termcap).  NetHack's own pattern matcher is used instead
# of the system regcomp(); this has to be set in the generated makefile because the
# object list is read early.
/bin/sed \
    -e 's|^WINCURSESLIB = .*|WINCURSESLIB =|' \
    -e 's/^REGEXOBJ = posixregex.o/REGEXOBJ = pmatchregex.o/' \
    src/Makefile > src/Makefile.new
/bin/mv src/Makefile.new src/Makefile
/bin/grep '^REGEXOBJ = pmatchregex.o' src/Makefile > /dev/null
/bin/grep '^WINCURSESLIB =$' src/Makefile > /dev/null

# bison and flex generate the level and dungeon compilers; the old Bourne /bin/sh
# treats an unquoted ^ as a pipe, so dat/Makefile's grep patterns are quoted.
/bin/sed \
    -e 's|^YACC *=.*|YACC = /usr/local/bin/bison -y|' \
    -e 's|^LEX *=.*|LEX = /usr/local/bin/flex|' \
    util/Makefile > util/Makefile.new
/bin/mv util/Makefile.new util/Makefile
/bin/grep '^YACC = /usr/local/bin/bison' util/Makefile > /dev/null
/bin/cat > nh-fix.sed <<'FEOF'
s/grep ^#define/grep '^#define'/
s/grep -v ^#define/grep -v '^#define'/
FEOF
/bin/sed -f nh-fix.sed dat/Makefile > dat/Makefile.new
/bin/mv dat/Makefile.new dat/Makefile
/bin/rm -f nh-fix.sed

}
pkg_step prepare hackem_prepare

# "make all" would also format the Guidebook with nroff; install builds what the
# game needs.
/bin/gnumake install DESTDIR="$DESTDIR"

# The stock sysconf is a public server's: it points at gdb, a log directory and
# live-logging settings this system does not have, and the game refuses a sysconf with
# an error in it.  Those settings are commented out, and so is the "realtime" option, which
# is only known to a build with REALTIME_ON_BOTL.
/bin/sed \
    -e 's/^GDBPATH=/#GDBPATH=/' -e 's/^GREPPATH=/#GREPPATH=/' \
    -e 's/^PANICTRACE_GDB=/#PANICTRACE_GDB=/' -e 's/^PANICTRACE_LIBC=/#PANICTRACE_LIBC=/' \
    -e 's/^LIVELOG=/#LIVELOG=/' -e 's/^LLC_TURNS=/#LLC_TURNS=/' \
    -e 's/^DUMPLOGFILE=/#DUMPLOGFILE=/' -e 's/^DUMPHTMLFILE=/#DUMPHTMLFILE=/' \
    -e 's/^EXPLORERS=nobody/EXPLORERS=*/' \
    -e 's/^OPTIONS=realtime:/#OPTIONS=realtime:/' \
    sys/unix/sysconf > "$DESTDIR$PREFIX/lib/hackemdir/sysconf"
/bin/chmod 644 "$DESTDIR$PREFIX/lib/hackemdir/sysconf"

# Replace the stock launcher (it uses shell features the system sh lacks).
/bin/cat > "$DESTDIR$PREFIX/bin/hackem" <<'LEOF'
#!/bin/sh
HACKDIR=/usr/local/lib/hackemdir
export HACKDIR
cd $HACKDIR
exec $HACKDIR/hackem ${1+"$@"}
LEOF
/bin/chmod 755 "$DESTDIR$PREFIX/bin/hackem"

gamedir="$DESTDIR$PREFIX/lib/hackemdir"
test -x "$gamedir/hackem"
test -f "$gamedir/nhdat"
test -f "$gamedir/sysconf"
