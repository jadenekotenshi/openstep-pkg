#!/bin/sh
set -e
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin
export PATH
LR=${LOCAL_ROOT-/usr/local}
work=${TMPDIR-/tmp}/cowsay-pkg-test-$$
mkdir "$work"
trap 'rm -rf "$work"' 0
trap 'exit 1' 1 2 3 15
COWPATH=$LR/share/cows
export COWPATH
"$LR/bin/cowsay" moo > "$work/say"
grep '< moo >' "$work/say" > /dev/null
grep '(oo)' "$work/say" > /dev/null
"$LR/bin/cowthink" hmm > "$work/think"
grep '( hmm )' "$work/think" > /dev/null
"$LR/bin/cowsay" -f tux -e XX hello > "$work/tux"
grep 'hello' "$work/tux" > /dev/null
"$LR/bin/cowsay" -l > "$work/list"
grep default "$work/list" > /dev/null
grep tux "$work/list" > /dev/null
# Word wrapping at a given width and a multi-line balloon.
"$LR/bin/cowsay" -W 20 'one two three four five six seven eight nine ten' > "$work/wrap"
test "`grep -c '^[/|\\]' "$work/wrap"`" -ge 3
echo cowsay checks passed
