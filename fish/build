MEOF
/bin/cat > openstep/libgen.h <<'MEOF'
#ifndef OPENSTEP_LIBGEN_H
#define OPENSTEP_LIBGEN_H
extern char *ostep_dirname(char *);
extern char *ostep_basename(char *);
#define dirname ostep_dirname
#define basename ostep_basename
#endif
MEOF

wide_c=openstep_wchar.c
/bin/cat > openstep_wchar.c <<'WEOF'
/*
 * The wide-character functions fish needs and this libc lacks: wcscmp and the
 * other wcs* string functions, the isw* and tow* classification functions, and
 * mbrtowc/wcrtomb/mbstowcs/wcstombs.  Only the single-byte case is supported:
 * a multibyte character is one byte, taken as Latin-1 (the system has no
 * multibyte locales).  fish supplies its own wcslen, wcsdup, wcwidth, wcstol,
 * fwprintf and the rest, so those are left out.
 */
#include <stddef.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include "wchar.h"

int
wcscmp(const wchar_t *a, const wchar_t *b)
{
    while (*a != 0 && *a == *b) {
	a++;
	b++;
    }
    return (int) *a - (int) *b;
}

int
wcsncmp(const wchar_t *a, const wchar_t *b, size_t n)
{
    while (n > 0 && *a != 0 && *a == *b) {
	a++;
	b++;
	n--;
    }
    if (n == 0)
	return 0;
    return (int) *a - (int) *b;
}

wchar_t *
wcschr(const wchar_t *s, wchar_t c)
{
    for (;; s++) {
	if (*s == c)
	    return (wchar_t *) s;
	if (*s == 0)
	    return 0;
    }
}

wchar_t *
wcsrchr(const wchar_t *s, wchar_t c)
{
    const wchar_t *last = 0;

    for (;; s++) {
	if (*s == c)
	    last = s;
	if (*s == 0)
	    return (wchar_t *) last;
    }
}

wchar_t *
wcscpy(wchar_t *d, const wchar_t *s)
{
    wchar_t *r = d;

    while ((*d++ = *s++) != 0)
	;
    return r;
}

wchar_t *
wcsncpy(wchar_t *d, const wchar_t *s, size_t n)
{
    wchar_t *r = d;

    while (n > 0 && *s != 0) {
	*d++ = *s++;
	n--;
    }
    while (n-- > 0)
	*d++ = 0;
    return r;
}

wchar_t *
wcscat(wchar_t *d, const wchar_t *s)
{
    wchar_t *r = d;

    while (*d != 0)
	d++;
    while ((*d++ = *s++) != 0)
	;
    return r;
}

wchar_t *
wcsncat(wchar_t *d, const wchar_t *s, size_t n)
{
    wchar_t *r = d;

    while (*d != 0)
	d++;
    while (n-- > 0 && *s != 0)
	*d++ = *s++;
    *d = 0;
    return r;
}

wchar_t *
wcsstr(const wchar_t *h, const wchar_t *n)
{
    size_t i;

    if (*n == 0)
	return (wchar_t *) h;
    for (; *h != 0; h++) {
	for (i = 0; n[i] != 0 && h[i] == n[i]; i++)
	    ;
	if (n[i] == 0)
	    return (wchar_t *) h;
	if (h[i] == 0)
	    return 0;
    }
    return 0;
}

size_t
wcsspn(const wchar_t *s, const wchar_t *accept)
{
    const wchar_t *p = s;

    while (*p != 0 && wcschr(accept, *p) != 0)
	p++;
    return p - s;
}

size_t
wcscspn(const wchar_t *s, const wchar_t *reject)
{
    const wchar_t *p = s;

    while (*p != 0 && wcschr(reject, *p) == 0)
	p++;
    return p - s;
}

wchar_t *
wcspbrk(const wchar_t *s, const wchar_t *accept)
{
    for (; *s != 0; s++)
	if (wcschr(accept, *s) != 0)
	    return (wchar_t *) s;
    return 0;
}

int
wcscoll(const wchar_t *a, const wchar_t *b)
{
    return wcscmp(a, b);
}

/* Character classes: the "C" locale, with Latin-1 treated as plain bytes. */
#define CLASS(name, test) \
    int name(wint_t c) { return c >= 0 && c < 128 && test((int) c); }
CLASS(iswalnum, isalnum)
CLASS(iswalpha, isalpha)
CLASS(iswcntrl, iscntrl)
CLASS(iswdigit, isdigit)
CLASS(iswgraph, isgraph)
CLASS(iswlower, islower)
CLASS(iswprint, isprint)
CLASS(iswpunct, ispunct)
CLASS(iswspace, isspace)
CLASS(iswupper, isupper)
CLASS(iswxdigit, isxdigit)

wint_t
towlower(wint_t c)
{
    return (c >= 0 && c < 128) ? (wint_t) tolower((int) c) : c;
}

wint_t
towupper(wint_t c)
{
    return (c >= 0 && c < 128) ? (wint_t) toupper((int) c) : c;
}

size_t
mbrtowc(wchar_t *pwc, const char *s, size_t n, mbstate_t *ps)
{
    if (s == 0)
	return 0;
    if (n == 0)
	return (size_t) -2;
    if (pwc != 0)
	*pwc = (unsigned char) *s;
    return *s != 0 ? 1 : 0;
}

size_t
wcrtomb(char *s, wchar_t wc, mbstate_t *ps)
{
    if (s == 0)
	return 1;
    if (wc < 0 || wc > 255)
	return (size_t) -1;
    *s = (char) wc;
    return 1;
}

size_t
mbstowcs(wchar_t *dst, const char *src, size_t n)
{
    size_t i = 0;

    if (dst == 0)
	return strlen(src);
    while (i < n) {
	dst[i] = (unsigned char) src[i];
	if (src[i] == 0)
	    return i;
	i++;
    }
    return i;
}

size_t
wcstombs(char *dst, const wchar_t *src, size_t n)
{
    size_t i = 0;

    if (dst == 0) {
	while (src[i] != 0) {
	    if (src[i] < 0 || src[i] > 255)
		return (size_t) -1;
	    i++;
	}
	return i;
    }
    while (i < n) {
	if (src[i] < 0 || src[i] > 255)
	    return (size_t) -1;
	dst[i] = (char) src[i];
	if (src[i] == 0)
	    return i;
	i++;
    }
    return i;
}
WEOF
$CC $CFLAGS $OSTEP_DEFS -I"$shimdir" -c openstep_wchar.c -o openstep_wchar.o

