#!/bin/sh
set -e
DESTDIR=$1
VERSION=$2
PREFIX=/usr/local
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin:$PATH
CC="/usr/local/bin/gcc-4.2 $PKG_GCC42_ARCH_FLAGS"
# On i386 the archives are made by the cctools ar, which keeps long member names;
# the stock linker cannot read them.  A gcc42 built after the cctools package links
# with the cctools ld by itself; an older one needs the specs file selecting it.
if [ "$PKG_ARCH" = i386 ] && [ -f /usr/local/lib/cctools/gcc42.specs ]; then
    CC="$CC -specs=/usr/local/lib/cctools/gcc42.specs"
fi
CFLAGS='-O2'
CONFIG_SHELL=/usr/local/bin/ksh
GREP=/usr/local/bin/grep
EGREP='/usr/local/bin/grep -E'
AWK=/usr/local/bin/gawk
SED=/usr/local/bin/sed
AR=$PKG_AR
RANLIB=$PKG_RANLIB
export PATH CC CFLAGS CONFIG_SHELL GREP EGREP AWK SED AR RANLIB
if test -d "fish-$VERSION"; then cd "fish-$VERSION"; fi
. "$PKG_BUILD_HELPERS"

# fish 1.23.1 is the last release written in plain C with fallbacks for systems
# lacking wide-character and POSIX functions (it was made for NetBSD and Solaris);
# later versions need C++ and Rust.  Even so this libc has no <wchar.h>/<wctype.h>
# and wcscmp() and friends, no POSIX signals (sigaction and the sigset functions),
# tcgetattr()/tcsetattr(), waitpid(), setsid(), getpgid(), nanosleep(), realpath(),
# <libgen.h> or the POSIX <dirent.h>.  Private headers and a small library supply
# them; fish's own fallbacks cover wcslen, wcsdup, wcwidth, wcstol, fwprintf and
# the rest.  Only single-byte (Latin-1) text is supported.
/usr/local/bin/mkdir -p openstep
shimdir=`pwd`/openstep
# The BSD <sys/wait.h> defines WIFEXITED() and friends for "union wait", not the int
# status that waitpid() and POSIX programs use; redefine them for an int.
/usr/local/bin/mkdir -p "$shimdir"/sys
/bin/cat > "$shimdir"/sys/wait.h <<'SEOF'
#ifndef OPENSTEP_SYS_WAIT_H
#define OPENSTEP_SYS_WAIT_H
#include_next <sys/wait.h>
#undef WIFEXITED
#undef WEXITSTATUS
#undef WIFSIGNALED
#undef WTERMSIG
#undef WIFSTOPPED
#undef WSTOPSIG
#undef WCOREDUMP
#define WIFEXITED(s) ((((int) (s)) & 0xff) == 0)
#define WEXITSTATUS(s) ((((int) (s)) >> 8) & 0xff)
#define WIFSTOPPED(s) ((((int) (s)) & 0xff) == 0x7f)
#define WSTOPSIG(s) ((((int) (s)) >> 8) & 0xff)
#define WIFSIGNALED(s) ((((int) (s)) & 0xff) != 0 && (((int) (s)) & 0xff) != 0x7f)
#define WTERMSIG(s) (((int) (s)) & 0x7f)
#define WCOREDUMP(s) (((int) (s)) & 0x80)
#ifndef WNOHANG
# define WNOHANG 1
#endif
#ifndef WUNTRACED
# define WUNTRACED 2
#endif
#endif
SEOF


# Types the system's <sys/types.h> may lack (probed: a typedef cannot be tested for).
OSTEP_DEFS=
for ostep_type in mode_t ssize_t pid_t uid_t gid_t; do
    printf '#include <sys/types.h>\n%s probe_var;\nint main(void) { return 0; }\n' "$ostep_type" > type-probe.c
    if $CC -c type-probe.c -o type-probe.o > /dev/null 2>&1; then :; else
        ostep_upper=`echo $ostep_type | tr 'a-z' 'A-Z'`
        OSTEP_DEFS="$OSTEP_DEFS -DOSTEP_NEED_$ostep_upper"
    fi
done
printf '#include <sys/types.h>\n#include <time.h>\nstruct timespec probe_ts;\nint main(void) { return 0; }\n' > type-probe.c
$CC -c type-probe.c -o type-probe.o > /dev/null 2>&1 || OSTEP_DEFS="$OSTEP_DEFS -DOSTEP_NEED_TIMESPEC"
printf '#include <sys/types.h>\n#include <sys/time.h>\n#include <sys/resource.h>\nrlim_t probe_var;\nint main(void) { return 0; }\n' > type-probe.c
$CC -c type-probe.c -o type-probe.o > /dev/null 2>&1 || OSTEP_DEFS="$OSTEP_DEFS -DOSTEP_NEED_RLIM_T"
printf '#include <stddef.h>\n#include <stdlib.h>\nwint_t probe_var;\nint main(void) { return 0; }\n' > type-probe.c
$CC -c type-probe.c -o type-probe.o > /dev/null 2>&1 && OSTEP_DEFS="$OSTEP_DEFS -DOSTEP_HAVE_WINT_T"
/bin/rm -f type-probe.c type-probe.o
echo "fish: type defines:$OSTEP_DEFS"

sig_h=`pwd`/openstep-sig.h
/bin/cat > "$sig_h" <<'SIGEOF'
#include <sys/types.h>
#include <signal.h>
SIGEOF
probe_sig() {
    { echo "#include \"$sig_h\""; echo "$1"; } > probe_sig.c
    $CC $CFLAGS -c probe_sig.c -o probe_sig.o > /dev/null 2>&1
}
probe_sig 'sigset_t probe_set;' || echo 'typedef unsigned int sigset_t;' >> "$sig_h"
probe_sig 'int probe_how[3] = { SIG_BLOCK, SIG_UNBLOCK, SIG_SETMASK };' || /bin/cat >> "$sig_h" <<'SIGEOF'
#define SIG_BLOCK	1
#define SIG_UNBLOCK	2
#define SIG_SETMASK	3
SIGEOF
probe_sig 'struct sigaction probe_sa; int probe_f(void) { probe_sa.sa_handler = 0; probe_sa.sa_mask = 0; probe_sa.sa_flags = 0; return 0; }' || /bin/cat >> "$sig_h" <<'SIGEOF'
struct sigaction {
    void (*sa_handler)();
    sigset_t sa_mask;
    int sa_flags;
};
SIGEOF
/bin/cat >> "$sig_h" <<'SIGEOF'
#ifndef SA_RESTART
# define SA_RESTART	0x10000
#endif
#ifndef SA_NOCLDSTOP
# define SA_NOCLDSTOP	0x20000
#endif
#ifndef SA_SIGINFO
# define SA_SIGINFO	0x40000
#endif
extern int sigemptyset(sigset_t *);
extern int sigfillset(sigset_t *);
extern int sigaddset(sigset_t *, int);
extern int sigdelset(sigset_t *, int);
extern int sigismember(const sigset_t *, int);
extern int sigprocmask(int, const sigset_t *, sigset_t *);
extern int sigsuspend(const sigset_t *);
extern int sigaction(int, const struct sigaction *, struct sigaction *);
SIGEOF
# fish installs its handlers as SA_SIGINFO ones (sa_sigaction, taking a siginfo_t
# pointer).  Here the handler is a BSD sigvec() one, which is called with a signal
# number, a code and a context: the same three-argument shape, and fish ignores
# the second and third.  So sa_sigaction is just another name for sa_handler.
probe_sig 'siginfo_t probe_si;' || /bin/cat >> "$sig_h" <<'SIGEOF'
typedef struct {
    int si_signo;
    int si_errno;
    int si_code;
} siginfo_t;
SIGEOF
/bin/cat >> "$sig_h" <<'SIGEOF'
#define sa_sigaction sa_handler
SIGEOF
/bin/rm -f probe_sig.c probe_sig.o

/bin/cat > openstep_sig.c <<'SIGEOF'
#include "openstep-sig.h"
#include <errno.h>
#include <stdarg.h>
#include <stdio.h>
#include <string.h>

extern int sigvec();
extern int sigblock();
extern int sigsetmask();
extern int sigpause();

#define SIGBIT(sig)	(1 << ((sig) - 1))

int
sigemptyset(sigset_t *set)
{
    *set = 0;
    return 0;
}

int
sigfillset(sigset_t *set)
{
    *set = ~0;
    return 0;
}

int
sigaddset(sigset_t *set, int sig)
{
    if (sig <= 0 || sig > 31) {
	errno = EINVAL;
	return -1;
    }
    *set |= SIGBIT(sig);
    return 0;
}

int
sigdelset(sigset_t *set, int sig)
{
    if (sig <= 0 || sig > 31) {
	errno = EINVAL;
	return -1;
    }
    *set &= ~SIGBIT(sig);
    return 0;
}

int
sigismember(const sigset_t *set, int sig)
{
    if (sig <= 0 || sig > 31) {
	errno = EINVAL;
	return -1;
    }
    return (*set & SIGBIT(sig)) != 0;
}

int
sigprocmask(int how, const sigset_t *set, sigset_t *oset)
{
    int old;

    if (set == 0)
	old = sigblock(0);
    else switch (how) {
    case SIG_BLOCK:
	old = sigblock((int)*set);
	break;
    case SIG_UNBLOCK:
	old = sigsetmask(sigblock(0) & ~(int)*set);
	break;
    case SIG_SETMASK:
	old = sigsetmask((int)*set);
	break;
    default:
	errno = EINVAL;
	return -1;
    }
    if (oset)
	*oset = (sigset_t)old;
    return 0;
}

int
sigsuspend(const sigset_t *mask)
{
    return sigpause((int)*mask);
}

/* POSIX handlers are not restarted unless SA_RESTART; BSD sigvec() restarts
   unless SV_INTERRUPT, so the sense of the flag is reversed. */
int
sigaction(int sig, const struct sigaction *act, struct sigaction *oact)
{
    struct sigvec nsv, osv;
    int r;

    if (act) {
	nsv.sv_handler = (void (*)())act->sa_handler;
	nsv.sv_mask = (int)act->sa_mask;
	nsv.sv_flags = (act->sa_flags & SA_RESTART) ? 0 : SV_INTERRUPT;
    }
    r = sigvec(sig, act ? &nsv : (struct sigvec *)0, &osv);
    if (r == 0 && oact) {
	oact->sa_handler = (void (*)())osv.sv_handler;
	oact->sa_mask = (sigset_t)osv.sv_mask;
	oact->sa_flags = (osv.sv_flags & SV_INTERRUPT) ? 0 : SA_RESTART;
    }
    return r;
}
SIGEOF
$CC $CFLAGS -c openstep_sig.c -o openstep_sig.o

# The remaining POSIX functions under renamed symbols, plus the wide-character
# functions under their own names (nothing else on the system defines them).
/bin/cat > openstep_posix.c <<'MEOF'
#include <errno.h>
#include <stdlib.h>
#include <string.h>
#include <sys/types.h>
#include <sys/param.h>
#include <sys/stat.h>
#include <sys/time.h>
#include <sys/ioctl.h>
#include <termios.h>
#include <time.h>

#ifdef OSTEP_NEED_TIMESPEC
struct timespec {
    time_t tv_sec;
    long tv_nsec;
};
#endif
extern int getpid();
extern int chdir();
extern int readlink();
extern int wait4();
extern int setpgrp();
extern int getpgrp();
extern char *getwd();
extern int select();

int
ostep_waitpid(int pid, int *status, int options)
{
    return wait4(pid, (void *) status, options, (void *) 0);
}

int
ostep_setpgid(int pid, int pgrp)
{
    return setpgrp(pid, pgrp);
}

int
ostep_getpgrp(void)
{
    return getpgrp(0);
}

int
ostep_getpgid(int pid)
{
    if (pid == 0 || pid == getpid())
	return getpgrp(0);
    return getpgrp(pid);
}

int
ostep_setsid(void)
{
    int pid = getpid();

    if (setpgrp(pid, pid) < 0)
	return -1;
    return pid;
}

int
ostep_tcgetpgrp(int fd)
{
    int pgrp;

    if (ioctl(fd, TIOCGPGRP, (char *) &pgrp) < 0)
	return -1;
    return pgrp;
}

int
ostep_tcsetpgrp(int fd, int pgrp)
{
    return ioctl(fd, TIOCSPGRP, (char *) &pgrp);
}

int
ostep_tcgetattr(int fd, struct termios *t)
{
    return ioctl(fd, TIOCGETA, (char *) t);
}

int
ostep_tcsetattr(int fd, int how, const struct termios *t)
{
    unsigned long req;

    switch (how) {
    case TCSADRAIN:
	req = TIOCSETAW;
	break;
    case TCSAFLUSH:
	req = TIOCSETAF;
	break;
    default:
	req = TIOCSETA;
	break;
    }
    return ioctl(fd, req, (char *) t);
}

char *
ostep_getcwd(char *buf, int size)
{
    char tmp[MAXPATHLEN + 1];

    if (buf == 0 || size <= 0) {
	errno = EINVAL;
	return 0;
    }
    if (getwd(tmp) == 0)
	return 0;
    if ((int) strlen(tmp) >= size) {
	errno = ERANGE;
	return 0;
    }
    strcpy(buf, tmp);
    return buf;
}

char *
ostep_strdup(const char *s)
{
    size_t n = strlen(s) + 1;
    char *p = (char *) malloc(n);

    if (p != 0)
	memcpy(p, s, n);
    return p;
}

int
ostep_nanosleep(const struct timespec *req, struct timespec *rem)
{
    struct timeval tv;

    tv.tv_sec = req->tv_sec;
    tv.tv_usec = req->tv_nsec / 1000;
    select(0, (void *) 0, (void *) 0, (void *) 0, &tv);
    if (rem != 0) {
	rem->tv_sec = 0;
	rem->tv_nsec = 0;
    }
    return 0;
}

/* dirname() and basename() as in <libgen.h>; both may modify their argument. */
char *
ostep_dirname(char *path)
{
    static char dot[] = ".";
    char *end;

    if (path == 0 || *path == 0)
	return dot;
    end = path + strlen(path);
    while (end > path + 1 && end[-1] == '/')
	*--end = 0;
    while (end > path && end[-1] != '/')
	end--;
    if (end == path)
	return dot;
    while (end > path + 1 && end[-1] == '/')
	end--;
    *end = 0;
    return path;
}

char *
ostep_basename(char *path)
{
    static char dot[] = ".";
    char *end, *p;

    if (path == 0 || *path == 0)
	return dot;
    end = path + strlen(path);
    while (end > path + 1 && end[-1] == '/')
	*--end = 0;
    if (end == path + 1 && *path == '/')
	return path;
    p = strrchr(path, '/');
    return p == 0 ? path : p + 1;
}

/* realpath(): the directory part is resolved with chdir()/getwd(), a symbolic link
   at the end is followed.  A null result buffer is allocated. */
char *
ostep_realpath(const char *path, char *resolved)
{
    char start[MAXPATHLEN + 1], work[MAXPATHLEN + 1], dir[MAXPATHLEN + 1];
    char link[MAXPATHLEN + 1], out[MAXPATHLEN + 1];
    char *base, *slash;
    int links = 0, n;
    struct stat st;

    if (path == 0 || *path == 0) {
	errno = ENOENT;
	return 0;
    }
    if (getwd(start) == 0)
	return 0;
    if (strlen(path) > MAXPATHLEN) {
	errno = ENAMETOOLONG;
	return 0;
    }
    strcpy(work, path);
    for (;;) {
	if (stat(work, &st) < 0)
	    goto fail;
	slash = strrchr(work, '/');
	if (slash == 0) {
	    strcpy(dir, ".");
	    base = work;
	} else if (slash == work) {
	    strcpy(dir, "/");
	    base = work + 1;
	} else {
	    *slash = 0;
	    strcpy(dir, work);
	    base = slash + 1;
	}
	if (chdir(dir) < 0)
	    goto fail;
	if (getwd(out) == 0)
	    goto fail;
	if (*base != 0 && strcmp(base, ".") != 0) {
	    if (strcmp(base, "..") == 0) {
		if (chdir("..") < 0 || getwd(out) == 0)
		    goto fail;
	    } else {
		struct stat lst;

		if (lstat(base, &lst) == 0 && (lst.st_mode & S_IFMT) == S_IFLNK) {
		    if (++links > 20) {
			errno = ELOOP;
			goto fail;
		    }
		    n = readlink(base, link, MAXPATHLEN);
		    if (n < 0)
			goto fail;
		    link[n] = 0;
		    if (link[0] == '/') {
			strcpy(work, link);
		    } else {
			if (strlen(out) + n + 2 > MAXPATHLEN) {
			    errno = ENAMETOOLONG;
			    goto fail;
			}
			strcpy(work, out);
			strcat(work, "/");
			strcat(work, link);
		    }
		    chdir(start);
		    continue;
		}
		if (strlen(out) + strlen(base) + 2 > MAXPATHLEN) {
		    errno = ENAMETOOLONG;
		    goto fail;
		}
		if (strcmp(out, "/") != 0)
		    strcat(out, "/");
		strcat(out, base);
	    }
	}
	break;
    }
    chdir(start);
    if (resolved == 0) {
	resolved = (char *) malloc(strlen(out) + 1);
	if (resolved == 0)
	    return 0;
    }
    strcpy(resolved, out);
    return resolved;
fail:
    chdir(start);
    return 0;
}
MEOF
$CC $CFLAGS $OSTEP_DEFS -c openstep_posix.c -o openstep_posix.o

# Wide-character support: the headers go in the private directory, the functions in
# openstep_wchar.c.
printf '#include <wchar.h>\n#include <wctype.h>\nint main(void) { return wcscmp(L"a", L"b") + iswspace(32); }\n' > wide-probe.c
if $CC -c wide-probe.c -o wide-probe.o > /dev/null 2>&1 && $CC wide-probe.o -o wide-probe > /dev/null 2>&1; then
    echo "fish: the system has <wchar.h> and the wide string functions; not using the shim headers"
else
/bin/cat > openstep/wchar.h <<'MEOF'
#ifndef OPENSTEP_WCHAR_H
#define OPENSTEP_WCHAR_H
#include <stddef.h>
#include <stdio.h>
#include <stdlib.h>
#include <stdarg.h>
#include <string.h>
#ifndef OSTEP_HAVE_WINT_T
typedef int wint_t;
#endif
typedef int mbstate_t;
#ifndef WEOF
#define WEOF ((wint_t) -1)
#endif
extern int wcscmp(const wchar_t *, const wchar_t *);
extern int wcsncmp(const wchar_t *, const wchar_t *, size_t);
extern wchar_t *wcschr(const wchar_t *, wchar_t);
extern wchar_t *wcsrchr(const wchar_t *, wchar_t);
extern wchar_t *wcscpy(wchar_t *, const wchar_t *);
extern wchar_t *wcsncpy(wchar_t *, const wchar_t *, size_t);
extern wchar_t *wcscat(wchar_t *, const wchar_t *);
extern wchar_t *wcsncat(wchar_t *, const wchar_t *, size_t);
extern wchar_t *wcsstr(const wchar_t *, const wchar_t *);
extern size_t wcsspn(const wchar_t *, const wchar_t *);
extern size_t wcscspn(const wchar_t *, const wchar_t *);
extern wchar_t *wcspbrk(const wchar_t *, const wchar_t *);
extern int wcscoll(const wchar_t *, const wchar_t *);
extern size_t mbrtowc(wchar_t *, const char *, size_t, mbstate_t *);
extern size_t wcrtomb(char *, wchar_t, mbstate_t *);
extern size_t mbstowcs(wchar_t *, const char *, size_t);
extern size_t wcstombs(char *, const wchar_t *, size_t);
#endif
MEOF
/bin/cat > openstep/wctype.h <<'MEOF'
#ifndef OPENSTEP_WCTYPE_H
#define OPENSTEP_WCTYPE_H
#include <wchar.h>
extern int iswalnum(wint_t);
extern int iswalpha(wint_t);
extern int iswcntrl(wint_t);
extern int iswdigit(wint_t);
extern int iswgraph(wint_t);
extern int iswlower(wint_t);
extern int iswprint(wint_t);
extern int iswpunct(wint_t);
extern int iswspace(wint_t);
extern int iswupper(wint_t);
extern int iswxdigit(wint_t);
extern wint_t towlower(wint_t);
extern wint_t towupper(wint_t);
#endif
MEOF
fi
/bin/rm -f wide-probe.c wide-probe.o wide-probe
# mmap() here has no munmap() to go with it.  fish only maps its history file
# read-only, so a <sys/mman.h> that reads the file into malloc'd memory will do.
/usr/local/bin/mkdir -p openstep/sys
# reader.c includes <sys/poll.h> without using poll().
echo '/* empty: not needed here */' > openstep/sys/poll.h
/bin/cat > openstep/sys/mman.h <<'MEOF'
#ifndef OPENSTEP_SYS_MMAN_H
#define OPENSTEP_SYS_MMAN_H
#include <sys/types.h>
#include <stdlib.h>
#define PROT_READ 1
#define MAP_PRIVATE 2
#define MAP_FAILED ((void *) -1)
extern long lseek();
extern int read();
static void *
ostep_mmap(void *addr, unsigned long len, int prot, int flags, int fd, long off)
{
    char *p = (char *) malloc(len > 0 ? len : 1);
    unsigned long got = 0;
    int n;

    if (p == 0)
	return MAP_FAILED;
    if (lseek(fd, off, 0) < 0) {
	free(p);
	return MAP_FAILED;
    }
    while (got < len) {
	n = read(fd, p + got, len - got);
	if (n <= 0)
	    break;
	got += n;
    }
    if (got < len) {
	free(p);
	return MAP_FAILED;
    }
    return p;
}
static int
ostep_munmap(void *addr, unsigned long len)
{
    free(addr);
    return 0;
}
#define mmap ostep_mmap
#define munmap ostep_munmap
#endif
MEOF
/bin/cat > openstep/stdint.h <<'MEOF'
#ifndef OPENSTEP_STDINT_H
#define OPENSTEP_STDINT_H
#include <sys/types.h>
typedef unsigned char uint8_t;
typedef unsigned short uint16_t;
typedef unsigned int uint32_t;
typedef unsigned long long uint64_t;
typedef long long intmax_t;
typedef unsigned long long uintmax_t;
typedef long intptr_t;
typedef unsigned long uintptr_t;
#endif
MEOF
/bin/cat > openstep/dirent.h <<'MEOF'
#ifndef OPENSTEP_DIRENT_H
