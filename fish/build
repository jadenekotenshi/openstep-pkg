# openstep_sig.c and the posix pieces share one archive; the signal functions keep
# their standard names (the system has none), the rest are renamed above.
/bin/rm -f libostepfish.a
$AR cr libostepfish.a openstep_sig.o openstep_posix.o openstep_wchar.o
$RANLIB libostepfish.a

# ncurses comes from the ncurses package.
CPPFLAGS="-I$shimdir -I/usr/local/include/ncurses -I/usr/local/include $OSTEP_DEFS -include $sig_h -include $shimdir/fish-compat.h"
LDFLAGS=-L/usr/local/lib
LIBS="-L`pwd` -lostepfish"
# configure insists on finding nanosleep() in libc or librt; the shim's version is
# renamed by the compat header, so tell it there is nothing to link.
ac_cv_search_nanosleep='none required'
# libiconv exports libiconv_open() (its iconv.h maps iconv_open onto it), so the
# plain-name search fails every time it is repeated; -liconv is the answer.
ac_cv_search_iconv_open=-liconv
export ac_cv_search_nanosleep ac_cv_search_iconv_open
export CPPFLAGS LDFLAGS LIBS

run_configure \
  --build=$PKG_TARGET \
  --prefix=/usr/local \
  --without-xsel \
  --without-gettext

# The stock sh does not stop a failed sub-make in a loop, so check for the results.
gnumake
test -f fish
test -f fishd
test -f fish_pager
gnumake install DESTDIR="$DESTDIR"
test -x "$DESTDIR$PREFIX/bin/fish"
test -x "$DESTDIR$PREFIX/bin/fishd"
