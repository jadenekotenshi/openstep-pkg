--- /dev/null
+++ b/tests/t-openstep.c
@@ -0,0 +1,26 @@
+/* Native compatibility regression. LGPL version 2.1 or later. */
+#include "config.h"
+#include <assert.h>
+#include <unistd.h>
+#include <limits.h>
+int main (void)
+{
+  char text[64], short_text[3];
+  char *copy = strdup ("OPENSTEP");
+  int status, child, i;
+  unsigned char fill[8];
+  memset (fill, 0xa6, sizeof fill);
+  for (i = 0; i < sizeof fill; ++i) assert (fill[i] == 0xa6);
+  assert (copy && !strcmp (copy, "OPENSTEP"));
+  free (copy);
+  snprintf (text, sizeof text, "%d:%u", INT_MIN, UINT_MAX);
+  assert (!strcmp (text, "-2147483648:4294967295"));
+  snprintf (short_text, sizeof short_text, "%s", "abcdef");
+  assert (!strcmp (short_text, "ab"));
+  child = fork ();
+  assert (child >= 0);
+  if (!child) _exit (7);
+  assert (waitpid (child, &status, 0) == child);
+  assert (WIFEXITED (status) && WEXITSTATUS (status) == 7);
+  return 0;
+}
