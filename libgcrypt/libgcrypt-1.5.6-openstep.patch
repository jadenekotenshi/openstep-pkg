+/* OPENSTEP libc compatibility. LGPL version 2.1 or later. */
+#ifndef GCRYPT_OPENSTEP_H
+#define GCRYPT_OPENSTEP_H
+#include <libc.h>
+#include <stdio.h>
+#include <time.h>
+#ifndef CLOCKS_PER_SEC
+#define CLOCKS_PER_SEC CLK_TCK
+#endif
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <curl/mprintf.h>
+#define snprintf curl_msnprintf
+static inline char *gcrypt_openstep_strdup (const char *s)
+{
+  size_t n = strlen (s) + 1;
+  char *copy = malloc (n);
+  if (copy) memcpy (copy, s, n);
+  return copy;
+}
+#define strdup gcrypt_openstep_strdup
+static inline int gcrypt_openstep_waitpid (int pid, int *status, int options)
+{
+  return wait4 (pid, (union wait *)status, options, NULL);
+}
+#define waitpid gcrypt_openstep_waitpid
+/* The wrapper supplies the interface absent from native libc. */
+#define HAVE_WAITPID 1
+#endif
