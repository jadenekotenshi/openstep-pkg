+/* Use the kernel's BSD signal handling, including its atomic mask changes.  */
+typedef void (*next_handler_t) (int);
+static next_handler_t next_handlers[NSIG];
+
+static void
+next_reset_handler (int sig)
+{
+  struct sigvec action;
+  next_handler_t handler = next_handlers[sig];
+  int saved_errno = errno;
+
+  action.sv_handler = SIG_DFL;
+  action.sv_mask = 0;
+  action.sv_flags = 0;
+  sigvec (sig, &action, NULL);
+  errno = saved_errno;
+  handler (sig);
+}
+
+int
+sigaction (int sig, const struct sigaction *act, struct sigaction *oldact)
+{
+  struct sigvec action, previous;
+  next_handler_t previous_handler;
+  int mask, result, saved_errno;
+
+  if (sig <= 0 || sig >= NSIG
+      || (act && (act->sa_flags & ~(SA_RESETHAND | SA_RESTART))))
+    {
+      errno = EINVAL;
+      return -1;
+    }
+  mask = sigblock (sigmask (sig));
+  previous_handler = next_handlers[sig];
+  if (act)
+    {
+      action.sv_handler = act->sa_handler;
+      action.sv_mask = act->sa_mask;
+      action.sv_flags = (act->sa_flags & SA_RESTART) ? 0 : SV_INTERRUPT;
+      if ((act->sa_flags & SA_RESETHAND)
+          && act->sa_handler != SIG_DFL && act->sa_handler != SIG_IGN)
+        {
+          next_handlers[sig] = act->sa_handler;
+          action.sv_handler = next_reset_handler;
+        }
+    }
+  result = sigvec (sig, act ? &action : NULL, &previous);
+  saved_errno = errno;
+  if (result == 0 && oldact)
+    {
+      oldact->sa_handler = previous.sv_handler;
+      oldact->sa_mask = previous.sv_mask;
+      oldact->sa_flags = (previous.sv_flags & SV_INTERRUPT) ? 0 : SA_RESTART;
+      if (previous.sv_handler == next_reset_handler)
+        {
+          oldact->sa_handler = previous_handler;
+          oldact->sa_flags |= SA_RESETHAND;
+        }
+    }
+  if (result != 0)
+    next_handlers[sig] = previous_handler;
+  sigsetmask (mask);
+  errno = saved_errno;
+  return result;
+}
