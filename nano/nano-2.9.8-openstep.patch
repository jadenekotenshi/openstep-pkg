+/* OPENSTEP has no POSIX libgen.h.  Only nano's private callers use this. */
+#ifndef NANO_LIBGEN_H
+#define NANO_LIBGEN_H
+#ifndef NeXT
+# include_next <libgen.h>
+#else
+#include <string.h>
+
+static char *
+basename (char *path)
+{
+  char *end, *slash;
+  if (!path || !*path)
+    return ".";
+  end = path + strlen (path);
+  while (end > path + 1 && end[-1] == '/')
+    *--end = '\0';
+  slash = strrchr (path, '/');
+  return slash && slash[1] ? slash + 1 : path;
+}
+
+static char *
+dirname (char *path)
+{
+  char *end;
+  if (!path || !*path)
+    return ".";
+  end = path + strlen (path);
+  while (end > path + 1 && end[-1] == '/')
+    --end;
+  while (end > path && end[-1] != '/')
+    --end;
+  if (end == path)
+    return ".";
+  while (end > path + 1 && end[-1] == '/')
+    --end;
+  *end = '\0';
+  return path;
+}
+#endif
+#endif
