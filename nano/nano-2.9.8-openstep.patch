+/* OPENSTEP libc fallbacks used by nano and its bundled gnulib. */
+#ifdef NeXT
+#include "openstep.h"
+#include <sys/param.h>
+#include <sys/resource.h>
+#include <sys/wait.h>
+#include <dirent.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+extern char *getwd (char *);
+extern void seekdir (DIR *, long);
+extern int wait4 (int, union wait *, int, struct rusage *);
+
+char *
+strdup (const char *text)
+{
+  size_t length = strlen (text) + 1;
+  char *copy = malloc (length);
+  if (copy)
+    memcpy (copy, text, length);
+  return copy;
+}
+
+char *
+getcwd (char *buffer, size_t size)
+{
+  char path[MAXPATHLEN + 1];
+  size_t needed;
+  if (!getwd (path))
+    return NULL;
+  needed = strlen (path) + 1;
+  if (!buffer && size == 0)
+    size = needed;
+  if (size < needed)
+    {
+      errno = size ? ERANGE : EINVAL;
+      return NULL;
+    }
+  if (!buffer && !(buffer = malloc (size)))
+    return NULL;
+  memcpy (buffer, path, needed);
+  return buffer;
+}
+
+void
+rewinddir (DIR *directory)
+{
+  seekdir (directory, 0L);
+}
+
+pid_t
+waitpid (pid_t pid, int *status, int options)
+{
+  union wait result;
+  int child = wait4 (pid, &result, options, NULL);
+  if (child > 0 && status)
+    *status = result.w_status;
+  return child;
+}
+
+long
+fpathconf (int fd, int name)
+{
+  if (name == _PC_PIPE_BUF)
+    {
+      struct stat info;
+      if (fstat (fd, &info) < 0)
+        return -1;
+      return PIPE_BUF;
+    }
+  errno = EINVAL;
+  return -1;
+}
