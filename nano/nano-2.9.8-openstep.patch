@@ -23,6 +23,88 @@
 #include <errno.h>
 #include <stdint.h>
 #include <stdlib.h>
+
+#ifdef NeXT
+
+/* OPENSTEP uses bit (signal - 1), unlike the Windows emulation below.  */
+static int
+next_valid_signal (int sig)
+{
+  if (sig > 0 && sig < NSIG)
+    return 1;
+  errno = EINVAL;
+  return 0;
+}
+
+int
+sigismember (const sigset_t *set, int sig)
+{
+  return next_valid_signal (sig) ? !!(*set & (1U << (sig - 1))) : -1;
+}
+
+int
+sigemptyset (sigset_t *set)
+{
+  *set = 0;
+  return 0;
+}
+
+int
+sigfillset (sigset_t *set)
+{
+  *set = (1U << (NSIG - 1)) - 1;
+  return 0;
+}
+
+int
+sigaddset (sigset_t *set, int sig)
+{
+  if (!next_valid_signal (sig))
+    return -1;
+  *set |= 1U << (sig - 1);
+  return 0;
+}
+
+int
+sigdelset (sigset_t *set, int sig)
+{
+  if (!next_valid_signal (sig))
+    return -1;
+  *set &= ~(1U << (sig - 1));
+  return 0;
+}
+
+int
+sigprocmask (int how, const sigset_t *set, sigset_t *oldset)
+{
+  int previous;
+  if (!set)
+    previous = sigblock (0);
+  else if (how == SIG_BLOCK)
+    previous = sigblock (*set);
+  else if (how == SIG_SETMASK)
+    previous = sigsetmask (*set);
+  else if (how == SIG_UNBLOCK)
+    previous = sigsetmask (sigblock (0) & ~*set);
+  else
+    {
+      errno = EINVAL;
+      return -1;
+    }
+  if (oldset)
+    *oldset = previous;
+  return 0;
+}
+
+#undef signal
+typedef void (*handler_t) (int);
+handler_t
+rpl_signal (int sig, handler_t handler)
+{
+  return signal (sig, handler);
+}
