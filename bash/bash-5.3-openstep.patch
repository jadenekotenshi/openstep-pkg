diff -ruN -x '*.o' a/x/lib/sh/openstep.c b/lib/sh/openstep.c
--- a/lib/sh/openstep.c	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/sh/openstep.c	2026-10-05 22:42:59.960120859 +0000
@@ -0,0 +1,51 @@
+/* openstep.c -- POSIX functions that OPENSTEP's libc does not provide as
+   separate symbols, built on the BSD calls underneath.  Each one is compiled
+   only when configure did not find the real function. */
+
+#include <config.h>
+
+#include <sys/types.h>
+#include <sys/ioctl.h>
+#include <termios.h>
+
+#if !defined (HAVE_WAITPID)
+extern int wait4 ();
+
+/* waitpid (pid, status, options): wait4 without the rusage. */
+int
+waitpid (pid, statusp, options)
+     int pid;
+     int *statusp;
+     int options;
+{
+  return (wait4 (pid, (void *)statusp, options, (void *)0));
+}
+#endif /* !HAVE_WAITPID */
+
+#if !defined (HAVE_TCGETATTR) && defined (TIOCGETA) && defined (TIOCSETA)
+int
+tcgetattr (fd, t)
+     int fd;
+     struct termios *t;
+{
+  return (ioctl (fd, TIOCGETA, (char *)t));
+}
+
+int
+tcsetattr (fd, actions, t)
+     int fd;
+     int actions;
+     struct termios *t;
+{
+  switch (actions)
+    {
+    case 0:	/* TCSANOW */
+      return (ioctl (fd, TIOCSETA, (char *)t));
+    case 1:	/* TCSADRAIN */
+      return (ioctl (fd, TIOCSETAW, (char *)t));
+    case 2:	/* TCSAFLUSH */
+      return (ioctl (fd, TIOCSETAF, (char *)t));
+    }
+  return (-1);
+}
+#endif /* !HAVE_TCGETATTR */
