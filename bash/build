#!/bin/sh
set -e
DESTDIR=$1
VERSION=$2
PATH=/usr/local/bin:/usr/ucb:/bin:/usr/bin
CC=/usr/local/bin/gcc-4.2
CFLAGS="$PKG_GCC42_ARCH_FLAGS "'-O2'
SED=/bin/sed
GREP=/usr/local/bin/grep
EGREP='/usr/local/bin/grep -E'
AWK=/usr/local/bin/gawk
export DESTDIR VERSION PATH CC CFLAGS SED GREP EGREP AWK
if test -d "bash-$VERSION"; then cd "bash-$VERSION"; fi
. "$PKG_BUILD_HELPERS"

# bash's own malloc is off for this host by configure.ac; no NLS; the bundled
# readline is used.  Installs as /usr/local/bin/bash and never touches /bin.
run_configure --disable-nls --without-bash-malloc --prefix=/usr/local \
    --build=$PKG_TARGET --host=$PKG_TARGET
/bin/gnumake
/bin/gnumake install DESTDIR="$DESTDIR"
# Drop the dir file so reinstalls do not clobber other info packages.
/bin/rm -f "$DESTDIR/usr/local/share/info/dir"
